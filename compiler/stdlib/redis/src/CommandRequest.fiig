// ADR 0110 §3: the command, after AUTH and SELECT when the connection is
// new. All of them go in one write, and their replies come back in order.
conversion commandRequest(target: RedisTarget, args: List<string>, fresh: bool) -> RedisRequest {
    commands: List<List<string>> = []
    if fresh {
        match target.password {
            None -> None
            password -> {
                match target.user {
                    None -> {
                        commands = append(commands, ["AUTH", password])
                    }
                    user -> {
                        commands = append(commands, ["AUTH", user, password])
                    }
                }
            }
        }
        if target.database != 0 {
            commands = append(commands, ["SELECT", "${target.database}"])
        }
    }
    commands = append(commands, args)
    data: bytes = <<>>
    for each in commands {
        words: List<bytes> = []
        for word in each {
            words = append(words, word.utf8())
        }
        data = <<data: bytes, encodeCommand(words): bytes>>
    }
    return RedisRequest(data: data, replies: commands.length())
}
