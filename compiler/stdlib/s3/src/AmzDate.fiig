// SigV4's timestamp from Unix milliseconds, always UTC: `20261120T135958Z`.
// Its first eight characters are the day the credential scope names. fiig
// has no time type (known limitations), so the calendar is worked out from
// the day count with Howard Hinnant's civil_from_days, exact for every date
// from 1970. A time before then is the epoch.
conversion amzDate(millis: int) -> string {
    safe: int = millis
    if safe < 0 {
        safe = 0
    }
    seconds = safe / 1000
    days = seconds / 86400
    secondOfDay = seconds - days * 86400
    shifted = days + 719468
    era = shifted / 146097
    dayOfEra = shifted - era * 146097
    yearOfEra = (dayOfEra - dayOfEra / 1460 + dayOfEra / 36524 - dayOfEra / 146096) / 365
    dayOfYear = dayOfEra - (365 * yearOfEra + yearOfEra / 4 - yearOfEra / 100)
    monthIndex = (5 * dayOfYear + 2) / 153
    day = dayOfYear - (153 * monthIndex + 2) / 5 + 1
    month: int = monthIndex + 3
    if monthIndex >= 10 {
        month = monthIndex - 9
    }
    year: int = yearOfEra + era * 400
    if month <= 2 {
        year = year + 1
    }
    hour = secondOfDay / 3600
    minute = (secondOfDay - hour * 3600) / 60
    second = secondOfDay - hour * 3600 - minute * 60
    return "${year}${two(month)}${two(day)}T${two(hour)}${two(minute)}${two(second)}Z"
}

private {
    two(n: int) -> string {
        if n < 10 {
            return "0${n}"
        }
        return "${n}"
    }
}
