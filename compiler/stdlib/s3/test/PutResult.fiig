use fiig.http

test a200IsStored {
    expect putResult(http.Reply(status: 200, headers: [], body: <<>>)) is Ok(_);
}

test anythingElseIsAnErrorForAPut {
    expect putResult(http.Reply(status: 403, headers: [], body: "<Error><Code>AccessDenied</Code><Message>no</Message></Error>".utf8())) is Err(S3Error.Refused(status, code, message));
    expect status == 403;
    expect code == "AccessDenied";
    expect putResult(http.Reply(status: 404, headers: [], body: <<>>)) is Err(S3Error.NotFound);
}

test aRedirectIsAnErrorNotFollowed {
    expect putResult(http.Reply(status: 301, headers: [], body: <<>>)) is Err(S3Error.Refused(status, code, message));
    expect status == 301;
}
