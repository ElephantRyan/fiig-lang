use fiig.http

// What a HEAD's or a GET's reply says about its object, given its size:
// the content type, the ETag and the metadata, from the headers.
conversion objectInfoOf(reply: http.Reply, size: int) -> ObjectInfo {
    return ObjectInfo(
        size: size,
        contentType: headerValue(reply, "Content-Type"),
        etag: headerValue(reply, "ETag"),
        metadata: metadataOf(reply.headers),
    )
}

private {
    // The first header of that name, in any case, or "".
    headerValue(reply: http.Reply, name: string) -> string {
        for header in reply.headers {
            if header.name.equalsIgnoringCase(name) {
                return header.value
            }
        }
        return ""
    }
}
