use fiig.sql as db

// ADR 0085 §8: a column's text, read by its type's OID. Integers (20, 21,
// 23) are Int; float4 and float8 (700, 701) are Float, but NaN and the
// infinities stay Text, which a float field refuses by name; bool (16) is
// Bool; bytea (17) is Bytes from its \x hex form; anything else, numeric
// (1700) included, is Text.
conversion columnValue(text: bytes, oid: int) -> db.SqlValue {
    return match (text.utf8()) {
        None -> {
            return db.SqlValue.Bytes(value: text);
        }

        value -> {
            if (oid == 20 || oid == 21 || oid == 23) {
                match (value.toIntOrNone()) {
                    None -> None
                    n -> {
                        return db.SqlValue.Int(value: n);
                    }
                }
            }

            if (oid == 700 || oid == 701) {
                if (value == "NaN" || value == "Infinity" || value == "-Infinity") {
                    return db.SqlValue.Text(value: value);
                }

                match (value.toFloatOrNone()) {
                    None -> None
                    x -> {
                        return db.SqlValue.Float(value: x);
                    }
                }
            }

            if (oid == 16) {
                if (value == "t") {
                    return db.SqlValue.Bool(value: true);
                }

                if (value == "f") {
                    return db.SqlValue.Bool(value: false);
                }
            }

            if (oid == 17 && value.startsWith("\\x")) {
                match (value.removePrefix("\\x").fromHex()) {
                    None -> None
                    data -> {
                        return db.SqlValue.Bytes(value: data);
                    }
                }
            }

            return db.SqlValue.Text(value: value);
        }
    }
}
