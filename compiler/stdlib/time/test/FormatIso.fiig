test formatIsoat1970_1_1_0_0_0 {
    expect formatIso(0) is Ok(text)
    expect text == "1970-01-01T00:00:00.000Z"
}

test formatIsoat1969_12_31_23_59_59_999 {
    expect formatIso(-1) is Ok(text)
    expect text == "1969-12-31T23:59:59.999Z"
}

test formatIsoat1969_12_31_0_0_0 {
    expect formatIso(-86400000) is Ok(text)
    expect text == "1969-12-31T00:00:00.000Z"
}

test formatIsoat1900_1_1_0_0_0 {
    expect formatIso(-2208988800000) is Ok(text)
    expect text == "1900-01-01T00:00:00.000Z"
}

