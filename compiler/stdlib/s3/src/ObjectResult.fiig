use fiig.http

// A GET's object with what is known about it, when the server says 200: the
// body, and its size, content type, ETag and metadata from the headers. A
// 404 is NotFound and anything else is its error.
conversion objectResult(reply: http.Reply) -> Result<S3Object, S3Error> {
    if (reply.status == 200) {
        return Ok(S3Object(body: reply.body, info: objectInfoOf(reply, reply.body.length())));
    }

    return Err(errorOf(reply));
}
