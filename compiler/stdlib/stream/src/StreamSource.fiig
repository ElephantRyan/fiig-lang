// ADR 0111 §1: what a stream source written in fiig provides. A program
// never calls it: an `adapter stream` route names a source, and the runtime
// receives its elements, runs the route's workflow on each, and settles
// the outcome. A source's manifest names the group that fulfils it:
// "provides": {"fiig.stream.StreamSource": "RedisStreams"}. fetch is one
// element by its id, or None when the source no longer has it, for `fiig
// run -replay` (open question 1, as amended 2026-11-21): it changes
// nothing, so the element is neither received nor settled.
interface StreamSource {
    receive(subscription: Subscription, batchSize: int) -> Result<List<Delivery>, SourceError>;
    settle(subscription: Subscription, delivery: Delivery, outcome: Outcome) -> Result<None, SourceError>;
    fetch(subscription: Subscription, id: string) -> Result<Delivery | None, SourceError>;
}
