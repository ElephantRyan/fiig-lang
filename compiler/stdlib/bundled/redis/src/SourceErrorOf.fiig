use fiig.stream;

// A failed command as the stream runtime reads it (ADR 0111 §1): the
// server out of reach is Unavailable, an answer it can't use is Protocol.
conversion sourceErrorOf(failure: RedisError) -> stream.SourceError {
    return match (failure) {
        RedisError.Socket(failure) -> stream.SourceError.Unavailable(
            reason: "Redis can't be reached: ${failure}"
        ),
        RedisError.InvalidUrl(reason) -> stream.SourceError.Unavailable(reason: reason),
        RedisError.Server(message) -> stream.SourceError.Protocol(reason: message),
        RedisError.MalformedReply(reason) -> stream.SourceError.Protocol(reason: reason),
        RedisError.InvalidCommand(reason) -> stream.SourceError.Protocol(reason: reason)
    }
}
