// A command as Redis reads it: an array of bulk strings, `*N CRLF` and then
// `$len CRLF bytes CRLF` for each argument. Every command, however it is
// spelled to a program, goes out in this one form.
conversion encodeCommand(args: List<bytes>) -> bytes {
    out: bytes = <<42: u8, "${args.length()}": utf8, 13: u8, 10: u8>>;
    for (arg in args) {
        out = <<
            out: bytes,
            36: u8,
            "${arg.length()}": utf8,
            13: u8,
            10: u8,
            arg: bytes,
            13: u8,
            10: u8
        >>;
    }

    return out;
}
