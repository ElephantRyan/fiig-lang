use com.degeneratedevelopment.redis.handshake;
use com.degeneratedevelopment.redis.resp;

test plainUrlTakesDefaults {
    expect handshake.parseRedisUrl("redis://cache.internal") is Ok(target);
    expect target == RedisTarget(host: "cache.internal", port: 6379, secure: false, user: None, password: None, database: 0);
}

test everyPartOfAUrl {
    expect handshake.parseRedisUrl("rediss://app:s3cr%40t:x@cache.example.com:6380/2") is Ok(target);
    expect target == RedisTarget(host: "cache.example.com", port: 6380, secure: true, user: "app", password: "s3cr@t:x", database: 2);
}

test passwordWithoutUser {
    expect handshake.parseRedisUrl("redis://:hunter2@localhost/") is Ok(target);
    expect target.user == None;
    expect target.password == "hunter2";
    expect target.database == 0;
}

test ipv6Host {
    expect handshake.parseRedisUrl("redis://[::1]:7000") is Ok(target);
    expect target.host == "::1";
    expect target.port == 7000;
}

test refusalsNeverShowTheUrl {
    cases = [
        "http://localhost",
        "redis://",
        "redis://h:99999",
        "redis://h/x",
        "redis://h/1/2",
        "redis://h?tls=1",
        "redis://u:%4@h",
        "redis://a:b:c"
    ];
    for (url in cases) {
        expect handshake.parseRedisUrl(url) is Err(RedisError.InvalidUrl(reason));
        expect !reason.contains(url);
    }
}

test newConnectionAuthenticatesAndSelects {
    target = RedisTarget(
        host: "h",
        port: 6379,
        secure: false,
        user: "app",
        password: "pw",
        database: 3
    );
    setup = handshake.setupRequest(target);
    expect setup.replies == 2;
    expect setup.data == "*3\r\n$4\r\nAUTH\r\n$3\r\napp\r\n$2\r\npw\r\n*2\r\n$6\r\nSELECT\r\n$1\r\n3\r\n".utf8();
}

test noSetupWithoutPasswordOrDatabase {
    target = RedisTarget(
        host: "h",
        port: 6379,
        secure: false,
        user: None,
        password: None,
        database: 0
    );
    expect handshake.setupRequest(target).replies == 0;
}

test aCommandIsOneArray {
    request = resp.commandRequest(["PING".utf8()]);
    expect request.replies == 1;
    expect request.data == "*1\r\n$4\r\nPING\r\n".utf8();
}

test sessionNamesUserAndDatabase {
    expect handshake.sessionOf(RedisTarget(host: "h", port: 1, secure: false, user: None, password: None, database: 0)) == "user=default db=0";
    expect handshake.sessionOf(RedisTarget(host: "h", port: 1, secure: false, user: "app", password: "x", database: 4)) == "user=app db=4";
}

test commandsThatChangeTheConnection {
    expect resp.keepsConnection("get");
    expect !resp.keepsConnection("subscribe");
    expect !resp.keepsConnection("MULTI");
}

test errorRepliesAreErrors {
    expect resp.commandReply(RespValue.Integer(value: 2)) is Ok(RespValue.Integer(value));
    expect value == 2;
    expect resp.commandReply(RespValue.Error(text: "ERR wrong type")) is Err(RedisError.Server(message));
    expect message.startsWith("ERR");
    expect handshake.setupRefusal([RespValue.Simple(text: "OK"), RespValue.Error(text: "ERR DB index is out of range")]) is RedisError.Server(refused);
    expect refused.contains("out of range");
    expect handshake.setupRefusal([RespValue.Simple(text: "OK"), RespValue.Simple(text: "OK")]) == None;
}
