test pathStyleHasTheBucketInThePath {
    expect objectTarget(aws(), "photos", "2026/cat.png", true) is Ok(target);
    expect target == S3Target(url: "https://s3.eu-west-1.amazonaws.com/photos/2026/cat.png", host: "s3.eu-west-1.amazonaws.com", path: "/photos/2026/cat.png");
}

test virtualHostedHasTheBucketInTheHost {
    expect objectTarget(aws(), "photos", "2026/cat.png", false) is Ok(target);
    expect target == S3Target(url: "https://photos.s3.eu-west-1.amazonaws.com/2026/cat.png", host: "photos.s3.eu-west-1.amazonaws.com", path: "/2026/cat.png");
}

test aPortInTheEndpointIsInTheUrlAndTheHost {
    expect objectTarget(S3Endpoint(scheme: "http", authority: "localhost:9000"), "photos", "a", true) is Ok(target);
    expect target.host == "localhost:9000";
    expect target.url == "http://localhost:9000/photos/a";
}

test everySegmentIsEncodedOnceAndSlashesStay {
    expect objectTarget(aws(), "photos", "a b/c?d#e%f/é.png", true) is Ok(target);
    expect target.path == "/photos/a%20b/c%3Fd%23e%25f/%C3%A9.png";
}

test aKeyCanHaveEmptySegments {
    expect objectTarget(aws(), "photos", "a//b/", true) is Ok(target);
    expect target.path == "/photos/a//b/";
}

test unreservedCharactersAreLeftAlone {
    expect objectTarget(aws(), "photos", "A-z_0.9~", true) is Ok(target);
    expect target.path == "/photos/A-z_0.9~";
}

test aDotSegmentIsRefused {
    for (key in ["..", "a/../b", "./a", "a/."]) {
        expect objectTarget(aws(), "photos", key, true) is Err(S3Error.InvalidRequest(reason));
    }
}

test anEmptyOrOversizeOrControlKeyIsRefused {
    expect objectTarget(aws(), "photos", "", true) is Err(S3Error.InvalidRequest(reason));
    expect objectTarget(aws(), "photos", repeated("a", 1025), true) is Err(S3Error.InvalidRequest(reason2));
    expect objectTarget(aws(), "photos", "a\nb", true) is Err(S3Error.InvalidRequest(reason3));
    expect objectTarget(aws(), "photos", repeated("a", 1024), true) is Ok(target);
}

test aBucketNameIsChecked {
    for (bad in ["", "ab", "Photos", "my_bucket", "-photos", "photos-", ".photos", "photos.", "has space", "a/b", repeated("a", 64)]) {
        expect objectTarget(aws(), bad, "k", true) is Err(S3Error.InvalidRequest(reason));
    }

    for (good in ["abc", "my-bucket", "my.bucket.v2", "a1b", repeated("a", 63)]) {
        expect objectTarget(aws(), good, "k", true) is Ok(target);
    }
}

private {
    aws() -> S3Endpoint {
        return S3Endpoint(scheme: "https", authority: "s3.eu-west-1.amazonaws.com");
    }

    repeated(piece: string, times: int) -> string {
        out: string = "";
        n: int = 0;
        while (n < times) {
            out = "${out}${piece}";
            n = n + 1;
        }

        return out;
    }
}
