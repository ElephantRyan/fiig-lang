// ADR 0117 §1, §3: KIP-848's ConsumerGroupHeartbeat v1 (API key 68): the
// member's own id and its epoch, the one topic it subscribes to, and the
// partitions of it the member owns now. Epoch 0 joins the group, and -1
// leaves it. No instance id, rack, regex, or server assignor.
conversion heartbeatRequest(
    clientId: string,
    correlation: int,
    group: string,
    memberId: string,
    epoch: int,
    topic: string,
    topicId: bytes,
    owned: List<int>)
        -> bytes {
    // TopicPartitions: none yet, or the topic's owned partitions.
    partitions: bytes = uvarint(1);
    if (topicId.length() == 16 && owned.length() > 0) {
        ids: bytes = uvarint(owned.length() + 1);
        for (p in owned) {
            ids = <<ids: bytes, p: i32be>>;
        }

        partitions = <<uvarint(2): bytes, topicId: bytes, ids: bytes, 0: u8>>;
    }

    body = <<
        compactString(group): bytes,
        compactString(memberId): bytes,
        epoch: i32be,
        0: u8,
        0: u8,
        60000: i32be,
        uvarint(2): bytes,
        compactString(topic): bytes,
        0: u8,
        0: u8,
        partitions: bytes,
        0: u8,
    >>;
    return kafkaFlexRequest(68, 1, correlation, clientId, body);
}
