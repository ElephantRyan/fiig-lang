use fiig.sql as db;

// ADR 0085 §3b: the messages for one statement, given the statements the
// connection has prepared and room for cacheSize of them. A prepared one is
// only bound; one the server stopped knowing is closed and parsed again
// under its name; a new one gets the next name, after the least recently
// used are closed to make room. Whichever runs moves to the end, most
// recently used. With cacheSize 0 nothing is cached and every
// statement is the unnamed one, parsed each time.
conversion planStatement(on: db.SqlConnection, sql: string, values: List<db.SqlValue>)
        -> StatementPlan {
    numbered = numberPlaceholders(sql);
    if (on.cacheSize <= 0) {
        return StatementPlan(
            connection: on,
            write: <<parseMessage("", numbered): bytes, statementMessages("", values): bytes>>,
            name: "",
            parsing: false,
        );
    }

    others: List<db.SqlStatement> = [];
    found: db.SqlStatement | None = None;
    for (statement in on.statements) {
        if (statement.sql == sql) {
            found = statement;
        } else {
            others = append(others, statement);
        }
    }

    return match (found) {
        None -> {
            name = "fiig_s${on.named}";
            closing: bytes = <<>>;
            while (others.length() >= on.cacheSize) {
                closing = <<closing: bytes, closeMessage(others.first().name): bytes>>;
                others = others.slice(1, others.length());
            }

            added = append(others, db.SqlStatement(sql: sql, name: name, prepared: false));
            return StatementPlan(
                connection: copy(on, statements: added, named: on.named + 1),
                write: <<closing: bytes, parseMessage(name, numbered): bytes, statementMessages(name, values): bytes>>,
                name: name,
                parsing: true,
            );
        },

        cached -> {
            moved = append(others, cached);
            if (cached.prepared) {
                return StatementPlan(
                    connection: copy(on, statements: moved),
                    write: statementMessages(cached.name, values),
                    name: cached.name,
                    parsing: false,
                );
            }

            return StatementPlan(
                connection: copy(on, statements: moved),
                write: <<closeMessage(cached.name): bytes, parseMessage(cached.name, numbered): bytes, statementMessages(cached.name, values): bytes>>,
                name: cached.name,
                parsing: true,
            );
        },
    }
}
