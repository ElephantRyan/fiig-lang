test toDateTimeat1970_1_1_0_0_0 {
    expect toDateTime(0) is Ok(t);
    expect t == DateTime(year: 1970, month: 1, day: 1, hour: 0, minute: 0, second: 0, millisecond: 0);
}

test toDateTimeat1969_12_31_23_59_59_999 {
    expect toDateTime(-1) is Ok(t);
    expect t == DateTime(year: 1969, month: 12, day: 31, hour: 23, minute: 59, second: 59, millisecond: 999);
}

test toDateTimeat1969_12_31_0_0_0 {
    expect toDateTime(-86400000) is Ok(t);
    expect t == DateTime(year: 1969, month: 12, day: 31, hour: 0, minute: 0, second: 0, millisecond: 0);
}

