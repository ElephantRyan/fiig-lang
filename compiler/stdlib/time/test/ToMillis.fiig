test toMillisRefusesTheTwentyNinthOfFebruaryInACommonYear {
    expect toMillis(DateTime(year: 2026, month: 2, day: 29, hour: 0, minute: 0, second: 0, millisecond: 0)) is Err(TimeError.Invalid(reason))
}

test toMillisRefusesTheTwentyNinthOfFebruaryInACenturyYear {
    expect toMillis(DateTime(year: 2100, month: 2, day: 29, hour: 0, minute: 0, second: 0, millisecond: 0)) is Err(TimeError.Invalid(reason))
}

test toMillisRefusesTheThirtyFirstOfApril {
    expect toMillis(DateTime(year: 2026, month: 4, day: 31, hour: 0, minute: 0, second: 0, millisecond: 0)) is Err(TimeError.Invalid(reason))
}

test toMillisRefusesMonthThirteen {
    expect toMillis(DateTime(year: 2026, month: 13, day: 1, hour: 0, minute: 0, second: 0, millisecond: 0)) is Err(TimeError.Invalid(reason))
}

test toMillisRefusesMonthZero {
    expect toMillis(DateTime(year: 2026, month: 0, day: 1, hour: 0, minute: 0, second: 0, millisecond: 0)) is Err(TimeError.Invalid(reason))
}

test toMillisRefusesDayZero {
    expect toMillis(DateTime(year: 2026, month: 1, day: 0, hour: 0, minute: 0, second: 0, millisecond: 0)) is Err(TimeError.Invalid(reason))
}

test toMillisRefusesHourTwentyFour {
    expect toMillis(DateTime(year: 2026, month: 1, day: 1, hour: 24, minute: 0, second: 0, millisecond: 0)) is Err(TimeError.Invalid(reason))
}

test toMillisRefusesMinuteSixty {
    expect toMillis(DateTime(year: 2026, month: 1, day: 1, hour: 0, minute: 60, second: 0, millisecond: 0)) is Err(TimeError.Invalid(reason))
}

test toMillisRefusesSecondSixty {
    expect toMillis(DateTime(year: 2026, month: 1, day: 1, hour: 0, minute: 0, second: 60, millisecond: 0)) is Err(TimeError.Invalid(reason))
}

test toMillisRefusesMillisecondAThousand {
    expect toMillis(DateTime(year: 2026, month: 1, day: 1, hour: 0, minute: 0, second: 0, millisecond: 1000)) is Err(TimeError.Invalid(reason))
}

test toMillisRefusesANegativeHour {
    expect toMillis(DateTime(year: 2026, month: 1, day: 1, hour: -1, minute: 0, second: 0, millisecond: 0)) is Err(TimeError.Invalid(reason))
}

test toMillisRefusesYearTenThousand {
    expect toMillis(DateTime(year: 10000, month: 1, day: 1, hour: 0, minute: 0, second: 0, millisecond: 0)) is Err(TimeError.OutOfRange(reason))
}

test toMillisRefusesANegativeYear {
    expect toMillis(DateTime(year: -1, month: 1, day: 1, hour: 0, minute: 0, second: 0, millisecond: 0)) is Err(TimeError.OutOfRange(reason))
}

test toMillisAcceptsTheLeapDaysOfYearsDivisibleBy400 {
    expect toMillis(DateTime(year: 2000, month: 2, day: 29, hour: 0, minute: 0, second: 0, millisecond: 0)) is Ok(a)
    expect toMillis(DateTime(year: 2400, month: 2, day: 29, hour: 0, minute: 0, second: 0, millisecond: 0)) is Ok(b)
    expect a == 951782400000
    expect b == 13574563200000
}
