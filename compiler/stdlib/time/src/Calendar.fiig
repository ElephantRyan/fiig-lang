// A UTC calendar over moments in int milliseconds (ADR 0123 §2): a moment's
// reading and the way back, the day of the week, and the text forms that
// JSON APIs, HTTP, email and AWS signing write. Formulas, so a rule may use
// them, and each says why it failed (ADR 0151).
formulas calendar {
    // A moment's calendar reading in UTC (ADR 0123 §2). The day is worked out
    // with Howard Hinnant's civil_from_days, using floor division so a moment
    // before 1970 comes out right: fiig's `/` truncates toward zero, so the day
    // count is floored by hand. Years 0000 to 9999 are readable, as RFC 3339
    // writes them; outside that is OutOfRange, not a clamp.
    formula toDateTime(millis: int) -> Result<DateTime, TimeError> {
        if (millis < -62167219200000 || millis > 253402300799999) {
            return Err(
                TimeError.OutOfRange(reason: "the moment is outside the years 0000 to 9999")
            );
        }

        days: int = millis / 86400000;
        msOfDay: int = millis % 86400000;
        if (msOfDay < 0) {
            days = days - 1;
            msOfDay = msOfDay + 86400000;
        }

        shifted = days + 719468;
        era: int = shifted / 146097;
        if (shifted < 0) {
            era = (shifted - 146096) / 146097;
        }

        dayOfEra = shifted - era * 146097;
        yearOfEra = (dayOfEra - dayOfEra / 1460 + dayOfEra / 36524 - dayOfEra / 146096) / 365;
        dayOfYear = dayOfEra - (365 * yearOfEra + yearOfEra / 4 - yearOfEra / 100);
        monthIndex = (5 * dayOfYear + 2) / 153;
        day = dayOfYear - (153 * monthIndex + 2) / 5 + 1;
        month: int = monthIndex + 3;
        if (monthIndex >= 10) {
            month = monthIndex - 9;
        }

        year: int = yearOfEra + era * 400;
        if (month <= 2) {
            year = year + 1;
        }

        hour = msOfDay / 3600000;
        minute = (msOfDay % 3600000) / 60000;
        second = (msOfDay % 60000) / 1000;
        millisecond = msOfDay % 1000;
        return Ok(
            DateTime(
                year: year,
                month: month,
                day: day,
                hour: hour,
                minute: minute,
                second: second,
                millisecond: millisecond
            )
        );
    }

    // The moment a UTC calendar reading names (ADR 0123 §2), the way back from
    // toDateTime. Every field is checked, the day against its month and the
    // year's leap day included, so 2026-02-29 is Invalid and 2000-02-29 is not.
    // The day count is Hinnant's days_from_civil with floor division.
    formula toMillis(dateTime: DateTime) -> Result<int, TimeError> {
        if (dateTime.year < 0 || dateTime.year > 9999) {
            return Err(
                TimeError.OutOfRange(reason: "the year ${dateTime.year} is outside 0000 to 9999")
            );
        }

        if (dateTime.month < 1 || dateTime.month > 12) {
            return Err(TimeError.Invalid(reason: "the month ${dateTime.month} is not 1 to 12"));
        }

        if (dateTime.day < 1 || dateTime.day > daysInMonth(dateTime.year, dateTime.month)) {
            return Err(
                TimeError.Invalid(
                    reason: "day ${dateTime.day} does not exist in ${dateTime.year}-${dateTime.month}"
                )
            );
        }

        if (dateTime.hour < 0 || dateTime.hour > 23) {
            return Err(TimeError.Invalid(reason: "the hour ${dateTime.hour} is not 0 to 23"));
        }

        if (dateTime.minute < 0 || dateTime.minute > 59) {
            return Err(TimeError.Invalid(reason: "the minute ${dateTime.minute} is not 0 to 59"));
        }

        if (dateTime.second < 0 || dateTime.second > 59) {
            return Err(TimeError.Invalid(reason: "the second ${dateTime.second} is not 0 to 59"));
        }

        if (dateTime.millisecond < 0 || dateTime.millisecond > 999) {
            return Err(
                TimeError.Invalid(
                    reason: "the millisecond ${dateTime.millisecond} is not 0 to 999"
                )
            );
        }

        y: int = dateTime.year;
        if (dateTime.month <= 2) {
            y = y - 1;
        }

        era: int = y / 400;
        if (y < 0) {
            era = (y - 399) / 400;
        }

        yearOfEra = y - era * 400;
        monthIndex: int = dateTime.month - 3;
        if (dateTime.month <= 2) {
            monthIndex = dateTime.month + 9;
        }

        dayOfYear = (153 * monthIndex + 2) / 5 + dateTime.day - 1;
        dayOfEra = yearOfEra * 365 + yearOfEra / 4 - yearOfEra / 100 + dayOfYear;
        days = era * 146097 + dayOfEra - 719468;
        timeOfDay = dateTime.hour * 3600000 + dateTime.minute * 60000 + dateTime.second * 1000 + dateTime.millisecond;
        return Ok(days * 86400000 + timeOfDay);
    }

    // The day of the week a moment falls on in UTC: 0 is Sunday and 6 is
    // Saturday, as in cron (ADR 0112) and JavaScript. The epoch was a Thursday.
    formula weekday(millis: int) -> int {
        days: int = millis / 86400000;
        if (millis % 86400000 < 0) {
            days = days - 1;
        }

        return ((days % 7) + 11) % 7;
    }

    // RFC 3339, the form JSON APIs use: `2026-11-20T13:59:58.000Z`, always UTC
    // and always with three fractional digits, so the strings of two moments sort
    // the way the moments do (ADR 0123 §2).
    formula formatIso(millis: int) -> Result<string, TimeError> {
        t = toDateTime(millis)?;
        date = "${zeroPad(t.year, 4)}-${zeroPad(t.month, 2)}-${zeroPad(t.day, 2)}";
        clock = "${zeroPad(t.hour, 2)}:${zeroPad(t.minute, 2)}:${zeroPad(t.second, 2)}.${zeroPad(t.millisecond, 3)}";
        return Ok("${date}T${clock}Z");
    }

    // A moment from RFC 3339 text (ADR 0123 §2): `2026-11-20T13:59:58Z`,
    // `2026-11-20T15:59:58.5+02:00`. A zone offset is folded into UTC and then
    // forgotten. Lenient about what it receives, as charter principle 10 says:
    // `t` and `z` in lower case are read, a space may stand for the `T`, and a
    // fraction of any length is read and cut to milliseconds. A leap second
    // (`:60`) is refused, since no moment in an int of milliseconds is one.
    // A reason never repeats the text.
    formula parseIso(text: string) -> Result<int, TimeError> {
        n = text.length();
        if (n < 20) {
            return Err(TimeError.Invalid(reason: "it is too short for a date, a time and a zone"));
        }

        if (text.slice(4, 5) != "-" || text.slice(7, 8) != "-" || text.slice(13, 14) != ":" || text.slice(16, 17) != ":") {
            return Err(TimeError.Invalid(reason: "it is not YYYY-MM-DDTHH:MM:SS"));
        }

        separator = text.slice(10, 11);
        if (separator != "T" && separator != "t" && separator != " ") {
            return Err(TimeError.Invalid(reason: "the date and the time are not separated by T"));
        }

        year = number(text.slice(0, 4));
        month = number(text.slice(5, 7));
        day = number(text.slice(8, 10));
        hour = number(text.slice(11, 13));
        minute = number(text.slice(14, 16));
        second = number(text.slice(17, 19));
        if (year < 0 || month < 0 || day < 0 || hour < 0 || minute < 0 || second < 0) {
            return Err(TimeError.Invalid(reason: "a date or time field is not a number"));
        }

        position: int = 19;
        millisecond: int = 0;
        if (text.slice(19, 20) == ".") {
            end: int = 20;
            while (end < n && number(text.slice(end, end + 1)) >= 0) {
                end = end + 1;
            }

            fraction = text.slice(20, end);
            if (fraction.length() == 0) {
                return Err(TimeError.Invalid(reason: "the fraction has no digits"));
            }

            millisecond = number("${fraction}00".slice(0, 3));
            position = end;
        }

        zone = text.slice(position, n);
        offsetMillis: int = 0;
        if (zone == "Z" || zone == "z") {
            offsetMillis = 0;
        } else if (zone.length() == 6 && (zone.slice(0, 1) == "+" || zone.slice(0, 1) == "-") && zone.slice(3, 4) == ":") {
            offsetHours = number(zone.slice(1, 3));
            offsetMinutes = number(zone.slice(4, 6));
            if (offsetHours < 0 || offsetMinutes < 0 || offsetHours > 23 || offsetMinutes > 59) {
                return Err(TimeError.Invalid(reason: "the zone offset is not +HH:MM"));
            }

            offsetMillis = (offsetHours * 60 + offsetMinutes) * 60000;
            if (zone.slice(0, 1) == "-") {
                offsetMillis = 0 - offsetMillis;
            }
        } else {
            return Err(TimeError.Invalid(reason: "the zone is neither Z nor +HH:MM"));
        }

        local = toMillis(
            DateTime(
                year: year,
                month: month,
                day: day,
                hour: hour,
                minute: minute,
                second: second,
                millisecond: millisecond
            )
        )?;
        moment = local - offsetMillis;
        if (moment < -62167219200000 || moment > 253402300799999) {
            return Err(
                TimeError.OutOfRange(reason: "the moment is outside the years 0000 to 9999")
            );
        }

        return Ok(moment);
    }

    // An HTTP date, IMF-fixdate (RFC 9110 §5.6.7): `Fri, 20 Nov 2026 13:59:58
    // GMT`. The day is two digits and the zone is the word GMT, which is what a
    // `Date` header, a cookie's `Expires`, and `Retry-After` write. Whole
    // seconds: the milliseconds are dropped (ADR 0123 §2).
    formula formatHttp(millis: int) -> Result<string, TimeError> {
        t = toDateTime(millis)?;
        weekdays: List<string> = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
        months: List<string> = [
            "Jan",
            "Feb",
            "Mar",
            "Apr",
            "May",
            "Jun",
            "Jul",
            "Aug",
            "Sep",
            "Oct",
            "Nov",
            "Dec"
        ];
        clock = "${zeroPad(t.hour, 2)}:${zeroPad(t.minute, 2)}:${zeroPad(t.second, 2)}";
        return Ok(
            "${weekdays.at(weekday(millis))}, ${zeroPad(t.day, 2)} ${months.at(t.month - 1)} ${zeroPad(t.year, 4)} ${clock} GMT"
        );
    }

    // An email's Date header (RFC 5322 §3.3): `Fri, 20 Nov 2026 13:59:58
    // +0000`. The day has one or two digits and the zone is a numeric offset,
    // always +0000 here. Whole seconds: the milliseconds are dropped (ADR 0123
    // §2).
    formula formatRfc5322(millis: int) -> Result<string, TimeError> {
        t = toDateTime(millis)?;
        weekdays: List<string> = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
        months: List<string> = [
            "Jan",
            "Feb",
            "Mar",
            "Apr",
            "May",
            "Jun",
            "Jul",
            "Aug",
            "Sep",
            "Oct",
            "Nov",
            "Dec"
        ];
        clock = "${zeroPad(t.hour, 2)}:${zeroPad(t.minute, 2)}:${zeroPad(t.second, 2)}";
        return Ok(
            "${weekdays.at(weekday(millis))}, ${t.day} ${months.at(t.month - 1)} ${zeroPad(t.year, 4)} ${clock} +0000"
        );
    }

    // ISO 8601's basic form, no separators: `20261120T135958Z`. AWS Signature
    // Version 4 signs with it, and its first eight characters are the day a
    // credential scope names (ADR 0123 §2). Whole seconds.
    formula formatBasic(millis: int) -> Result<string, TimeError> {
        t = toDateTime(millis)?;
        date = "${zeroPad(t.year, 4)}${zeroPad(t.month, 2)}${zeroPad(t.day, 2)}";
        clock = "${zeroPad(t.hour, 2)}${zeroPad(t.minute, 2)}${zeroPad(t.second, 2)}";
        return Ok("${date}T${clock}Z");
    }
}

private {
    daysInMonth(year: int, month: int) -> int {
        if (month == 2) {
            if (year % 4 == 0 && (year % 100 != 0 || year % 400 == 0)) {
                return 29;
            }

            return 28;
        }

        if (month == 4 || month == 6 || month == 9 || month == 11) {
            return 30;
        }

        return 31;
    }

    // The number a run of digits writes, or -1 when it holds anything else
    // (a sign, a space, a letter) or nothing at all.
    number(digits: string) -> int {
        if (digits.length() == 0) {
            return -1;
        }

        bytes = digits.utf8();
        value: int = 0;
        i: int = 0;
        while (i < bytes.length()) {
            b = bytes.at(i);
            if (b < 48 || b > 57) {
                return -1;
            }

            value = value * 10 + (b - 48);
            i = i + 1;
        }

        return value;
    }

    // A number written in at least `width` digits, with zeros in front: the
    // two-digit hour and four-digit year every format here needs. A negative
    // number is written as it is.
    zeroPad(n: int, width: int) -> string {
        text: string = "${n}";
        if (n < 0) {
            return text;
        }

        while (text.length() < width) {
            text = "0${text}";
        }

        return text;
    }
}
