use fiig.stream

// ADR 0111 open question 1, as amended 2026-11-21: the record a fetch at
// one offset returned with exactly that offset, as its delivery on attempt
// 1, or None when the partition no longer reaches it (OFFSET_OUT_OF_RANGE)
// or holds no record there, such as a compacted one. A fetch returns whole
// batches, so it may start before the offset.
conversion recordAt(
    parts: List<FetchedPartition>,
    at: PartitionOffset,
) -> Result<stream.Delivery | None, KafkaError> {
    for (part in parts) {
        if (part.partition == at.partition) {
            if (part.code == 1) {
                return Ok(None);
            }

            if (part.code != 0) {
                return Err(brokerError(part.code, "Fetch"));
            }

            for (record in part.records) {
                if (record.offset == at.offset) {
                    return Ok(
                        stream.Delivery(
                            id: "${at.partition}/${at.offset}",
                            payload: record.value,
                            attempt: 1,
                            order: "${at.partition}",
                        ),
                    );
                }
            }
        }
    }

    return Ok(None);
}
