// ADR 0113 §1: a Produce v8 response read as where each record went: a
// batch's records are at its base offset and the ones after it. A
// partition's error is the call's, with the broker's message when it gives
// one.
conversion readProduce(frame: bytes, correlation: int, call: ProduceCall) -> Result<List<SentAt>, KafkaError> {
    got = intAt(frame, 0)?
    if got != correlation {
        return Err(
            KafkaError.MalformedReply(reason: "Produce answered correlation ${got}, not ${correlation}"),
        )
    }
    pos: int = 4
    topics = intAt(frame, pos)?
    pos = pos + 4
    sent: List<SentAt> = []
    t: int = 0
    while t < topics {
        name = textAt(frame, pos)?
        pos = name.next
        partitions = intAt(frame, pos)?
        pos = pos + 4
        p: int = 0
        while p < partitions {
            index = intAt(frame, pos)?
            code = shortAt(frame, pos + 4)?
            baseOffset = longAt(frame, pos + 6)?
            // log_append_time_ms and log_start_offset, then the record errors.
            pos = pos + 30
            recordErrors = intAt(frame, pos)?
            pos = pos + 4
            detail: string = ""
            e: int = 0
            while e < recordErrors {
                message = textAt(frame, pos + 4)?
                if detail == "" {
                    detail = message.text
                }
                pos = message.next
                e = e + 1
            }
            message = textAt(frame, pos)?
            pos = message.next
            if message.text != "" {
                detail = message.text
            }
            if code != 0 {
                failure = brokerError(code, "Produce to ${name.text} partition ${index}")
                match failure {
                    KafkaError.Broker(failed, label, retriable, text) -> {
                        if detail != "" {
                            return Err(
                                KafkaError.Broker(code: failed, name: label, retriable: retriable, message: "${text}: ${detail}"),
                            )
                        }
                    }
                    _ -> None
                }
                return Err(failure)
            }
            for batch in call.batches {
                if batch.partition == index {
                    n: int = 0
                    for record in batch.indexes {
                        sent = append(
                            sent,
                            SentAt(index: record, partition: index, offset: baseOffset + n),
                        )
                        n = n + 1
                    }
                }
            }
            p = p + 1
        }
        t = t + 1
    }
    return Ok(sent)
}

private {
    short() -> KafkaError {
        return KafkaError.MalformedReply(reason: "a Produce response ends early")
    }

    intAt(data: bytes, at: int) -> Result<int, KafkaError> {
        match i32At(data, at) {
            None -> {
                return Err(short())
            }
            value -> {
                return Ok(value)
            }
        }
    }

    shortAt(data: bytes, at: int) -> Result<int, KafkaError> {
        match i16At(data, at) {
            None -> {
                return Err(short())
            }
            value -> {
                return Ok(value)
            }
        }
    }

    longAt(data: bytes, at: int) -> Result<int, KafkaError> {
        match i64At(data, at) {
            None -> {
                return Err(short())
            }
            value -> {
                return Ok(value)
            }
        }
    }

    textAt(data: bytes, at: int) -> Result<TextAt, KafkaError> {
        match stringAt(data, at) {
            None -> {
                return Err(short())
            }
            value -> {
                return Ok(value)
            }
        }
    }
}
