use fiig.sql as db

// One backend message of a statement's reply (§3, §9). An error is kept
// until ReadyForQuery, which ends the reply either way; a message the
// driver can't read ends it at once. Notices, ParameterStatus and the
// Complete messages are skipped.
conversion replyStep(state: Reply, kind: int, body: bytes) -> Reply {
    if kind == 84 {
        match rowDescription(body) {
            None -> {
                return copy(
                    state,
                    row: None,
                    failed: db.DatabaseError.Protocol(reason: "a RowDescription is malformed"),
                    ready: true,
                )
            }
            shape -> {
                return copy(state, row: None, columns: shape.names, types: shape.types)
            }
        }
    }
    if kind == 68 {
        match dataRow(body, state.types) {
            None -> {
                return copy(
                    state,
                    row: None,
                    failed: db.DatabaseError.Protocol(reason: "a DataRow doesn't match its RowDescription"),
                    ready: true,
                )
            }
            row -> {
                return copy(state, row: row)
            }
        }
    }
    if kind == 67 {
        end = cStringEnd(body)
        if end >= 0 {
            match body.slice(0, end).utf8() {
                None -> None
                tag -> {
                    return copy(state, row: None, affected: commandCount(tag))
                }
            }
        }
        return copy(state, row: None)
    }
    if kind == 69 {
        return copy(state, row: None, failed: serverError(body))
    }
    if kind == 90 {
        return copy(state, row: None, ready: true)
    }
    return copy(state, row: None)
}
