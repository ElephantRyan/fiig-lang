// ADR 0113 §6: where the cluster is, as Kafka's bootstrap.servers writes
// it (host:port, comma-separated), and how long one send may take.
config KafkaServer {
    bootstrap: string from env "KAFKA_BOOTSTRAP"
    tls: bool from env "KAFKA_TLS" = false
    clientId: string from env "KAFKA_CLIENT_ID" = "fiig"
    timeoutMillis: int from env "KAFKA_TIMEOUT_MS" = 30000
}
