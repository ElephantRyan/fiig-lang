// ADR 0085 §4: each ? becomes $1, $2, ... in order, skipping what isn't
// SQL code: quoted strings and identifiers, comments, and dollar-quoted
// bodies. ?? is a literal ? (JSONB's operators). The scan is over bytes,
// since every character it looks for is ASCII.
conversion numberPlaceholders(sql: string) -> string {
    data = sql.utf8();
    n = data.length();
    out: bytes = <<>>;
    i: int = 0;
    start: int = 0;
    count: int = 0;
    while (i < n) {
        c = data.at(i);
        if (c == 39 || c == 34) {
            i = quotedEnd(data, i);
        } else if (c == 45 && i + 1 < n && data.at(i + 1) == 45) {
            i = lineCommentEnd(data, i);
        } else if (c == 47 && i + 1 < n && data.at(i + 1) == 42) {
            i = blockCommentEnd(data, i);
        } else if (c == 36) {
            i = dollarQuoteEnd(data, i);
        } else if (c == 63) {
            if (i + 1 < n && data.at(i + 1) == 63) {
                out = <<out: bytes, data.slice(start, i + 1): bytes>>;
                i = i + 2;
            } else {
                count = count + 1;
                out = <<out: bytes, data.slice(start, i): bytes, "$${count}": utf8>>;
                i = i + 1;
            }

            start = i;
        } else {
            i = i + 1;
        }
    }

    out = <<out: bytes, data.slice(start, n): bytes>>;
    return match (out.utf8()) {
        None -> sql,
        text -> text
    }
}
