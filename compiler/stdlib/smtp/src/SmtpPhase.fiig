// Where a send has got to. Upgrading is the moment between the server's
// agreement to STARTTLS and the handshake, which has no reply to read. Auth
// is AUTH PLAIN's one line; AuthLogin, LoginUser and LoginPassword are AUTH
// LOGIN's three. Reset is the RSET a kept connection starts with, and Sent
// is a mail the server has accepted.
enum SmtpPhase {
    Greeting
    Hello
    StartTls
    Upgrading
    SecureHello
    Auth
    AuthLogin
    LoginUser
    LoginPassword
    Reset
    MailFrom
    Rcpt
    Data
    Body
    Sent
}
