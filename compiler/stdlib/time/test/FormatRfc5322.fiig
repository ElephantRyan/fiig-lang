test formatRfc5322at1970_1_1_0_0_0 {
    expect formatRfc5322(0) is Ok(text)
    expect text == "Thu, 1 Jan 1970 00:00:00 +0000"
}

test formatRfc5322at1969_12_31_23_59_59_999 {
    expect formatRfc5322(-1) is Ok(text)
    expect text == "Wed, 31 Dec 1969 23:59:59 +0000"
}

test formatRfc5322at1969_12_31_0_0_0 {
    expect formatRfc5322(-86400000) is Ok(text)
    expect text == "Wed, 31 Dec 1969 00:00:00 +0000"
}

test formatRfc5322at1900_1_1_0_0_0 {
    expect formatRfc5322(-2208988800000) is Ok(text)
    expect text == "Mon, 1 Jan 1900 00:00:00 +0000"
}

