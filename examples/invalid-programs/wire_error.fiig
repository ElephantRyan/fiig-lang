// ADR 0069 §6: what the HTTP adapter refuses to write, reported by the
// checker when it can see the value. W1: a header the adapter owns, since
// Content-Type comes from the route's produces. Three declarations in one
// file, so G1 also fires, incidentally but correctly.
conversion htmlPage(page: string) -> HttpResponse<string> {
    return HttpResponse(status: 200, body: page, headers: ["Content-Type": "text/html"])
}

// W2: a cookie sent to any site must be Secure, and browsers drop this one
// without a word, so the bug would surface as an embed that never logs in.
conversion embedCookie(token: string) -> HttpResponse<None> {
    return HttpResponse(
        status: 204,
        cookies: [Cookie(name: "embed", value: token, sameSite: SameSite.AnySite, sentOverPlainHttp: true)],
    )
}

// W3: an enum with payloads names its variant in a JSON `variant` member
// (ADR 0072 §2), so a payload field with that name would be sent twice.
enum Delivery {
    Shipped(variant: string)
    Pending
}

// W4 (ADR 0080 §6): a path segment is one piece of text, and a Delivery
// with a payload has no single-text form, so this route would answer
// every request 400.
workflow trackDelivery(delivery: Delivery) -> string {
    return "tracked"
}

adapter http deliveryApi {
    GET "/deliveries/{delivery}" -> trackDelivery(delivery: Delivery)
        produces "application/json"
}
