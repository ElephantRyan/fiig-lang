// ADR 0146 §7: a token's header and payload, NOT verified: for debugging
// tools, and the rare program that reads one before it knows which issuer
// to check it against. Nothing in it is trusted.
conversion decodeUnverified(token: string) -> Result<Unverified, JwtError> {
    parts = tokenOf(token)?;
    return Ok(
        Unverified(
            header: JsonValue.Object(members: parts.header),
            payload: JsonValue.Object(members: parts.payload)
        )
    );
}
