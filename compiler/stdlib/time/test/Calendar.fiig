use fiig.time.calendar;

test toDateTimeat1970_1_1_0_0_0 {
    expect calendar.toDateTime(0) is Ok(t);
    expect t == DateTime(year: 1970, month: 1, day: 1, hour: 0, minute: 0, second: 0, millisecond: 0);
}

