test formatBasicRefusesAMomentBeforeYearZero {
    expect calendar.formatBasic(-62167219200001) is Err(TimeError.OutOfRange(reason));
}

test formatBasicRefusesAMomentAfterYear9999 {
    expect calendar.formatBasic(253402300800000) is Err(TimeError.OutOfRange(reason));
}
