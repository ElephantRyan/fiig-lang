// A Date header's value from Unix milliseconds, always in UTC:
// `Fri, 20 Nov 2026 13:59:58 +0000`. fiig has no time type (known
// limitations), so the calendar is worked out from the day count with Howard
// Hinnant's civil_from_days, which is exact for every date from 1970.
conversion rfc5322Date(millis: int) -> string {
    safe: int = millis
    if safe < 0 {
        safe = 0
    }
    seconds = safe / 1000
    days = seconds / 86400
    secondOfDay = seconds - days * 86400
    shifted = days + 719468
    era = shifted / 146097
    dayOfEra = shifted - era * 146097
    yearOfEra = (dayOfEra - dayOfEra / 1460 + dayOfEra / 36524 - dayOfEra / 146096) / 365
    dayOfYear = dayOfEra - (365 * yearOfEra + yearOfEra / 4 - yearOfEra / 100)
    monthIndex = (5 * dayOfYear + 2) / 153
    day = dayOfYear - (153 * monthIndex + 2) / 5 + 1
    month: int = monthIndex + 3
    if monthIndex >= 10 {
        month = monthIndex - 9
    }
    year: int = yearOfEra + era * 400
    if month <= 2 {
        year = year + 1
    }
    weekday = (days + 4) % 7
    hour = secondOfDay / 3600
    minute = (secondOfDay - hour * 3600) / 60
    second = secondOfDay - hour * 3600 - minute * 60
    weekdays: List<string> = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"]
    months: List<string> = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
    clock = "${two(hour)}:${two(minute)}:${two(second)}"
    return "${weekdays.at(weekday)}, ${day} ${months.at(month - 1)} ${year} ${clock} +0000"
}

private {
    two(n: int) -> string {
        if n < 10 {
            return "0${n}"
        }
        return "${n}"
    }
}
