use fiig.session;

// ADR 0117 §2-§3: fiig.kafka's session protocol, which the consumer's
// gateways reach through Session.call. Each operation is a conversion
// over the state, so the runtime half only carries bytes. opened and
// received read the SASL login from KafkaServer (ADR 0113 §6, as amended
// 2026-11-21), so the password is never in the settings or the state, and
// opened draws SCRAM's nonce from Random.
capability KafkaSession provides session.SessionProtocol {
    gateway opened(settings: Map<string, string>, now: int) -> session.Step requires Session {
        password: bytes = <<>>;
        match (KafkaServer.saslPassword) {
            None -> None,
            given -> {
                password = given.reveal().utf8();
            }
        }

        login = SaslLogin(
            mechanism: KafkaServer.saslMechanism,
            username: KafkaServer.saslUsername,
            password: password
        );
        return sessionOpened(settings, now, login, Random.bytes(24).toBase64());
    }

    gateway received(state: bytes, data: bytes, now: int) -> session.Step requires Session {
        password: bytes = <<>>;
        match (KafkaServer.saslPassword) {
            None -> None,
            given -> {
                password = given.reveal().utf8();
            }
        }

        login = SaslLogin(
            mechanism: KafkaServer.saslMechanism,
            username: KafkaServer.saslUsername,
            password: password
        );
        return sessionReceived(state, data, now, login);
    }

    gateway asked(state: bytes, message: bytes, now: int) -> session.Step requires Session {
        return sessionAsked(state, message, now);
    }

    gateway tick(state: bytes, now: int) -> session.Step requires Session {
        return sessionTick(state, now);
    }

    gateway closing(state: bytes, now: int) -> session.Step requires Session {
        return sessionClosing(state, now);
    }

    // Never called: a Kafka session's state ends with its connection
    // (ADR 0146 §5a), since it holds that connection's login and epoch.
    gateway ended(state: bytes, reason: string, now: int) -> session.Step requires Session {
        return session.Step(
            state: state,
            write: <<>>,
            accepted: None,
            replies: [],
            nextTickAt: None,
            close: None
        );
    }
}
