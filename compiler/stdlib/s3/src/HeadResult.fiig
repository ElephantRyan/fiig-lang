use fiig.http;

// What a HEAD says about an object, from its reply's headers (its
// metadata included), when the server says 200. A reply with no Content-Length is malformed: the size is
// the point of asking.
conversion headResult(reply: http.Reply) -> Result<ObjectInfo, S3Error> {
    if (reply.status != 200) {
        return Err(errorOf(reply));
    }

    return match (headerValue(reply, "Content-Length").toIntOrNone()) {
        None -> Err(
            S3Error.Http(
                failure: http.HttpError.MalformedReply(
                    reason: "a HEAD reply has no readable Content-Length"
                )
            )
        ),
        size -> Ok(objectInfoOf(reply, size))
    }
}

private {
    // The first header of that name, in any case, or "".
    headerValue(reply: http.Reply, name: string) -> string {
        for (header in reply.headers) {
            if (header.name.equalsIgnoringCase(name)) {
                return header.value;
            }
        }

        return "";
    }
}
