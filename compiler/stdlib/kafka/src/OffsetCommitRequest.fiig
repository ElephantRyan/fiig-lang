// ADR 0117 §5: OffsetCommit v9 (API key 8), the first a KIP-848 member
// may send: the member's id and epoch, and the next offset to read in
// each partition of topic.
conversion offsetCommitRequest(
    clientId: string,
    correlation: int,
    group: string,
    memberId: string,
    epoch: int,
    topic: string,
    offsets: List<PartitionOffset>)
        -> bytes {
    partitions: bytes = uvarint(offsets.length() + 1);
    for (o in offsets) {
        partitions = <<
            partitions: bytes,
            o.partition: i32be,
            o.offset: i64be,
            0 - 1: i32be,
            0: u8,
            0: u8,
        >>;
    }

    body = <<
        compactString(group): bytes,
        epoch: i32be,
        compactString(memberId): bytes,
        0: u8,
        uvarint(2): bytes,
        compactString(topic): bytes,
        partitions: bytes,
        0: u8,
        0: u8,
    >>;
    return kafkaFlexRequest(8, 9, correlation, clientId, body);
}
