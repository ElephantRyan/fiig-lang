test toMillisAcceptsTheLeapDaysOfYearsDivisibleBy400 {
    expect calendar.toMillis(DateTime(year: 2000, month: 2, day: 29, hour: 0, minute: 0, second: 0, millisecond: 0)) is Ok(a);
    expect calendar.toMillis(DateTime(year: 2400, month: 2, day: 29, hour: 0, minute: 0, second: 0, millisecond: 0)) is Ok(b);
    expect a == 951782400000;
    expect b == 13574563200000;
}

