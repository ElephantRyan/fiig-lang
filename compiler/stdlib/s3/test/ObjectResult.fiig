use fiig.http

test a200IsTheObjectWithItsInfo {
    reply = http.Reply(
        status: 200,
        headers: [
            http.Header(name: "Content-Type", value: "text/plain"),
            http.Header(name: "ETag", value: "\"e\""),
            http.Header(name: "x-amz-meta-run", value: "7"),
        ],
        body: "hello".utf8(),
    );
    expect objectResult(reply) is Ok(object);
    expect object.body == "hello".utf8();
    expect object.info == ObjectInfo(size: 5, contentType: "text/plain", etag: "\"e\"", metadata: ["run": "7"]);
}

test aMissingKeyHasNoObject {
    expect objectResult(http.Reply(status: 404, headers: [], body: <<>>)) is Err(S3Error.NotFound);
}
