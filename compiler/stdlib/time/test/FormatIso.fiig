test formatIsoRefusesAMomentBeforeYearZero {
    expect formatIso(-62167219200001) is Err(TimeError.OutOfRange(reason))
}

test formatIsoRefusesAMomentAfterYear9999 {
    expect formatIso(253402300800000) is Err(TimeError.OutOfRange(reason))
}
