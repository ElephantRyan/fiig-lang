// Accounts keep their key as given, because fiig has no hash functions yet
// (ADR 0069 §4). A real service stores a hash of it.
gateway createAccountsSchema() -> int
    requires Database
{
    Database.execute(
        "CREATE TABLE IF NOT EXISTS accounts (name TEXT PRIMARY KEY, email TEXT NOT NULL, key TEXT NOT NULL)",
    )
    return Database.execute(
        "CREATE TABLE IF NOT EXISTS sessions (token TEXT PRIMARY KEY, name TEXT NOT NULL REFERENCES accounts (name))",
    )
}
