// ADR 0113 §5: records as one v2 record batch (magic 2), the format every
// broker since 0.11 stores. Its CRC is CRC-32C over everything after the
// CRC field (§2). There is no producer id, epoch, or sequence (-1 each),
// since the producer isn't idempotent (§1), and every record's timestamp
// is the batch's own.
conversion recordBatch(records: List<KafkaRecord>, timestamp: int, compression: Compression) -> Result<bytes, KafkaError> {
    if records.length() == 0 {
        return Err(KafkaError.InvalidRecord(reason: "a batch has at least one record"))
    }
    body: bytes = <<>>
    i: int = 0
    for record in records {
        body = <<body: bytes, encodedRecord(record, i): bytes>>
        i = i + 1
    }
    attributes = codecBits(compression)?
    afterCrc = <<
        attributes: i16be,
        records.length() - 1: i32be,
        timestamp: i64be,
        timestamp: i64be,
        0 - 1: i64be,
        0 - 1: i16be,
        0 - 1: i32be,
        records.length(): i32be,
        body: bytes,
    >>
    crc = crypto.crc32c(afterCrc)
    // batchLength counts from the leader epoch on: 4 + 1 + 4 bytes, then
    // what the CRC covers.
    return Ok(
        <<0: i64be, afterCrc.length() + 9: i32be, 0 - 1: i32be, 2: u8, crc: u32be, afterCrc: bytes>>,
    )
}

private {
    // Bits 0-2 of the attributes. Only None is sent yet (§5).
    codecBits(compression: Compression) -> Result<int, KafkaError> {
        match compression {
            Compression.None -> {
                return Ok(0)
            }
            _ -> {
                return Err(
                    KafkaError.InvalidRecord(reason: "fiig.kafka sends uncompressed batches only so far (ADR 0113 §5)"),
                )
            }
        }
    }

    // One record: its length as a varint, then attributes (none), its
    // timestamp and offset as deltas from the batch's, its key (-1 for
    // none), its value, and its headers.
    encodedRecord(record: KafkaRecord, offsetDelta: int) -> bytes {
        key: bytes = varint(0 - 1)
        match record.key {
            None -> None
            given -> {
                key = <<varint(given.length()): bytes, given: bytes>>
            }
        }
        headers: bytes = varint(0)
        match record.headers {
            None -> None
            list -> {
                headers = varint(list.length())
                for header in list {
                    name = header.name.utf8()
                    headers = <<
                        headers: bytes,
                        varint(name.length()): bytes,
                        name: bytes,
                        varint(header.value.length()): bytes,
                        header.value: bytes,
                    >>
                }
            }
        }
        inner = <<
            0: u8,
            varint(0): bytes,
            varint(offsetDelta): bytes,
            key: bytes,
            varint(record.value.length()): bytes,
            record.value: bytes,
            headers: bytes,
        >>
        return <<varint(inner.length()): bytes, inner: bytes>>
    }
}
