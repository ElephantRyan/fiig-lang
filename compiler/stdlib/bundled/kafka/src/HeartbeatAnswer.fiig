// What a ConsumerGroupHeartbeat v1 response said: its error, the member's
// epoch, how long until the next heartbeat, and, when assigned is true,
// the partitions of topicId the member now owns.
model HeartbeatAnswer {
    code: int;
    message: string;
    epoch: int;
    intervalMillis: int;
    assigned: bool;
    topicId: bytes;
    partitions: List<int>;
}
