use fiig.stream;
use com.degeneratedevelopment.kafka.cluster;
use com.degeneratedevelopment.kafka.codec;
use com.degeneratedevelopment.kafka.dialogue;

// A consumer group (KIP-848): finding the coordinator, heartbeats with
// their assignments, and committing and fetching offsets (ADR 0117).
formulas consumerGroup {
    // ADR 0117 §3: FindCoordinator v1 (API key 10) for a consumer group (key
    // type 0): which broker coordinates it. Any broker answers.
    formula findCoordinatorRequest(clientId: string, correlation: int, group: string) -> bytes {
        return codec.kafkaRequest(
            10,
            1,
            correlation,
            clientId,
            <<codec.kafkaString(group): bytes, 0: u8>>
        );
    }

    // A FindCoordinator v1 response as the coordinating broker, or why there
    // is none yet.
    formula readCoordinator(frame: bytes) -> Result<BrokerNode, string> {
        return match (frame) {
            <<_: i32be, _: i32be, code: i16be, rest: bytes>> -> {
                if (code != 0) {
                    return Err("FindCoordinator: ${codec.errorName(code)}");
                }

                // After the error message, the node's id, host, and port.
                message = coordinatorText(codec.stringAt(rest, 0))?;
                id = coordinatorNumber(codec.i32At(rest, message.next))?;
                host = coordinatorText(codec.stringAt(rest, message.next + 4))?;
                port = coordinatorNumber(codec.i32At(rest, host.next))?;
                return Ok(BrokerNode(id: id, host: host.text, port: port));
            },

            _ -> Err(coordinatorEndsEarly())
        }
    }

    // ADR 0117 §1, §3: KIP-848's ConsumerGroupHeartbeat v1 (API key 68): the
    // member's own id and its epoch, the one topic it subscribes to, and the
    // partitions of it the member owns now. Epoch 0 joins the group, and -1
    // leaves it. No instance id, rack, regex, or server assignor.
    formula heartbeatRequest(
        clientId: string,
        correlation: int,
        group: string,
        memberId: string,
        epoch: int,
        topic: string,
        topicId: bytes,
        owned: List<int>)
            -> bytes {
        // TopicPartitions: none yet, or the topic's owned partitions.
        partitions: bytes = codec.uvarint(1);
        if (topicId.length() == 16 && owned.length() > 0) {
            ids: bytes = codec.uvarint(owned.length() + 1);
            for (p in owned) {
                ids = <<ids: bytes, p: i32be>>;
            }

            partitions = <<codec.uvarint(2): bytes, topicId: bytes, ids: bytes, 0: u8>>;
        }

        body = <<
            codec.compactString(group): bytes,
            codec.compactString(memberId): bytes,
            epoch: i32be,
            0: u8,
            0: u8,
            60000: i32be,
            codec.uvarint(2): bytes,
            codec.compactString(topic): bytes,
            0: u8,
            0: u8,
            partitions: bytes,
            0: u8
        >>;
        return codec.kafkaFlexRequest(68, 1, correlation, clientId, body);
    }

    // A ConsumerGroupHeartbeat v1 response: response header v1 (the
    // correlation id, then tagged fields), the throttle time, the error and
    // its message, the member's id and epoch, the heartbeat interval, and the
    // assignment, a nullable struct (-1 for none) of compact arrays.
    formula readHeartbeat(frame: bytes) -> Result<HeartbeatAnswer, string> {
        afterHeader = heartbeatNumber(codec.afterTags(frame, 4))?;
        code = heartbeatNumber(codec.i16At(frame, afterHeader + 4))?;
        message = heartbeatText(codec.compactStringAt(frame, afterHeader + 6))?;
        member = heartbeatText(codec.compactStringAt(frame, message.next))?;
        epoch = heartbeatNumber(codec.i32At(frame, member.next))?;
        interval = heartbeatNumber(codec.i32At(frame, member.next + 4))?;
        pos = member.next + 8;
        if (pos >= frame.length()) {
            return Err(heartbeatEndsEarly());
        }

        if (frame.at(pos) == 255) {
            return Ok(
                HeartbeatAnswer(
                    code: code,
                    message: message.text,
                    epoch: epoch,
                    intervalMillis: interval,
                    assigned: false,
                    topicId: <<>>,
                    partitions: []
                )
            );
        }

        topics = countOf(codec.uvarintAt(frame, pos + 1))?;
        at: int = topics.next;
        topicId: bytes = <<>>;
        partitions: List<int> = [];
        t: int = 0;
        while (t < topics.value) {
            if (at + 16 > frame.length()) {
                return Err(heartbeatEndsEarly());
            }

            topicId = frame.slice(at, at + 16);
            ids = countOf(codec.uvarintAt(frame, at + 16))?;
            at = ids.next;
            i: int = 0;
            while (i < ids.value) {
                partitions = append(partitions, heartbeatNumber(codec.i32At(frame, at))?);
                at = at + 4;
                i = i + 1;
            }

            at = heartbeatNumber(codec.afterTags(frame, at))?;
            t = t + 1;
        }

        return Ok(
            HeartbeatAnswer(
                code: code,
                message: message.text,
                epoch: epoch,
                intervalMillis: interval,
                assigned: true,
                topicId: topicId,
                partitions: partitions
            )
        );
    }

    // ADR 0117 §3: OffsetFetch v1 (API key 9): the group's committed offsets
    // for partitions of topic.
    formula offsetFetchRequest(
        clientId: string,
        correlation: int,
        group: string,
        topic: string,
        partitions: List<int>)
            -> bytes {
        ids: bytes = <<partitions.length(): i32be>>;
        for (p in partitions) {
            ids = <<ids: bytes, p: i32be>>;
        }

        body = <<
            codec.kafkaString(group): bytes,
            1: i32be,
            codec.kafkaString(topic): bytes,
            ids: bytes
        >>;
        return codec.kafkaRequest(9, 1, correlation, clientId, body);
    }

    // An OffsetFetch v1 response: each partition's committed offset, -1 when
    // the group has committed none for it.
    formula readOffsetFetch(frame: bytes) -> Result<List<PartitionOffset>, string> {
        topics = offsetFetchNumber(codec.i32At(frame, 4))?;
        pos: int = 8;
        out: List<PartitionOffset> = [];
        t: int = 0;
        while (t < topics) {
            name = offsetFetchText(codec.stringAt(frame, pos))?;
            count = offsetFetchNumber(codec.i32At(frame, name.next))?;
            pos = name.next + 4;
            i: int = 0;
            while (i < count) {
                partition = offsetFetchNumber(codec.i32At(frame, pos))?;
                offset = offsetFetchNumber(codec.i64At(frame, pos + 4))?;
                metadata = offsetFetchText(codec.stringAt(frame, pos + 12))?;
                code = offsetFetchNumber(codec.i16At(frame, metadata.next))?;
                if (code != 0) {
                    return Err("OffsetFetch for partition ${partition}: ${codec.errorName(code)}");
                }

                out = append(out, PartitionOffset(partition: partition, offset: offset));
                pos = metadata.next + 2;
                i = i + 1;
            }

            t = t + 1;
        }

        return Ok(out);
    }

    // ADR 0117 §5: turn with an OffsetCommit of every partition acked past
    // what was last committed, at the member's epoch now. A commit that fails
    // is not sent again: its records are delivered again, at least once.
    formula commitAll(turn: SessionTurn) -> SessionTurn {
        s = turn.state;
        offsets: List<PartitionOffset> = [];
        partitions: List<OwnedPartition> = [];
        for (p in s.partitions) {
            if (p.acked > p.committed) {
                offsets = append(offsets, PartitionOffset(partition: p.partition, offset: p.acked));
                partitions = append(partitions, copy(p, committed: p.acked));
            } else {
                partitions = append(partitions, p);
            }
        }

        if (offsets.length() == 0) {
            return copy(turn, state: copy(s, commitAt: 0));
        }

        request = offsetCommitRequest(
            s.clientId,
            s.nextCorrelation,
            s.group,
            s.memberId,
            s.epoch,
            s.topic,
            offsets
        );
        committed = copy(dialogue.tracked(s, "commit"), partitions: partitions, commitAt: 0);
        return copy(turn, state: committed, write: <<turn.write: bytes, request: bytes>>);
    }

    // ADR 0117 §3: the settings naming a route's group session: the first
    // bootstrap server, which moves it to the group's coordinator, and the
    // group, topic, and commit interval its protocol reads. The other
    // bootstrap servers are its "alternates", which the runtime tries in order
    // when the first can't be reached (§2, as amended 2026-11-21).
    formula groupSettings(
        subscription: stream.Subscription,
        bootstrap: string,
        tls: bool,
        clientId: string,
        commitMillis: int)
            -> Result<Map<string, string>, stream.SourceError> {
        return match (cluster.bootstrapOf(bootstrap)) {
            Err(failure) -> Err(consumerError(failure)),
            Ok(servers) -> {
                first = servers.first();
                alternates: string = "";
                seen: int = 0;
                for (server in servers) {
                    if (seen == 1) {
                        alternates = serverText(server);
                    } else if (seen > 1) {
                        alternates = "${alternates},${serverText(server)}";
                    }

                    seen = seen + 1;
                }

                return Ok(
                    ["host": first.host, "port": "${first.port}", "alternates": alternates, "tls": "${tls}", "role": "group", "clientId": clientId, "group": subscription.group, "topic": subscription.source, "commitMillis": "${commitMillis}"]
                );
            }
        }
    }

    // A KafkaError as the stream adapter takes it (ADR 0111 §1): a broker or
    // a connection that may answer later is Unavailable; a setting that can
    // never work, such as an unknown dead-letter topic, is Misconfigured and
    // halts the route; a reply this package can't read is Protocol.
    formula consumerError(failure: KafkaError) -> stream.SourceError {
        return match (failure) {
            KafkaError.Session(cause) -> stream.SourceError.Unavailable(reason: "${cause}"),
            KafkaError.Broker(_, name, retriable, message) -> {
                if (retriable) {
                    return stream.SourceError.Unavailable(reason: message);
                }

                return stream.SourceError.Protocol(reason: "${message} (${name})");
            },

            KafkaError.UnknownTopic(topic) -> stream.SourceError.Misconfigured(
                reason: "topic ${topic} doesn't exist"
            ),
            KafkaError.Unsupported(reason) -> stream.SourceError.Misconfigured(reason: reason),
            KafkaError.InvalidConfig(reason) -> stream.SourceError.Misconfigured(reason: reason),
            KafkaError.Authentication(reason) -> stream.SourceError.Misconfigured(reason: reason),
            KafkaError.MalformedReply(reason) -> stream.SourceError.Protocol(reason: reason),
            KafkaError.InvalidRecord(reason) -> stream.SourceError.Protocol(reason: reason),
            KafkaError.Decompress(cause) -> stream.SourceError.Protocol(reason: "${cause}")
        }
    }
}

private {
    coordinatorEndsEarly() -> string {
        return "a FindCoordinator response ends early";
    }

    coordinatorText(read: TextAt | None) -> Result<TextAt, string> {
        return match (read) {
            None -> Err(coordinatorEndsEarly()),
            found -> Ok(found)
        }
    }

    coordinatorNumber(read: int | None) -> Result<int, string> {
        return match (read) {
            None -> Err(coordinatorEndsEarly()),
            found -> Ok(found)
        }
    }

    heartbeatEndsEarly() -> string {
        return "a ConsumerGroupHeartbeat response ends early";
    }

    heartbeatNumber(read: int | None) -> Result<int, string> {
        return match (read) {
            None -> Err(heartbeatEndsEarly()),
            found -> Ok(found)
        }
    }

    heartbeatText(read: TextAt | None) -> Result<TextAt, string> {
        return match (read) {
            None -> Err(heartbeatEndsEarly()),
            found -> Ok(found)
        }
    }

    // A compact array's length, from its length plus one.
    countOf(read: IntAt | None) -> Result<IntAt, string> {
        return match (read) {
            None -> Err(heartbeatEndsEarly()),
            found -> {
                if (found.value == 0) {
                    return Ok(IntAt(value: 0, next: found.next));
                }

                return Ok(IntAt(value: found.value - 1, next: found.next));
            }
        }
    }

    // ADR 0117 §5: OffsetCommit v9 (API key 8), the first a KIP-848 member
    // may send: the member's id and epoch, and the next offset to read in
    // each partition of topic.
    offsetCommitRequest(
        clientId: string,
        correlation: int,
        group: string,
        memberId: string,
        epoch: int,
        topic: string,
        offsets: List<PartitionOffset>)
            -> bytes {
        partitions: bytes = codec.uvarint(offsets.length() + 1);
        for (o in offsets) {
            partitions = <<
                partitions: bytes,
                o.partition: i32be,
                o.offset: i64be,
                0 - 1: i32be,
                0: u8,
                0: u8
            >>;
        }

        body = <<
            codec.compactString(group): bytes,
            epoch: i32be,
            codec.compactString(memberId): bytes,
            0: u8,
            codec.uvarint(2): bytes,
            codec.compactString(topic): bytes,
            partitions: bytes,
            0: u8,
            0: u8
        >>;
        return codec.kafkaFlexRequest(8, 9, correlation, clientId, body);
    }

    offsetFetchEndsEarly() -> string {
        return "an OffsetFetch response ends early";
    }

    offsetFetchNumber(read: int | None) -> Result<int, string> {
        return match (read) {
            None -> Err(offsetFetchEndsEarly()),
            found -> Ok(found)
        }
    }

    offsetFetchText(read: TextAt | None) -> Result<TextAt, string> {
        return match (read) {
            None -> Err(offsetFetchEndsEarly()),
            found -> Ok(found)
        }
    }

    // A server as an alternate names it: host:port, an IPv6 host in
    // brackets as bootstrapOf reads it.
    serverText(server: BrokerNode) -> string {
        if (server.host.contains(":")) {
            return "[${server.host}]:${server.port}";
        }

        return "${server.host}:${server.port}";
    }
}
