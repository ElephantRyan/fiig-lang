// ADR 0146 §4 check 7: iss is the issuer, aud (a string or a list, RFC
// 7519 §4.1.3) holds the audience, exp is required and not past, and nbf
// and iat aren't in the future, each with the leeway.
conversion claimsChecked(parts: TokenParts, expect: Expect, now: int)
        -> Result<Verified, JwtError> {
    claims = parts.payload;
    leeway = (expect.leewaySeconds ?? 60) * 1000;
    issuer = match (textMember(claims, "iss")) {
        None -> {
            return Err(JwtError.MissingClaim(name: "iss"));
        },

        given -> given
    }

    if (issuer != expect.issuer) {
        return Err(JwtError.WrongIssuer(found: issuer));
    }

    audience = audienceOf(claims)?;
    if (!audience.contains(expect.audience)) {
        return Err(JwtError.WrongAudience(found: audience));
    }

    expiresAt = match (dateMember(claims, "exp")?) {
        None -> {
            return Err(JwtError.MissingClaim(name: "exp"));
        },

        given -> given
    }

    if (now >= expiresAt + leeway) {
        return Err(JwtError.Expired(at: expiresAt));
    }

    match (dateMember(claims, "nbf")?) {
        None -> None,
        notBefore -> {
            if (now + leeway < notBefore) {
                return Err(JwtError.NotYetValid(at: notBefore));
            }
        }
    }

    issuedAt = dateMember(claims, "iat")?;
    match (issuedAt) {
        None -> None,
        at -> {
            if (now + leeway < at) {
                return Err(JwtError.NotYetValid(at: at));
            }
        }
    }

    return Ok(
        Verified(
            issuer: issuer,
            subject: textMember(claims, "sub"),
            audience: audience,
            expiresAt: expiresAt,
            issuedAt: issuedAt,
            id: textMember(claims, "jti"),
            keyId: parts.keyId,
            claims: JsonValue.Object(members: claims)
        )
    );
}

private {
    audienceOf(claims: Map<string, JsonValue>) -> Result<List<string>, JwtError> {
        return match (claims.atOrNone("aud")) {
            None -> Err(JwtError.MissingClaim(name: "aud")),
            JsonValue.Text(one) -> Ok([one]),
            JsonValue.Array(items) -> textsOf(items),
            _ -> Err(JwtError.Malformed(reason: "the aud claim isn't a string or a list of them"))
        }
    }

    textsOf(items: List<JsonValue>) -> Result<List<string>, JwtError> {
        texts: List<string> = [];
        for (item in items) {
            match (item) {
                JsonValue.Text(value) -> {
                    texts = append(texts, value);
                },

                _ -> {
                    return Err(
                        JwtError.Malformed(
                            reason: "the aud claim isn't a string or a list of them"
                        )
                    );
                }
            }
        }

        return Ok(texts);
    }
}
