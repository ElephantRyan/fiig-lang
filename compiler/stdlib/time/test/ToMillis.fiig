test toMillisat1970_1_1_0_0_0 {
    expect toMillis(DateTime(year: 1970, month: 1, day: 1, hour: 0, minute: 0, second: 0, millisecond: 0)) is Ok(ms)
    expect ms == 0
}

test toMillisat1969_12_31_23_59_59_999 {
    expect toMillis(DateTime(year: 1969, month: 12, day: 31, hour: 23, minute: 59, second: 59, millisecond: 999)) is Ok(ms)
    expect ms == -1
}

test toMillisat1969_12_31_0_0_0 {
    expect toMillis(DateTime(year: 1969, month: 12, day: 31, hour: 0, minute: 0, second: 0, millisecond: 0)) is Ok(ms)
    expect ms == -86400000
}

