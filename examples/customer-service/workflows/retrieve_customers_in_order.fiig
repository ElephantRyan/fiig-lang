// ADR 0024: `preserveOrder` — same shape as retrieveCustomers, but callers
// that need the BatchResult's items to line up with customerIds positionally
// (rather than by whichever getCustomer finishes first) ask for it explicitly.
workflow retrieveCustomersInOrder(customerIds: List<string>) -> BatchResult<string, Customer, CustomerError> {
    concurrent(customerId in customerIds, preserveOrder):
        getCustomer(customerId)
}
