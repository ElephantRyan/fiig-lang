// Square chooses its own HTTP library, concretely: no gateway calls a
// gateway here, charge uses the Client capability it requires, exactly as a
// gateway would use Socket (ADR 0043 §5).
// Its access token is its own config (ADR 0071 §5).
use acme.http;
use acme.http.Client;
use acme.payments;

capability Square provides payments.PaymentProvider {
    gateway charge(request: payments.ChargeRequest) -> Result<string, string> requires Client {
        outbound = http.WebRequest(
            host: "connect.squareup.com",
            path: "/v2/payments",
            body: "${request.orderId}:${request.amount}",
            authorization: "Bearer ${SquareAccount.accessToken.reveal()}"
        );
        reply = Client.send(outbound);
        return match (reply) {
            Ok(sent) -> {
                if (sent.status != 200) {
                    return Err("HTTP ${sent.status} from connect.squareup.com");
                }

                return Ok("square:${sent.body}");
            },

            Err(failure) -> Err(http.describeSocketError(failure))
        }
    }
}
