// ADR 0110: a Redis client written in fiig over Socket. A command goes out
// on a connection kept by an earlier one with the same server, user, and
// database (ADR 0109), or on a new one set up with AUTH and SELECT first:
// the setup is sent and its replies read before the command is written,
// so a refused SELECT never lets the command run on database 0 (§3).
capability Redis {
    gateway send(args: List<string>) -> Result<RespValue, RedisError>
        requires Socket
    {
        if args.length() == 0 {
            return Err(RedisError.InvalidCommand(reason: "a command has at least its name"))
        }
        words: List<bytes> = []
        for word in args {
            words = append(words, word.utf8())
        }
        target = parseRedisUrl(RedisServer.url.reveal())?
        until: int = Clock.now() + RedisServer.timeoutMillis
        session = sessionOf(target)
        reused: Connection | None = Socket.reuse(
            target.host,
            target.port,
            tls: target.secure,
            session: session,
        )
        phases: List<RedisRequest> = []
        opened: Result<Connection, SocketError> = Err(SocketError.Closed)
        match reused {
            None -> {
                setup = setupRequest(target)
                if setup.replies > 0 {
                    phases = [setup]
                }
                if target.secure {
                    opened = Socket.connectTls(target.host, target.port, deadline: until)
                } else {
                    opened = Socket.connect(target.host, target.port, deadline: until)
                }
            }
            kept -> {
                opened = Ok(kept)
            }
        }
        phases = append(phases, commandRequest(words))
        connection = mapErr(e in opened): RedisError.Socket(failure: e)?
        buffer: bytes = <<>>
        replies: List<RespValue> = []
        phase: int = 0
        while phase < phases.length() {
            request = phases.at(phase)
            match Socket.write(connection, request.data, deadline: until) {
                Err(failure) -> {
                    Socket.close(connection)
                    return Err(RedisError.Socket(failure: failure))
                }
                Ok(_) -> None
            }
            replies = []
            while replies.length() < request.replies {
                match readResp(buffer) {
                    RespRead.Done(value, rest) -> {
                        replies = append(replies, value)
                        buffer = rest
                    }
                    RespRead.Malformed(reason) -> {
                        Socket.close(connection)
                        return Err(RedisError.MalformedReply(reason: reason))
                    }
                    RespRead.NeedMore -> {
                        match Socket.read(connection, deadline: until) {
                            Ok(chunk) -> {
                                buffer = <<buffer: bytes, chunk: bytes>>
                            }
                            Err(failure) -> {
                                Socket.close(connection)
                                return Err(RedisError.Socket(failure: failure))
                            }
                        }
                    }
                }
            }
            if phase + 1 < phases.length() {
                match setupRefusal(replies) {
                    None -> None
                    refused -> {
                        Socket.close(connection)
                        return Err(refused)
                    }
                }
            }
            phase = phase + 1
        }
        if buffer.length() == 0 and keepsConnection(args.first()) {
            Socket.keep(connection, session: session)
        } else {
            Socket.close(connection)
        }
        return commandReply(replies.first())
    }

    // send, with each argument as bytes: Redis strings are binary-safe, so
    // a value that isn't UTF-8, such as a stream payload being moved to a
    // dead-letter stream, goes as it is (ADR 0110 §1a). The body is send's,
    // since a gateway can't call another.
    gateway sendBytes(args: List<bytes>) -> Result<RespValue, RedisError>
        requires Socket
    {
        if args.length() == 0 {
            return Err(RedisError.InvalidCommand(reason: "a command has at least its name"))
        }
        name: string = ""
        match args.first().utf8() {
            None -> None
            text -> {
                name = text
            }
        }
        target = parseRedisUrl(RedisServer.url.reveal())?
        until: int = Clock.now() + RedisServer.timeoutMillis
        session = sessionOf(target)
        reused: Connection | None = Socket.reuse(
            target.host,
            target.port,
            tls: target.secure,
            session: session,
        )
        phases: List<RedisRequest> = []
        opened: Result<Connection, SocketError> = Err(SocketError.Closed)
        match reused {
            None -> {
                setup = setupRequest(target)
                if setup.replies > 0 {
                    phases = [setup]
                }
                if target.secure {
                    opened = Socket.connectTls(target.host, target.port, deadline: until)
                } else {
                    opened = Socket.connect(target.host, target.port, deadline: until)
                }
            }
            kept -> {
                opened = Ok(kept)
            }
        }
        phases = append(phases, commandRequest(args))
        connection = mapErr(e in opened): RedisError.Socket(failure: e)?
        buffer: bytes = <<>>
        replies: List<RespValue> = []
        phase: int = 0
        while phase < phases.length() {
            request = phases.at(phase)
            match Socket.write(connection, request.data, deadline: until) {
                Err(failure) -> {
                    Socket.close(connection)
                    return Err(RedisError.Socket(failure: failure))
                }
                Ok(_) -> None
            }
            replies = []
            while replies.length() < request.replies {
                match readResp(buffer) {
                    RespRead.Done(value, rest) -> {
                        replies = append(replies, value)
                        buffer = rest
                    }
                    RespRead.Malformed(reason) -> {
                        Socket.close(connection)
                        return Err(RedisError.MalformedReply(reason: reason))
                    }
                    RespRead.NeedMore -> {
                        match Socket.read(connection, deadline: until) {
                            Ok(chunk) -> {
                                buffer = <<buffer: bytes, chunk: bytes>>
                            }
                            Err(failure) -> {
                                Socket.close(connection)
                                return Err(RedisError.Socket(failure: failure))
                            }
                        }
                    }
                }
            }
            if phase + 1 < phases.length() {
                match setupRefusal(replies) {
                    None -> None
                    refused -> {
                        Socket.close(connection)
                        return Err(refused)
                    }
                }
            }
            phase = phase + 1
        }
        // A name that isn't text is no command Redis has, so the
        // connection isn't trusted further.
        if buffer.length() == 0 and name != "" and keepsConnection(name) {
            Socket.keep(connection, session: session)
        } else {
            Socket.close(connection)
        }
        return commandReply(replies.first())
    }
}
