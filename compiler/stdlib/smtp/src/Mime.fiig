// A mail as RFC 5322 and MIME write it: checking it can be sent, its
// recipients, its Message-ID, and the DATA that carries it (ADR 0122).
formulas mime {
    // A mail that can be sent as written (ADR 0120 §2, §2a). Addresses go into
    // protocol lines and headers, so a line break or a space in one could write
    // a command or a header of the caller's choosing; they're refused instead,
    // and so is a display name with a line break, and an attachment whose name
    // or type could end a header (§2b). The reasons say which address or
    // attachment, never what it said.
    formula checkMail(mail: Mail) -> Result<None, SmtpError> {
        if (!validAddress(mail.from)) {
            return Err(
                SmtpError.InvalidMail(
                    reason: "the sender isn't an address: one @, no spaces, no quotes, angle brackets, or non-ASCII"
                )
            );
        }

        cc = listOf(mail.cc);
        bcc = listOf(mail.bcc);
        count = mail.to.length() + cc.length() + bcc.length();
        if (count == 0) {
            return Err(
                SmtpError.InvalidMail(
                    reason: "a mail has at least one recipient, in to, cc, or bcc"
                )
            );
        }

        if (count > 100) {
            return Err(
                SmtpError.InvalidMail(
                    reason: "a mail has at most 100 recipients, to, cc, and bcc together"
                )
            );
        }

        checkList(mail.to, "recipient")?;
        checkList(cc, "cc recipient")?;
        checkList(bcc, "bcc recipient")?;
        // Every address the mail has, which are the ones a display name may be
        // given for (a Bcc recipient's is allowed, and never written).
        known: List<string> = append(recipientsOf(mail), mail.from);
        match (mail.replyTo) {
            None -> None,
            address -> {
                if (!validAddress(address)) {
                    return Err(
                        SmtpError.InvalidMail(
                            reason: "the reply-to address isn't an address: one @, no spaces, no quotes, angle brackets, or non-ASCII"
                        )
                    );
                }

                known = append(known, address);
            }
        }

        match (mail.names) {
            None -> None,
            names -> {
                for (address in names.keys()) {
                    if (!known.contains(address)) {
                        return Err(
                            SmtpError.InvalidMail(
                                reason: "a display name is given for an address the mail doesn't have"
                            )
                        );
                    }

                    checkName(names.at(address))?;
                }
            }
        }

        if (mail.subject.contains("\r") || mail.subject.contains("\n")) {
            return Err(SmtpError.InvalidMail(reason: "the subject has a line break"));
        }

        if (mail.subject.utf8().length() > 900) {
            return Err(SmtpError.InvalidMail(reason: "the subject is longer than 900 bytes"));
        }

        match (mail.attachments) {
            None -> None,
            attachments -> {
                number: int = 1;
                for (attachment in attachments) {
                    checkAttachment(attachment, number)?;
                    number = number + 1;
                }
            }
        }

        return Ok(None);
    }

    // The bytes after DATA (RFC 5321 §4.5.2): the headers, a blank line, the
    // body, and a line holding only a dot. Lines end in CRLF and a body line that
    // starts with a dot gets another (so the end marker is unmistakable). A body
    // of plain ASCII goes as it is (7bit); anything else, and any line over the
    // 998 bytes SMTP allows, goes as base64 (ADR 0120 §2). A subject that isn't
    // plain ASCII is written as RFC 2047 encoded words, and so is a display name;
    // Bcc is never written (§2a). A mail with HTML or attachments is multipart
    // (§2b), its boundaries made from the Message-ID's random token.
    formula mailData(mail: Mail, date: string, messageId: string) -> bytes {
        names: Map<string, string> = [:];
        match (mail.names) {
            None -> None,
            given -> {
                names = given;
            }
        }

        headers: List<string> = [addressHeader("From", [mail.from], names)];
        if (mail.to.length() > 0) {
            headers = append(headers, addressHeader("To", mail.to, names));
        }

        match (mail.cc) {
            None -> None,
            cc -> {
                if (cc.length() > 0) {
                    headers = append(headers, addressHeader("Cc", cc, names));
                }
            }
        }

        match (mail.replyTo) {
            None -> None,
            address -> {
                headers = append(headers, addressHeader("Reply-To", [address], names));
            }
        }

        headers = append(headers, "Subject: ${subjectHeader(mail.subject)}");
        headers = append(headers, "Date: ${date}");
        headers = append(headers, "Message-ID: <${messageId}>");
        headers = append(headers, "MIME-Version: 1.0");
        head = headers.join("\r\n");
        text = "${head}\r\n${entityOf(mail, messageId)}.\r\n";
        return text.utf8();
    }

    // A Message-ID's inside, unique by its random token and scoped to the
    // sender's domain (RFC 5322 §3.6.4): token@domain.
    formula messageIdFor(mail: Mail, token: string) -> string {
        domain = mail.from.split("@").last();
        return "${token}@${domain}";
    }

    // Everyone a mail is sent to, a RCPT TO each (ADR 0120 §2a): to, then cc,
    // then bcc, each address once however many lists it is in.
    formula recipientsOf(mail: Mail) -> List<string> {
        all: List<string> = [];
        for (address in mail.to) {
            if (!all.contains(address)) {
                all = append(all, address);
            }
        }

        for (address in listOf(mail.cc)) {
            if (!all.contains(address)) {
                all = append(all, address);
            }
        }

        for (address in listOf(mail.bcc)) {
            if (!all.contains(address)) {
                all = append(all, address);
            }
        }

        return all;
    }
}

private {
    // An attachment's name and type go into its part's headers (§2b): a name
    // is any text but a control character, of at most 200 bytes, and a type
    // is type/subtype in MIME's token characters, with no parameters, so
    // neither can end a header line or add one.
    checkAttachment(attachment: Attachment, number: int) -> Result<None, SmtpError> {
        raw = attachment.name.utf8();
        if (raw.length() == 0 || raw.length() > 200) {
            return Err(
                SmtpError.InvalidMail(
                    reason: "attachment ${number}'s name is empty or longer than 200 bytes"
                )
            );
        }

        for (b in raw) {
            if (b < 32 || b == 127) {
                return Err(
                    SmtpError.InvalidMail(
                        reason: "attachment ${number}'s name has a line break or another control character"
                    )
                );
            }
        }

        halves = attachment.contentType.split("/");
        if (halves.length() != 2 || !mimeToken(halves.first()) || !mimeToken(halves.last())) {
            return Err(
                SmtpError.InvalidMail(
                    reason: "attachment ${number}'s content type isn't type/subtype, such as application/pdf"
                )
            );
        }

        return Ok(None);
    }

    // RFC 2045 §5.1's token: printable ASCII but space and ( ) < > @ , ; : \ " / [ ] ? =.
    mimeToken(text: string) -> bool {
        raw = text.utf8();
        if (raw.length() == 0 || raw.length() > 127) {
            return false;
        }

        for (b in raw) {
            if (b <= 32 || b >= 127) {
                return false;
            }

            if (b == 34 || b == 40 || b == 41 || b == 44 || b == 47 || b == 58 || b == 59 || b == 60 || b == 61 || b == 62 || b == 63 || b == 64 || b == 91 || b == 92 || b == 93) {
                return false;
            }
        }

        return true;
    }

    listOf(addresses: List<string> | None) -> List<string> {
        return match (addresses) {
            None -> [],
            given -> given
        }
    }

    // Each address in a list, named by its kind and its position from 1.
    checkList(addresses: List<string>, kind: string) -> Result<None, SmtpError> {
        number: int = 1;
        for (address in addresses) {
            if (!validAddress(address)) {
                return Err(
                    SmtpError.InvalidMail(
                        reason: "${kind} ${number} isn't an address: one @, no spaces, no quotes, angle brackets, or non-ASCII"
                    )
                );
            }

            number = number + 1;
        }

        return Ok(None);
    }

    // A display name is any text but a control character, a line break
    // among them; MailData quotes or encodes the rest.
    checkName(name: string) -> Result<None, SmtpError> {
        raw = name.utf8();
        if (raw.length() > 200) {
            return Err(SmtpError.InvalidMail(reason: "a display name is longer than 200 bytes"));
        }

        for (b in raw) {
            if (b < 32 || b == 127) {
                return Err(
                    SmtpError.InvalidMail(
                        reason: "a display name has a line break or another control character"
                    )
                );
            }
        }

        return Ok(None);
    }

    // local@domain in plain ASCII: exactly one @ with something on each
    // side, and none of the characters that end or quote an address.
    validAddress(text: string) -> bool {
        raw = text.utf8();
        if (raw.length() < 3 || raw.length() > 254) {
            return false;
        }

        ats: int = 0;
        at: int = -1;
        i: int = 0;
        while (i < raw.length()) {
            b = raw.at(i);
            if (b <= 32 || b >= 127) {
                return false;
            }

            if (b == 34 || b == 40 || b == 41 || b == 44 || b == 58 || b == 59 || b == 60 || b == 62 || b == 91 || b == 92 || b == 93) {
                return false;
            }

            if (b == 64) {
                ats = ats + 1;
                at = i;
            }

            i = i + 1;
        }

        return ats == 1 && at > 0 && at < raw.length() - 1;
    }

    // The body as MIME writes it: its Content-Type and encoding header
    // lines, a blank line, and the content, every line ending in CRLF. Plain
    // text alone is one text/plain part; HTML makes it multipart/alternative,
    // text first and HTML second (RFC 2046 §5.1.4, the reader shows the last
    // it can); attachments wrap that in multipart/mixed, the body first. The
    // two boundaries are the Message-ID's token, neither a prefix of the
    // other, and a text part that holds either goes as base64, which can't
    // hold `=_`.
    entityOf(mail: Mail, messageId: string) -> string {
        html: string = "";
        hasHtml: bool = false;
        match (mail.html) {
            None -> None,
            given -> {
                html = given;
                hasHtml = true;
            }
        }

        attachments: List<Attachment> = [];
        match (mail.attachments) {
            None -> None,
            given -> {
                attachments = given;
            }
        }

        if (!hasHtml && attachments.length() == 0) {
            return textEntity(mail.body, "plain", []);
        }

        token = messageId.split("@").first();
        mixed = "=_m.${token}";
        alternative = "=_a.${token}";
        avoid = [mixed, alternative];
        body: string = textEntity(mail.body, "plain", avoid);
        if (hasHtml) {
            body = multipart("alternative", alternative, [body, textEntity(html, "html", avoid)]);
        }

        if (attachments.length() == 0) {
            return body;
        }

        parts: List<string> = [body];
        for (attachment in attachments) {
            parts = append(parts, attachmentEntity(attachment));
        }

        return multipart("mixed", mixed, parts);
    }

    // A text part: 7bit when it can go so, base64 when it can't or when it
    // holds a boundary.
    textEntity(text: string, subtype: string, boundaries: List<string>) -> string {
        plain = text.replaceAll("\r\n", "\n").replaceAll("\r", "\n");
        rows: List<string> = plain.split("\n");
        if (rows.length() > 1 && rows.last() == "") {
            rows = rows.slice(0, rows.length() - 1);
        }

        encoded: bool = needsBase64(plain, rows);
        for (boundary in boundaries) {
            if (plain.contains(boundary)) {
                encoded = true;
            }
        }

        encoding: string = "7bit";
        body: string = plainLines(rows);
        if (encoded) {
            encoding = "base64";
            body = base64Lines(rows);
        }

        return "Content-Type: text/${subtype}; charset=utf-8\r\nContent-Transfer-Encoding: ${encoding}\r\n\r\n${body}";
    }

    // Parts between boundary lines, each part ending in CRLF so the next
    // line starts with the boundary (RFC 2046 §5.1.1).
    multipart(kind: string, boundary: string, parts: List<string>) -> string {
        out: string = "Content-Type: multipart/${kind};\r\n boundary=\"${boundary}\"\r\n\r\n";
        for (part in parts) {
            out = "${out}--${boundary}\r\n${part}";
        }

        return "${out}--${boundary}--\r\n";
    }

    // A file as an attachment, in base64. Its name goes twice, as mail
    // readers look for it in either place: a name of printable ASCII quoted
    // in both; any other as RFC 2231's filename*= in Content-Disposition, and
    // as RFC 2047 encoded words in Content-Type's name, which is what older
    // readers (Outlook among them) understand.
    attachmentEntity(attachment: Attachment) -> string {
        name = attachment.name;
        typeName: string = quotedString(name);
        fileName: string = "filename=${typeName}";
        if (!printableAscii(name)) {
            typeName = "\"${encodedWords(name)}\"";
            fileName = "filename*=utf-8''${percentEncoded(name)}";
        }

        typeLine = "Content-Type: ${attachment.contentType};\r\n name=${typeName}\r\n";
        disposition = "Content-Disposition: attachment;\r\n ${fileName}\r\n";
        return "${typeLine}${disposition}Content-Transfer-Encoding: base64\r\n\r\n${wrapped(attachment.data.toBase64())}";
    }

    printableAscii(text: string) -> bool {
        for (b in text.utf8()) {
            if (b < 32 || b > 126) {
                return false;
            }
        }

        return true;
    }

    quotedString(text: string) -> string {
        escaped = text.replaceAll("\\", "\\\\").replaceAll("\"", "\\\"");
        return "\"${escaped}\"";
    }

    // RFC 2231 §7's value: UTF-8 bytes, each but its attribute characters
    // (letters, digits, and ! # $ & + - . ^ _ ` | ~) as %XX.
    percentEncoded(text: string) -> string {
        out: string = "";
        for (b in text.utf8()) {
            if (b >= 48 && b <= 57 || b >= 65 && b <= 90 || b >= 97 && b <= 122 || b == 33 || b == 35 || b == 36 || b == 38 || b == 43 || b == 45 || b == 46 || b == 94 || b == 95 || b == 96 || b == 124 || b == 126) {
                one: bytes = <<b: u8>>;
                match (one.utf8()) {
                    None -> None,
                    c -> {
                        out = "${out}${c}";
                    }
                }
            } else {
                one: bytes = <<b: u8>>;
                out = "${out}%${one.toHex().uppercase()}";
            }
        }

        return out;
    }

    // Whether the body can't go as 7bit text: a byte outside printable ASCII
    // and the usual controls, or a line SMTP won't carry.
    needsBase64(plain: string, rows: List<string>) -> bool {
        for (b in plain.utf8()) {
            if (b >= 128 || b == 0) {
                return true;
            }
        }

        for (row in rows) {
            if (row.utf8().length() > 998) {
                return true;
            }
        }

        return false;
    }

    plainLines(rows: List<string>) -> string {
        stuffed: List<string> = [];
        for (row in rows) {
            if (row.startsWith(".")) {
                stuffed = append(stuffed, ".${row}");
            } else {
                stuffed = append(stuffed, row);
            }
        }

        joined = stuffed.join("\r\n");
        return "${joined}\r\n";
    }

    // The body as CRLF text in base64, wrapped at 76 characters.
    base64Lines(rows: List<string>) -> string {
        joined = rows.join("\r\n");
        text = "${joined}\r\n";
        return wrapped(text.utf8().toBase64());
    }

    // Base64 in lines of 76 characters (RFC 2045 §6.8), each ending in CRLF.
    // It is cut as bytes, which slice in constant time, where a string's
    // length and slice count characters from its start, so an attachment of
    // megabytes doesn't take time in the square of its size.
    wrapped(encoded: string) -> string {
        raw = encoded.utf8();
        lines: List<string> = [];
        start: int = 0;
        while (start < raw.length()) {
            stop: int = start + 76;
            if (stop > raw.length()) {
                stop = raw.length();
            }

            match (raw.slice(start, stop).utf8()) {
                None -> None,
                line -> {
                    lines = append(lines, line);
                }
            }

            start = stop;
        }

        wrapped = lines.join("\r\n");
        return "${wrapped}\r\n";
    }

    // The subject as it goes in the header: itself when it is printable
    // ASCII, else encoded words.
    subjectHeader(subject: string) -> string {
        for (b in subject.utf8()) {
            if (b < 32 || b > 126) {
                return encodedWords(subject);
            }
        }

        return subject;
    }

    // =?UTF-8?B?...?= words of at most 42 bytes each, cut only between
    // characters (a continuation byte never starts a word), folded with CRLF
    // and a space (RFC 2047 §2, RFC 5322 §2.2.3).
    encodedWords(text: string) -> string {
        raw = text.utf8();
        words: List<string> = [];
        start: int = 0;
        i: int = 0;
        while (i < raw.length()) {
            i = i + 1;
            if (i - start >= 42 && (i == raw.length() || !continuation(raw.at(i)))) {
                words = append(words, word(raw.slice(start, i)));
                start = i;
            }
        }

        if (start < raw.length()) {
            words = append(words, word(raw.slice(start, raw.length())));
        }

        return words.join("\r\n ");
    }

    // A header of addresses, each with its display name when names has one,
    // separated by commas and folded before an address that would take the
    // line past 78 characters (RFC 5322 §2.1.1, §3.4).
    addressHeader(field: string, addresses: List<string>, names: Map<string, string>) -> string {
        text: string = "${field}:";
        first: bool = true;
        for (address in addresses) {
            entry = mailbox(address, names.atOr(address, ""));
            if (!first) {
                text = "${text},";
            }

            width = entry.split("\r\n").first().utf8().length();
            if (!first && text.split("\r\n").last().utf8().length() + 1 + width > 78) {
                text = "${text}\r\n ${entry}";
            } else {
                text = "${text} ${entry}";
            }

            first = false;
        }

        return text;
    }

    // An address as a header writes it: bare, or after its display name in
    // angle brackets. A name of plain words goes as it is; one with a
    // character that means something in a header (or =?, which a reader
    // would decode) is quoted; one that isn't printable ASCII is encoded
    // words (RFC 5322 §3.4, RFC 2047 §5).
    mailbox(address: string, name: string) -> string {
        if (name == "") {
            return address;
        }

        for (b in name.utf8()) {
            if (b < 32 || b > 126) {
                return "${encodedWords(name)} <${address}>";
            }
        }

        if (plainPhrase(name)) {
            return "${name} <${address}>";
        }

        quoted = name.replaceAll("\\", "\\\\").replaceAll("\"", "\\\"");
        return "\"${quoted}\" <${address}>";
    }

    // Letters, digits, spaces, and the symbols RFC 5322's atoms allow.
    plainPhrase(name: string) -> bool {
        if (name.contains("=?")) {
            return false;
        }

        for (b in name.utf8()) {
            if (b == 34 || b == 40 || b == 41 || b == 44 || b == 46 || b == 58 || b == 59 || b == 60 || b == 62 || b == 64 || b == 91 || b == 92 || b == 93) {
                return false;
            }
        }

        return true;
    }

    word(part: bytes) -> string {
        return "=?UTF-8?B?${part.toBase64()}?=";
    }

    // The second to fourth byte of a UTF-8 character.
    continuation(b: int) -> bool {
        return b >= 128 && b < 192;
    }
}
