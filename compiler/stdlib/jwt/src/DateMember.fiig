// A NumericDate claim (RFC 7519 §2) in Unix milliseconds: seconds,
// perhaps with a fraction, read to the millisecond. None when the claim is
// missing; Malformed when it is there and isn't a number of seconds from
// the year 1970 to 9999.
conversion dateMember(members: Map<string, JsonValue>, name: string)
        -> Result<int | None, JwtError> {
    return match (members.atOrNone(name)) {
        None -> Ok(None),
        JsonValue.Number(text) -> millisOf(name, text),
        _ -> Err(JwtError.Malformed(reason: "the ${name} claim isn't a number"))
    }
}

private {
    millisOf(name: string, text: string) -> Result<int | None, JwtError> {
        bad = JwtError.Malformed(
            reason: "the ${name} claim isn't a number of seconds from 1970 to 9999"
        );
        parts = text.split(".");
        if (parts.length() > 2) {
            return Err(bad);
        }

        return match (parts.first().toIntOrNone()) {
            None -> Err(bad),
            seconds -> {
                if (seconds < 0 || seconds > 253402300799) {
                    return Err(bad);
                }

                fraction: int = 0;
                if (parts.length() == 2) {
                    digits = parts.last();
                    match ("${digits}000".slice(0, 3).toIntOrNone()) {
                        None -> {
                            return Err(bad);
                        },

                        given -> {
                            signed = digits.startsWith("-") || digits.startsWith("+");
                            if (digits.length() == 0 || signed) {
                                return Err(bad);
                            }

                            fraction = given;
                        }
                    }
                }

                return Ok(seconds * 1000 + fraction);
            }
        }
    }
}
