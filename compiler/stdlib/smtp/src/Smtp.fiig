// ADR 0120: sending mail by SMTP, written in fiig over Socket. One mail is
// one connection: connect, greet, upgrade with STARTTLS when the URL says
// to, log in, MAIL FROM, RCPT TO each recipient, DATA, QUIT. Every decision
// about what to send next is a conversion (nextStep, advance); this gateway
// only writes the bytes and reads the replies.
capability Smtp {
    gateway send(mail: Mail) -> Result<None, SmtpError>
        requires Socket
    {
        checkMail(mail)?
        target = parseSmtpUrl(SmtpServer.url.reveal())?
        now = Clock.now()
        token = Random.bytes(12).toHex()
        data = mailData(mail, rfc5322Date(now), messageIdFor(mail, token))
        until: int = now + SmtpServer.timeoutMillis
        opened: Result<Connection, SocketError> = Err(SocketError.Closed)
        match target.security {
            SmtpSecurity.Implicit -> {
                opened = Socket.connectTls(target.host, target.port, deadline: until)
            }
            _ -> {
                opened = Socket.connect(target.host, target.port, deadline: until)
            }
        }
        connection: Connection = mapErr(e in opened): SmtpError.Socket(failure: e)?
        dialogue: Dialogue = startDialogue(target, mail, SmtpServer.helloName, data)
        buffer: bytes = <<>>
        while true {
            match nextStep(dialogue) {
                SmtpStep.Listen -> None
                SmtpStep.Send(out) -> {
                    match Socket.write(connection, out, deadline: until) {
                        Err(failure) -> {
                            Socket.close(connection)
                            return Err(SmtpError.Socket(failure: failure))
                        }
                        Ok(_) -> None
                    }
                }
                SmtpStep.SendAndClose(out) -> {
                    // The mail was accepted before QUIT, so a hang-up the
                    // server beat us to isn't a failure.
                    match Socket.write(connection, out, deadline: until) {
                        Err(_) -> None
                        Ok(_) -> None
                    }
                    Socket.close(connection)
                    return Ok(None)
                }
                SmtpStep.Upgrade -> {
                    // Bytes that arrived after the server's agreement and
                    // before the handshake were sent in the clear, perhaps by
                    // someone else (CVE-2011-0411): refuse them.
                    if buffer.length() > 0 {
                        Socket.close(connection)
                        return Err(
                            SmtpError.Protocol(reason: "the server sent bytes after agreeing to STARTTLS and before the TLS handshake"),
                        )
                    }
                    match Socket.startTls(connection, target.host, deadline: until) {
                        Err(failure) -> {
                            Socket.close(connection)
                            return Err(SmtpError.Socket(failure: failure))
                        }
                        Ok(secured) -> {
                            connection = secured
                        }
                    }
                    dialogue = afterUpgrade(dialogue)
                    continue
                }
            }
            reply: SmtpReply = SmtpReply(code: 0, lines: [])
            reading: bool = true
            while reading {
                match readSmtpReply(buffer) {
                    SmtpReplyRead.Done(found, rest) -> {
                        reply = found
                        buffer = rest
                        reading = false
                    }
                    SmtpReplyRead.Malformed(reason) -> {
                        Socket.close(connection)
                        return Err(SmtpError.Protocol(reason: reason))
                    }
                    SmtpReplyRead.NeedMore -> {
                        match Socket.read(connection, deadline: until) {
                            Ok(chunk) -> {
                                buffer = <<buffer: bytes, chunk: bytes>>
                            }
                            Err(failure) -> {
                                Socket.close(connection)
                                return Err(SmtpError.Socket(failure: failure))
                            }
                        }
                    }
                }
            }
            match advance(dialogue, reply) {
                Ok(next) -> {
                    dialogue = next
                }
                Err(failure) -> {
                    Socket.close(connection)
                    return Err(failure)
                }
            }
        }
    }
}
