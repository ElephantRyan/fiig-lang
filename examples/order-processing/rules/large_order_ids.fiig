// ADR 0057: building a list. `ids: List<string> = []` gives the empty
// literal its element type, and `append` returns a new list each time;
// appending to the newest version costs constant time per element.
rule largeOrderIds(orders: List<Order>, threshold: int) -> List<string> {
    ids: List<string> = []
    for order in orders {
        if order.total >= threshold {
            ids = append(ids, order.id)
        }
    }
    return ids
}
