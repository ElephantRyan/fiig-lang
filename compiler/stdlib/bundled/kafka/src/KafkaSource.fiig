use fiig.stream;
use com.degeneratedevelopment.kafka.cluster;
use com.degeneratedevelopment.kafka.codec;
use com.degeneratedevelopment.kafka.consumerGroup;
use com.degeneratedevelopment.kafka.dialogue;
use com.degeneratedevelopment.kafka.fetch;
use com.degeneratedevelopment.kafka.produce;

// ADR 0117: Kafka as a stream source, a KIP-848 consumer group over
// sessions (ADR 0114). A route's source is the topic and its group the
// consumer group. receive polls the group session for partitions to fetch
// and fetches them from their leaders; settle acks, seeks back, or
// produces a dead letter, through the same sessions.
capability KafkaSource provides stream.StreamSource {
    gateway receive(subscription: stream.Subscription, batchSize: int)
            -> Result<List<stream.Delivery>, stream.SourceError>
            requires Session {
        group = consumerGroup.groupSettings(
            subscription,
            KafkaServer.bootstrap,
            KafkaServer.tls,
            KafkaServer.clientId,
            KafkaConsumer.commitIntervalMillis
        )?;
        clientId = KafkaServer.clientId;
        topic = subscription.source;
        timeout = KafkaServer.timeoutMillis;
        maxBytes = KafkaConsumer.fetchMaxBytes;
        poll = KafkaAsk.Poll(waitMillis: subscription.waitMillis);
        polled = mapErr(e in Session.call(group, json.encode(poll), deadline: Clock.now() + subscription.waitMillis + timeout)):
                cluster.unavailable(e)?;
        reply = fetch.pollReplyOf(polled)?;
        if (reply.failure != "") {
            return Err(stream.SourceError.Misconfigured(reason: reply.failure));
        }

        if (reply.partitions.length() == 0) {
            return Ok([]);
        }

        until = Clock.now() + timeout;
        described = mapErr(e in Session.call(group, dialogue.requestAsk(cluster.metadataRequest(clientId, 1, topic)), deadline: until)):
                cluster.unavailable(e)?;
        layout = mapErr(e in cluster.readMetadata(described.first(), 1, topic)):
                consumerGroup.consumerError(e)?;
        plans = mapErr(e in fetch.fetchPlans(layout, reply.partitions)):
                consumerGroup.consumerError(e)?;
        // Where a partition with no committed offset starts (ADR 0111 §3a).
        timestamp: int = 0 - 2;
        match (subscription.start) {
            stream.StartAt.Latest -> {
                timestamp = 0 - 1;
            },

            stream.StartAt.Earliest -> None
        }

        deliveries: List<stream.Delivery> = [];
        wait: int = subscription.waitMillis;
        for (plan in plans) {
            broker = cluster.brokerSettings(plan.broker, KafkaServer.tls, clientId);
            unplaced: List<int> = [];
            positions: List<PartitionOffset> = [];
            for (p in plan.partitions) {
                if (p.position < 0) {
                    unplaced = append(unplaced, p.partition);
                } else {
                    positions = append(
                        positions,
                        PartitionOffset(partition: p.partition, offset: p.position)
                    );
                }
            }

            if (unplaced.length() > 0) {
                listed = mapErr(e in Session.call(broker, dialogue.requestAsk(fetch.listOffsetsRequest(clientId, 1, topic, unplaced, timestamp)), deadline: until)):
                        cluster.unavailable(e)?;
                found = mapErr(e in fetch.readListOffsets(listed.first())):
                        consumerGroup.consumerError(e)?;
                for (o in found) {
                    positions = append(positions, o);
                    advance = KafkaAsk.Advance(partition: o.partition, next: o.offset);
                    mapErr(e in Session.call(group, json.encode(advance), deadline: until)):
                            cluster.unavailable(e)?;
                }
            }

            if (positions.length() > 0 && deliveries.length() < batchSize) {
                request = fetch.fetchRequest(clientId, 1, topic, wait, maxBytes, positions);
                fetched = mapErr(e in Session.call(broker, dialogue.requestAsk(request), deadline: Clock.now() + wait + timeout)):
                        cluster.unavailable(e)?;
                parts = mapErr(e in fetch.readFetch(fetched.first(), maxBytes)):
                        consumerGroup.consumerError(e)?;
                for (part in parts) {
                    if (part.code == 1) {
                        // The log no longer reaches the position: start the
                        // partition again where `from` says.
                        reset = KafkaAsk.Advance(partition: part.partition, next: 0 - 1);
                        mapErr(e in Session.call(group, json.encode(reset), deadline: until)):
                                cluster.unavailable(e)?;
                    } else if (part.code == 0) {
                        for (p in plan.partitions) {
                            if (p.partition == part.partition) {
                                for (o in positions) {
                                    if (o.partition == part.partition) {
                                        taken = fetch.takenFrom(
                                            part,
                                            o.offset,
                                            p,
                                            batchSize - deliveries.length()
                                        );
                                        for (d in taken.deliveries) {
                                            deliveries = append(deliveries, d);
                                        }

                                        if (taken.next >= 0) {
                                            advance = KafkaAsk.Advance(
                                                partition: part.partition,
                                                next: taken.next
                                            );
                                            mapErr(e in Session.call(group, json.encode(advance), deadline: until)):
                                                    cluster.unavailable(e)?;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                if (deliveries.length() > 0) {
                    wait = 0;
                }
            }
        }

        return Ok(deliveries);
    }

    gateway settle(
        subscription: stream.Subscription,
        delivery: stream.Delivery,
        outcome: stream.Outcome)
            -> Result<None, stream.SourceError>
            requires Session {
        group = consumerGroup.groupSettings(
            subscription,
            KafkaServer.bootstrap,
            KafkaServer.tls,
            KafkaServer.clientId,
            KafkaConsumer.commitIntervalMillis
        )?;
        at = fetch.deliveryAt(delivery.id)?;
        clientId = KafkaServer.clientId;
        until = Clock.now() + KafkaServer.timeoutMillis;
        match (outcome) {
            stream.Outcome.Retry -> {
                // Seek back (ADR 0117 §5): nothing after it in the partition
                // is handled first.
                seekBack = KafkaAsk.Retry(
                    partition: at.partition,
                    offset: at.offset,
                    resumeAt: Clock.now() + KafkaConsumer.retryAfterMillis
                );
                mapErr(e in Session.call(group, json.encode(seekBack), deadline: until)):
                        cluster.unavailable(e)?;
                return Ok(None);
            },

            stream.Outcome.DeadLetter(target) -> {
                described = mapErr(e in Session.call(group, dialogue.requestAsk(cluster.metadataRequest(clientId, 1, target)), deadline: until)):
                        cluster.unavailable(e)?;
                layout = mapErr(e in cluster.readMetadata(described.first(), 1, target)):
                        consumerGroup.consumerError(e)?;
                record = KafkaRecord(
                    key: "${subscription.source}/${delivery.id}".utf8(),
                    value: delivery.payload,
                    headers: None
                );
                calls = mapErr(e in produce.producePlan(layout, [record], Clock.now(), Compression.None)):
                        consumerGroup.consumerError(e)?;
                for (call in calls) {
                    produceBody = produce.produceRequest(
                        clientId,
                        1,
                        target,
                        KafkaServer.timeoutMillis,
                        call.batches
                    );
                    sent = mapErr(e in Session.call(cluster.brokerSettings(call.broker, KafkaServer.tls, clientId), dialogue.requestAsk(produceBody), deadline: until)):
                            cluster.unavailable(e)?;
                    mapErr(e in produce.readProduce(sent.first(), 1, call)):
                            consumerGroup.consumerError(e)?;
                }
            },

            stream.Outcome.Ack -> None
        }

        ack = KafkaAsk.Ack(partition: at.partition, offset: at.offset);
        mapErr(e in Session.call(group, json.encode(ack), deadline: until)):
                cluster.unavailable(e)?;
        return Ok(None);
    }

    // One record by its id, "partition/offset", for replay (ADR 0111 open
    // question 1, as amended 2026-11-21): the topic's layout from the first
    // bootstrap server, then a Fetch at that offset from the partition's
    // leader, both over broker sessions. The group session isn't used, so
    // replaying joins no group and moves no member's partitions, and the
    // record is on attempt 1, since only a member knows its retries.
    gateway fetch(subscription: stream.Subscription, id: string)
            -> Result<stream.Delivery | None, stream.SourceError>
            requires Session {
        at = fetch.deliveryAt(id)?;
        clientId = KafkaServer.clientId;
        topic = subscription.source;
        until = Clock.now() + KafkaServer.timeoutMillis;
        // The bootstrap session, with the other servers as its alternates.
        bootstrap = mapErr(e in cluster.bootstrapSettings(KafkaServer.bootstrap, KafkaServer.tls, clientId)):
                consumerGroup.consumerError(e)?;
        described = mapErr(e in Session.call(bootstrap, dialogue.requestAsk(cluster.metadataRequest(clientId, 1, topic)), deadline: until)):
                cluster.unavailable(e)?;
        layout = mapErr(e in cluster.readMetadata(described.first(), 1, topic)):
                consumerGroup.consumerError(e)?;
        leader = mapErr(e in cluster.leaderAt(layout, at.partition)):
                consumerGroup.consumerError(e)?;
        return match (leader) {
            None -> Ok(None),
            broker -> {
                maxBytes = KafkaConsumer.fetchMaxBytes;
                request = fetch.fetchRequest(clientId, 1, topic, 0, maxBytes, [at]);
                fetched = mapErr(e in Session.call(cluster.brokerSettings(broker, KafkaServer.tls, clientId), dialogue.requestAsk(request), deadline: until)):
                        cluster.unavailable(e)?;
                parts = mapErr(e in fetch.readFetch(fetched.first(), maxBytes)):
                        consumerGroup.consumerError(e)?;
                return mapErr(e in codec.recordAt(parts, at)): consumerGroup.consumerError(e);
            }
        }
    }
}
