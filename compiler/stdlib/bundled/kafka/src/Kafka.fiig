use com.degeneratedevelopment.kafka.cluster;
use com.degeneratedevelopment.kafka.dialogue;
use com.degeneratedevelopment.kafka.produce;

// ADR 0113: a Kafka producer written in fiig, at least once: acks=all, no
// idempotence, no transactions, no retries (§1). A send asks the bootstrap
// session for the topic's layout, which it keeps for
// KAFKA_METADATA_MAX_AGE_MS, then sends each partition's leader its
// records over that leader's broker session (§4, as amended 2026-11-21:
// over sessions, ADR 0117 §3, where it was Socket with kept connections,
// ADR 0109). A produce that says the leaders moved drops the kept layout,
// so the next send reads it again.
capability Kafka {
    gateway send(topic: string, records: List<KafkaRecord>) -> Result<List<Sent>, KafkaError>
            requires Session {
        if (records.length() == 0) {
            return Ok([]);
        }

        clientId = KafkaServer.clientId;
        bootstrap = cluster.bootstrapSettings(KafkaServer.bootstrap, KafkaServer.tls, clientId)?;
        compression: Compression = Compression.None;
        match (KafkaServer.compression) {
            None -> None,
            chosen -> {
                compression = chosen;
            }
        }

        now = Clock.now();
        until = now + KafkaServer.timeoutMillis;
        ask = KafkaAsk.Layout(topic: topic, maxAgeMillis: KafkaServer.metadataMaxAgeMillis);
        described = mapErr(e in Session.call(bootstrap, json.encode(ask), deadline: until)):
                KafkaError.Session(failure: e)?;
        layout = cluster.layoutOf(described)?;
        sent: List<SentAt> = [];
        for (call in produce.producePlan(layout, records, now, compression)?) {
            request = produce.produceV9Request(
                clientId,
                1,
                topic,
                KafkaServer.timeoutMillis,
                call.batches
            );
            leader = cluster.brokerSettings(call.broker, KafkaServer.tls, clientId);
            failure: KafkaError | None = None;
            match (Session.call(leader, dialogue.requestAsk(request), deadline: until)) {
                Err(e) -> {
                    failure = KafkaError.Session(failure: e);
                },

                Ok(parts) -> {
                    match (produce.readProduceV9(parts.first(), 1, call)) {
                        Err(e) -> {
                            failure = e;
                        },

                        Ok(placed) -> {
                            for (s in placed) {
                                sent = append(sent, s);
                            }
                        }
                    }
                }
            }

            match (failure) {
                None -> None,
                found -> {
                    // A produce that fails is the caller's to send again
                    // (§1); a stale layout isn't kept for that send.
                    if (cluster.layoutMoved(found)) {
                        forget = KafkaAsk.Forget(topic: topic);
                        match (Session.call(bootstrap, json.encode(forget), deadline: until)) {
                            Ok(_) -> None,
                            Err(_) -> None
                        }
                    }

                    return Err(found);
                }
            }
        }

        return produce.inOrder(sent, records.length());
    }
}
