// The crypto algorithm behind a public-key JOSE algorithm (ADR 0146 §1),
// or None for an HMAC one, which no public key verifies.
conversion signatureAlgorithmOf(algorithm: Algorithm) -> SignatureAlgorithm | None {
    return match (algorithm) {
        Algorithm.RS256 -> SignatureAlgorithm.RsaPkcs1Sha256,
        Algorithm.RS384 -> SignatureAlgorithm.RsaPkcs1Sha384,
        Algorithm.RS512 -> SignatureAlgorithm.RsaPkcs1Sha512,
        Algorithm.PS256 -> SignatureAlgorithm.RsaPssSha256,
        Algorithm.PS384 -> SignatureAlgorithm.RsaPssSha384,
        Algorithm.PS512 -> SignatureAlgorithm.RsaPssSha512,
        Algorithm.ES256 -> SignatureAlgorithm.EcdsaP256Sha256,
        Algorithm.ES384 -> SignatureAlgorithm.EcdsaP384Sha384,
        Algorithm.EdDSA -> SignatureAlgorithm.Ed25519,
        _ -> None
    }
}
