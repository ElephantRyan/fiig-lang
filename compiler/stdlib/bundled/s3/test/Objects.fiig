use fiig.http;
use com.degeneratedevelopment.s3.objects;

test httpsAndAHost {
    expect objects.parseS3Endpoint("https://s3.eu-west-1.amazonaws.com") is Ok(endpoint);
    expect endpoint == S3Endpoint(scheme: "https", authority: "s3.eu-west-1.amazonaws.com");
}

test httpAndAPort {
    expect objects.parseS3Endpoint("http://localhost:9000") is Ok(endpoint);
    expect endpoint == S3Endpoint(scheme: "http", authority: "localhost:9000");
}

test aTrailingSlashIsDropped {
    expect objects.parseS3Endpoint("https://storage.example.com/") is Ok(endpoint);
    expect endpoint.authority == "storage.example.com";
}

test whatCantBeAServiceAddressIsRefused {
    for (bad in ["storage.example.com", "ftp://storage.example.com", "https://", "https:///", "https://storage.example.com/bucket", "https://storage.example.com?x=1", "https://storage.example.com#top", "https://key:secret@storage.example.com", "https://storage example.com", "https://störäge.example.com"]) {
        expect objects.parseS3Endpoint(bad) is Err(S3Error.InvalidConfig(reason));
    }
}

test aReasonNeverRepeatsTheKeys {
    expect objects.parseS3Endpoint("https://AKIAEXAMPLE:topsecret@storage.example.com") is Err(S3Error.InvalidConfig(reason));
    expect !reason.contains("topsecret");
    expect !reason.contains("AKIAEXAMPLE");
}

test pathStyleHasTheBucketInThePath {
    expect objects.objectTarget(aws(), "photos", "2026/cat.png", true) is Ok(target);
    expect target == S3Target(url: "https://s3.eu-west-1.amazonaws.com/photos/2026/cat.png", host: "s3.eu-west-1.amazonaws.com", path: "/photos/2026/cat.png");
}

test virtualHostedHasTheBucketInTheHost {
    expect objects.objectTarget(aws(), "photos", "2026/cat.png", false) is Ok(target);
    expect target == S3Target(url: "https://photos.s3.eu-west-1.amazonaws.com/2026/cat.png", host: "photos.s3.eu-west-1.amazonaws.com", path: "/2026/cat.png");
}

test aPortInTheEndpointIsInTheUrlAndTheHost {
    expect objects.objectTarget(S3Endpoint(scheme: "http", authority: "localhost:9000"), "photos", "a", true) is Ok(target);
    expect target.host == "localhost:9000";
    expect target.url == "http://localhost:9000/photos/a";
}

test everySegmentIsEncodedOnceAndSlashesStay {
    expect objects.objectTarget(aws(), "photos", "a b/c?d#e%f/é.png", true) is Ok(target);
    expect target.path == "/photos/a%20b/c%3Fd%23e%25f/%C3%A9.png";
}

test aKeyCanHaveEmptySegments {
    expect objects.objectTarget(aws(), "photos", "a//b/", true) is Ok(target);
    expect target.path == "/photos/a//b/";
}

test unreservedCharactersAreLeftAlone {
    expect objects.objectTarget(aws(), "photos", "A-z_0.9~", true) is Ok(target);
    expect target.path == "/photos/A-z_0.9~";
}

test aDotSegmentIsRefused {
    for (key in ["..", "a/../b", "./a", "a/."]) {
        expect objects.objectTarget(aws(), "photos", key, true) is Err(S3Error.InvalidRequest(reason));
    }
}

test anEmptyOrOversizeOrControlKeyIsRefused {
    expect objects.objectTarget(aws(), "photos", "", true) is Err(S3Error.InvalidRequest(reason));
    expect objects.objectTarget(aws(), "photos", repeated("a", 1025), true) is Err(S3Error.InvalidRequest(reason2));
    expect objects.objectTarget(aws(), "photos", "a\nb", true) is Err(S3Error.InvalidRequest(reason3));
    expect objects.objectTarget(aws(), "photos", repeated("a", 1024), true) is Ok(target);
}

test aBucketNameIsChecked {
    for (bad in ["", "ab", "Photos", "my_bucket", "-photos", "photos-", ".photos", "photos.", "has space", "a/b", repeated("a", 64)]) {
        expect objects.objectTarget(aws(), bad, "k", true) is Err(S3Error.InvalidRequest(reason));
    }

    for (good in ["abc", "my-bucket", "my.bucket.v2", "a1b", repeated("a", 63)]) {
        expect objects.objectTarget(aws(), good, "k", true) is Ok(target);
    }
}

test theSourceIsTheEncodedPathStylePath {
    expect objects.copySource("photos", "2026/cat é?.png") is Ok(header);
    expect header == http.Header(name: "x-amz-copy-source", value: "/photos/2026/cat%20%C3%A9%3F.png");
}

test aBadSourceIsRefused {
    expect objects.copySource("photos", "a/../b") is Err(S3Error.InvalidRequest(reason));
    expect objects.copySource("No_Such", "a") is Err(S3Error.InvalidRequest(reason));
}

test theChecksumIsTheBodysSha256InBase64 {
    expect objects.checksumHeader("hello".utf8()) == http.Header(name: "x-amz-checksum-sha256", value: "LPJNul+wow4m6DsqxbninhsWHlwfp0JecwQzYpOLmCQ=");
}

test anEmptyBodyHasOne {
    expect objects.checksumHeader(<<>>).value == "47DEQpj8HBSa+/TImW+5JCeuQeRkm5NMpJWZG3hSuFU=";
}

test eachKeyIsAnXAmzMetaHeaderInLowerCase {
    expect objects.metadataHeaders(["Run": "7", "author": "Ada Lovelace"]) is Ok(headers);
    expect headers == [http.Header(name: "x-amz-meta-author", value: "Ada Lovelace"), http.Header(name: "x-amz-meta-run", value: "7")];
}

test noMetadataIsNoHeaders {
    expect objects.metadataHeaders([:]) is Ok(headers);
    expect headers.length() == 0;
}

test keysThatDifferOnlyInCaseAreRefused {
    expect objects.metadataHeaders(["Run": "7", "run": "8"]) is Err(S3Error.InvalidRequest(reason));
}

test aKeyThatIsntAHeaderNameIsRefused {
    expect objects.metadataHeaders(["a b": "1"]) is Err(S3Error.InvalidRequest(reason));
    expect objects.metadataHeaders(["": "1"]) is Err(S3Error.InvalidRequest(reason));
}

test aValueWithALineBreakOrOutsideAsciiIsRefused {
    expect objects.metadataHeaders(["a": "one\ntwo"]) is Err(S3Error.InvalidRequest(reason));
    expect objects.metadataHeaders(["a": "café"]) is Err(S3Error.InvalidRequest(reason));
}

test aClosedRangeIncludesBothEnds {
    expect objects.rangeHeader(0, 99) is Ok(header);
    expect header == http.Header(name: "Range", value: "bytes=0-99");
}

test anOpenRangeRunsToTheEnd {
    expect objects.rangeHeader(100, None) is Ok(header);
    expect header.value == "bytes=100-";
}

test oneByteIsARange {
    expect objects.rangeHeader(7, 7) is Ok(header);
    expect header.value == "bytes=7-7";
}

test aNegativeStartOrABackwardRangeIsRefused {
    expect objects.rangeHeader(-1, 5) is Err(S3Error.InvalidRequest(reason));
    expect objects.rangeHeader(5, 4) is Err(S3Error.InvalidRequest(reason));
}

test a200WithACopyResultIsDone {
    body = "<CopyObjectResult><ETag>\"e\"</ETag></CopyObjectResult>".utf8();
    expect objects.copyResult(http.Reply(status: 200, headers: [], body: body)) is Ok(None);
}

test a200WithAnErrorDocumentIsRefused {
    body = "<Error><Code>InternalError</Code><Message>Try again.</Message></Error>".utf8();
    expect objects.copyResult(http.Reply(status: 200, headers: [], body: body)) is Err(S3Error.Refused(status, code, message));
    expect status == 200;
    expect code == "InternalError";
}

test aMissingSourceIsNotFound {
    body = "<Error><Code>NoSuchKey</Code></Error>".utf8();
    expect objects.copyResult(http.Reply(status: 404, headers: [], body: body)) is Err(S3Error.NotFound);
}

test a204IsDeleted {
    expect objects.deleteResult(http.Reply(status: 204, headers: [], body: <<>>)) is Ok(_);
}

test a200IsDeletedToo {
    expect objects.deleteResult(http.Reply(status: 200, headers: [], body: <<>>)) is Ok(_);
}

test anythingElseIsAnErrorForADelete {
    expect objects.deleteResult(http.Reply(status: 403, headers: [], body: "<Error><Code>AccessDenied</Code><Message>no</Message></Error>".utf8())) is Err(S3Error.Refused(status, code, message));
    expect code == "AccessDenied";
}

test a404IsNotFound {
    expect objects.errorOf(reply(404, "<Error><Code>NoSuchKey</Code></Error>")) == S3Error.NotFound;
}

test aMissingBucketIsNotAMissingKey {
    xml = "<Error><Code>NoSuchBucket</Code><Message>The specified bucket does not exist</Message></Error>";
    expect objects.errorOf(reply(404, xml)) == S3Error.Refused(status: 404, code: "NoSuchBucket", message: "The specified bucket does not exist");
}

test a404WithNoBodyIsNotFound {
    // What a HEAD gets, since it has no body to read.
    expect objects.errorOf(reply(404, "")) == S3Error.NotFound;
}

test otherStatusesCarryTheServersCodeAndMessage {
    xml = "<?xml version=\"1.0\"?><Error><Code>AccessDenied</Code><Message>Access Denied</Message><RequestId>4442587FB7D0A2F9</RequestId></Error>";
    expect objects.errorOf(reply(403, xml)) == S3Error.Refused(status: 403, code: "AccessDenied", message: "Access Denied");
}

test aReplyWithNoBodyHasEmptyCodeAndMessage {
    // A HEAD has no body to read.
    expect objects.errorOf(reply(403, "")) == S3Error.Refused(status: 403, code: "", message: "");
}

test aBodyThatIsNotAnErrorDocumentIsNotMisread {
    expect objects.errorOf(reply(502, "<html><body>Bad Gateway</body></html>")) == S3Error.Refused(status: 502, code: "", message: "");
}

test aMessageWithMarkupInItIsTakenToTheClosingTag {
    expect objects.errorOf(reply(400, "<Error><Code>InvalidArgument</Code><Message>bad &lt;x&gt; argument</Message></Error>")) == S3Error.Refused(status: 400, code: "InvalidArgument", message: "bad &lt;x&gt; argument");
}

test a200IsTheObject {
    expect objects.getResult(http.Reply(status: 200, headers: [], body: "hello".utf8())) is Ok(body);
    expect body == "hello".utf8();
}

test binaryBytesComeBackWhole {
    data: bytes = <<0: u8, 13: u8, 10: u8, 255: u8>>;
    expect objects.getResult(http.Reply(status: 200, headers: [], body: data)) is Ok(body);
    expect body == data;
}

test aMissingKeyIsNotFound {
    expect objects.getResult(http.Reply(status: 404, headers: [], body: "<Error><Code>NoSuchKey</Code></Error>".utf8())) is Err(S3Error.NotFound);
}

test anotherStatusIsRefusedWithItsCode {
    expect objects.getResult(http.Reply(status: 403, headers: [], body: "<Error><Code>AccessDenied</Code><Message>Access Denied</Message></Error>".utf8())) is Err(S3Error.Refused(status, code, message));
    expect code == "AccessDenied";
}

test aHeadReplyIsTheObjectsInfo {
    reply = http.Reply(
        status: 200,
        headers: [
            http.Header(name: "content-length", value: "1234"),
            http.Header(name: "Content-Type", value: "image/png"),
            http.Header(name: "ETag", value: "\"abc123\"")
        ],
        body: <<>>
    );
    expect objects.headResult(reply) is Ok(info);
    expect info == ObjectInfo(size: 1234, contentType: "image/png", etag: "\"abc123\"", metadata: [:]);
}

test headerNamesAreReadInAnyCase {
    reply = http.Reply(
        status: 200,
        headers: [
            http.Header(name: "CONTENT-LENGTH", value: "7"),
            http.Header(name: "content-type", value: "text/plain"),
            http.Header(name: "etag", value: "e")
        ],
        body: <<>>
    );
    expect objects.headResult(reply) is Ok(info);
    expect info == ObjectInfo(size: 7, contentType: "text/plain", etag: "e", metadata: [:]);
}

test theMetadataComesBackKeyedInLowerCase {
    reply = http.Reply(
        status: 200,
        headers: [
            http.Header(name: "Content-Length", value: "5"),
            http.Header(name: "X-Amz-Meta-Author", value: "Ada")
        ],
        body: <<>>
    );
    expect objects.headResult(reply) is Ok(info);
    expect info.metadata == ["author": "Ada"];
}

test noLengthIsMalformed {
    reply = http.Reply(status: 200, headers: [http.Header(name: "ETag", value: "e")], body: <<>>);
    expect objects.headResult(reply) is Err(S3Error.Http(failure));
}

test aLengthThatIsntANumberIsMalformed {
    reply = http.Reply(
        status: 200,
        headers: [http.Header(name: "Content-Length", value: "lots")],
        body: <<>>
    );
    expect objects.headResult(reply) is Err(S3Error.Http(failure));
}

test a404IsNotFoundAndOtherStatusesAreRefused {
    expect objects.headResult(http.Reply(status: 404, headers: [], body: <<>>)) is Err(S3Error.NotFound);
    expect objects.headResult(http.Reply(status: 403, headers: [], body: <<>>)) is Err(S3Error.Refused(status, code, message));
    expect status == 403;
}

test metadataHeadersInAnyCaseAreKeyedWithoutThePrefix {
    headers = [
        http.Header(name: "X-Amz-Meta-Author", value: "Ada"),
        http.Header(name: "x-amz-meta-run", value: "7"),
        http.Header(name: "x-amz-request-id", value: "r"),
        http.Header(name: "Content-Type", value: "text/plain")
    ];
    expect objects.metadataOf(headers) == ["author": "Ada", "run": "7"];
}

test thePrefixAloneAndARepeatAreIgnored {
    headers = [
        http.Header(name: "x-amz-meta-", value: "x"),
        http.Header(name: "x-amz-meta-a", value: "1"),
        http.Header(name: "x-amz-meta-a", value: "2")
    ];
    expect objects.metadataOf(headers) == ["a": "1"];
}

test a200IsTheObjectWithItsInfo {
    reply = http.Reply(
        status: 200,
        headers: [
            http.Header(name: "Content-Type", value: "text/plain"),
            http.Header(name: "ETag", value: "\"e\""),
            http.Header(name: "x-amz-meta-run", value: "7")
        ],
        body: "hello".utf8()
    );
    expect objects.objectResult(reply) is Ok(object);
    expect object.body == "hello".utf8();
    expect object.info == ObjectInfo(size: 5, contentType: "text/plain", etag: "\"e\"", metadata: ["run": "7"]);
}

test aMissingKeyHasNoObject {
    expect objects.objectResult(http.Reply(status: 404, headers: [], body: <<>>)) is Err(S3Error.NotFound);
}

test a200IsStored {
    expect objects.putResult(http.Reply(status: 200, headers: [], body: <<>>)) is Ok(_);
}

test anythingElseIsAnErrorForAPut {
    expect objects.putResult(http.Reply(status: 403, headers: [], body: "<Error><Code>AccessDenied</Code><Message>no</Message></Error>".utf8())) is Err(S3Error.Refused(status, code, message));
    expect status == 403;
    expect code == "AccessDenied";
    expect objects.putResult(http.Reply(status: 404, headers: [], body: <<>>)) is Err(S3Error.NotFound);
}

test aRedirectIsAnErrorNotFollowed {
    expect objects.putResult(http.Reply(status: 301, headers: [], body: <<>>)) is Err(S3Error.Refused(status, code, message));
    expect status == 301;
}

test a206IsThePart {
    expect objects.rangeResult(http.Reply(status: 206, headers: [], body: "ell".utf8()), 1, 3) is Ok(part);
    expect part == "ell".utf8();
}

test a416IsOutOfRange {
    expect objects.rangeResult(http.Reply(status: 416, headers: [], body: <<>>), 10, None) is Err(S3Error.OutOfRange);
}

test aServerThatIgnoresRangeHasThePartCutFromTheWhole {
    whole = http.Reply(status: 200, headers: [], body: "hello".utf8());
    expect objects.rangeResult(whole, 1, 3) is Ok(part);
    expect part == "ell".utf8();
    expect objects.rangeResult(whole, 2, None) is Ok(rest);
    expect rest == "llo".utf8();
    expect objects.rangeResult(whole, 3, 99) is Ok(tail);
    expect tail == "lo".utf8();
    expect objects.rangeResult(whole, 5, None) is Err(S3Error.OutOfRange);
}

test anotherStatusIsTheRangesError {
    expect objects.rangeResult(http.Reply(status: 404, headers: [], body: <<>>), 0, 1) is Err(S3Error.NotFound);
    expect objects.rangeResult(http.Reply(status: 403, headers: [], body: <<>>), 0, 1) is Err(S3Error.Refused(status, code, message));
}

private {
    aws() -> S3Endpoint {
        return S3Endpoint(scheme: "https", authority: "s3.eu-west-1.amazonaws.com");
    }

    repeated(piece: string, times: int) -> string {
        out: string = "";
        n: int = 0;
        while (n < times) {
            out = "${out}${piece}";
            n = n + 1;
        }

        return out;
    }

    reply(status: int, body: string) -> http.Reply {
        return http.Reply(status: status, headers: [], body: body.utf8());
    }
}
