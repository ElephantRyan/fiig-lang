// The COMPACT_STRING at offset at, a null one reading as "", or None when
// the response is too short or the text isn't UTF-8.
conversion compactStringAt(data: bytes, at: int) -> TextAt | None {
    match uvarintAt(data, at) {
        None -> {
            return None
        }
        length -> {
            if length.value == 0 {
                return TextAt(text: "", next: length.next)
            }
            end = length.next + length.value - 1
            if end > data.length() {
                return None
            }
            match data.slice(length.next, end).utf8() {
                None -> {
                    return None
                }
                text -> {
                    return TextAt(text: text, next: end)
                }
            }
        }
    }
}
