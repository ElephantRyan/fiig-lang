// ADR 0041: a real `bool` attestation beyond `if`/`not` — isLargeOrder is
// computed once and read twice (one comparison, reused across both regions)
// rather than repeating `total >= 10000` in each branch, and the
// final `true` is the first attested boolean literal in the corpus.
rule qualifiesForFreeShipping(total: int, region: Region) -> bool {
    isLargeOrder = total >= 10000;
    if (isLargeOrder && region == Region.US) {
        return true;
    }

    return isLargeOrder && region == Region.EU;
}
