use com.degeneratedevelopment.kafka.codec;
use com.degeneratedevelopment.kafka.consumerGroup;
use com.degeneratedevelopment.kafka.dialogue;
use com.degeneratedevelopment.kafka.sasl;

// SASL authentication: the handshake, PLAIN and SCRAM-SHA-256/512, and
// reading the broker's answers (ADR 0118).
formulas sasl {
    // ADR 0113, as amended 2026-11-21: SCRAM-SHA-256's or SCRAM-SHA-512's
    // client proof (RFC 5802 §3, RFC 7677), from the broker's first message:
    // the nonce it extended, the salt, and the iteration count, which Kafka
    // keeps at 4096 or more and fiig allows up to 1,000,000, as com.degeneratedevelopment.postgres
    // does (ADR 0085 §6). The same steps as com.degeneratedevelopment.postgres's, with the hash
    // the mechanism names.
    formula computeScramFinal(
        mechanism: SaslMechanism,
        password: bytes,
        clientFirstBare: string,
        clientNonce: string,
        serverFirst: string)
            -> Result<ScramFinal, string> {
        nonce: string = "";
        salt: bytes = <<>>;
        iterations: int = 0;
        for (part in serverFirst.split(",")) {
            if (part.startsWith("r=")) {
                nonce = part.removePrefix("r=");
            } else if (part.startsWith("s=")) {
                match (part.removePrefix("s=").fromBase64()) {
                    None -> {
                        return Err("the broker's SCRAM salt isn't base64");
                    },

                    decoded -> {
                        salt = decoded;
                    }
                }
            } else if (part.startsWith("i=")) {
                match (part.removePrefix("i=").toIntOrNone()) {
                    None -> {
                        return Err("the broker's SCRAM iteration count isn't a number");
                    },

                    count -> {
                        iterations = count;
                    }
                }
            } else if (part.startsWith("m=")) {
                return Err(
                    "the broker asks for a SCRAM extension com.degeneratedevelopment.kafka doesn't know"
                );
            }
        }

        if (!nonce.startsWith(clientNonce) || nonce.length() == clientNonce.length()) {
            return Err("the broker's SCRAM nonce doesn't extend the client's");
        }

        if (salt.length() == 0) {
            return Err("the broker sent no SCRAM salt");
        }

        if (iterations < 4096 || iterations > 1000000) {
            return Err(
                "the broker asks for ${iterations} SCRAM iterations; com.degeneratedevelopment.kafka allows 4096 to 1000000"
            );
        }

        withoutProof = "c=biws,r=${nonce}";
        authMessage = "${clientFirstBare},${serverFirst},${withoutProof}".utf8();
        return match (mechanism) {
            SaslMechanism.ScramSha512 -> {
                salted = crypto.pbkdf2Sha512(password, salt, iterations);
                clientKey = crypto.hmacSha512(salted, "Client Key".utf8());
                clientSignature = crypto.hmacSha512(crypto.sha512(clientKey), authMessage);
                serverKey = crypto.hmacSha512(salted, "Server Key".utf8());
                return Ok(
                    ScramFinal(
                        message: "${withoutProof},p=${clientKey.xor(clientSignature).toBase64()}",
                        serverSignature: crypto.hmacSha512(serverKey, authMessage)
                    )
                );
            },

            _ -> {
                salted = crypto.pbkdf2Sha256(password, salt, iterations);
                clientKey = crypto.hmacSha256(salted, "Client Key".utf8());
                clientSignature = crypto.hmacSha256(crypto.sha256(clientKey), authMessage);
                serverKey = crypto.hmacSha256(salted, "Server Key".utf8());
                return Ok(
                    ScramFinal(
                        message: "${withoutProof},p=${clientKey.xor(clientSignature).toBase64()}",
                        serverSignature: crypto.hmacSha256(serverKey, authMessage)
                    )
                );
            }
        }
    }

    // ADR 0113 §6, as amended 2026-11-21: one answer of a session's SASL
    // login, of kind: SaslHandshake ("saslHandshake"), then PLAIN's one
    // SaslAuthenticate ("saslPlain"), or SCRAM's two, the client's first
    // message answered by the broker's ("saslFirst") and the client's proof
    // answered by the broker's signature ("saslFinal"), which must be the one
    // the password gives, so a broker that doesn't know it is refused. Once
    // logged in, a broker session is ready and a group session asks for its
    // coordinator (ADR 0117 §3).
    formula saslAnswered(turn: SessionTurn, kind: string, frame: bytes, login: SaslLogin)
            -> SessionTurn {
        s = turn.state;
        return match (login.mechanism) {
            None -> refused(turn, "the broker answered a SASL request this session didn't make"),
            mechanism -> {
                if (kind == "saslHandshake") {
                    match (readSaslHandshake(frame, saslMechanismName(mechanism))) {
                        Err(reason) -> {
                            return refused(turn, reason);
                        },

                        Ok(_) -> None
                    }

                    if (mechanism == SaslMechanism.Plain) {
                        plain = <<
                            0: u8,
                            login.username.utf8(): bytes,
                            0: u8,
                            login.password: bytes
                        >>;
                        return sent(turn, "saslPlain", plain);
                    }

                    bare = "n=${scramName(login.username)},r=${s.scramNonce}";
                    first = sent(turn, "saslFirst", "n,,${bare}".utf8());
                    return copy(first, state: copy(first.state, scramFirstBare: bare));
                }

                return match (readSaslAuthenticate(frame)) {
                    Err(reason) -> refused(turn, reason),
                    Ok(message) -> {
                        if (kind == "saslPlain") {
                            return loggedIn(turn);
                        }

                        return match (message.utf8()) {
                            None -> refused(turn, "the broker's SCRAM message isn't text"),
                            text -> {
                                if (kind == "saslFirst") {
                                    match (computeScramFinal(mechanism, login.password, s.scramFirstBare, s.scramNonce, text)) {
                                        Err(reason) -> {
                                            return refused(turn, reason);
                                        },

                                        Ok(final) -> {
                                            proof = sent(turn, "saslFinal", final.message.utf8());
                                            return copy(
                                                proof,
                                                state: copy(
                                                    proof.state,
                                                    scramSignature: final.serverSignature
                                                )
                                            );
                                        }
                                    }
                                }

                                if (text.startsWith("e=")) {
                                    return refused(
                                        turn,
                                        "the broker says ${text.removePrefix("e=")}"
                                    );
                                }

                                if (text.startsWith("v=") && s.scramSignature.length() > 0) {
                                    match (text.removePrefix("v=").fromBase64()) {
                                        None -> None,
                                        signature -> {
                                            if (crypto.equal(signature, s.scramSignature)) {
                                                return loggedIn(turn);
                                            }
                                        }
                                    }
                                }

                                return refused(
                                    turn,
                                    "the broker's SCRAM signature is wrong, so it doesn't know the password"
                                );
                            }
                        }
                    }
                }
            }
        }
    }

    // ADR 0113, as amended 2026-11-21: SaslAuthenticate v2 (API key 36,
    // KIP-152), a flexible version: one message of the mechanism's exchange,
    // as COMPACT_BYTES.
    formula saslAuthenticateRequest(clientId: string, correlation: int, message: bytes) -> bytes {
        body = <<codec.uvarint(message.length() + 1): bytes, message: bytes, 0: u8>>;
        return codec.kafkaFlexRequest(36, 2, correlation, clientId, body);
    }

    // ADR 0113, as amended 2026-11-21: SaslHandshake v1 (API key 17), which
    // names the mechanism; v1 means the exchange that follows goes in
    // SaslAuthenticate requests (KIP-152), not raw bytes.
    formula saslHandshakeRequest(clientId: string, correlation: int, mechanism: string) -> bytes {
        return codec.kafkaRequest(17, 1, correlation, clientId, codec.kafkaString(mechanism));
    }

    // A SASL mechanism by the name SaslHandshake asks for it (KIP-43).
    formula saslMechanismName(mechanism: SaslMechanism) -> string {
        return match (mechanism) {
            SaslMechanism.Plain -> "PLAIN",
            SaslMechanism.ScramSha256 -> "SCRAM-SHA-256",
            SaslMechanism.ScramSha512 -> "SCRAM-SHA-512"
        }
    }

    // ADR 0113 §6, as amended 2026-11-21: s once its SASL login has failed
    // for reason. A group session is "refused", and every poll is answered
    // with why, so the route halts as misconfigured (ADR 0117 §1); a broker
    // session answers every Layout with Authentication, so a send returns it.
    // Neither tries again on this connection: a login that failed once fails
    // the same way until the settings change.
    formula saslRefused(s: KafkaSessionState, reason: string) -> KafkaSessionState {
        why = "SASL authentication failed: ${reason}";
        if (s.role == "group") {
            return copy(s, phase: "refused", fatal: why, scramSignature: <<>>);
        }

        return copy(
            s,
            phase: "broker",
            refused: KafkaError.Authentication(reason: why),
            scramSignature: <<>>
        );
    }

    // A username as SCRAM's n= attribute writes it (RFC 5802 §5.1): = as =3D
    // and , as =2C, so neither ends the attribute.
    formula scramName(username: string) -> string {
        return username.replaceAll("=", "=3D").replaceAll(",", "=2C");
    }
}

private {
    refused(turn: SessionTurn, reason: string) -> SessionTurn {
        return copy(turn, state: sasl.saslRefused(turn.state, reason));
    }

    // turn with SaslAuthenticate of message written, its answer read as
    // kind.
    sent(turn: SessionTurn, kind: string, message: bytes) -> SessionTurn {
        s = turn.state;
        request = sasl.saslAuthenticateRequest(s.clientId, s.nextCorrelation, message);
        return copy(
            turn,
            state: dialogue.tracked(s, kind),
            write: <<turn.write: bytes, request: bytes>>
        );
    }

    loggedIn(turn: SessionTurn) -> SessionTurn {
        s = copy(turn.state, scramSignature: <<>>);
        if (s.role != "group") {
            return copy(turn, state: copy(s, phase: "broker"));
        }

        coordinator = consumerGroup.findCoordinatorRequest(s.clientId, s.nextCorrelation, s.group);
        return copy(
            turn,
            state: copy(dialogue.tracked(s, "coordinator"), phase: "finding"),
            write: <<turn.write: bytes, coordinator: bytes>>
        );
    }

    // A SaslAuthenticate v2 response: response header v1, then the error, its
    // message, and the mechanism's next message, COMPACT_BYTES. A refusal is
    // its error's name and the broker's message.
    readSaslAuthenticate(frame: bytes) -> Result<bytes, string> {
        return match (codec.afterTags(frame, 4)) {
            None -> Err(short()),
            afterHeader -> {
                return match (codec.i16At(frame, afterHeader)) {
                    None -> Err(short()),
                    code -> {
                        return match (codec.compactStringAt(frame, afterHeader + 2)) {
                            None -> Err(short()),
                            message -> {
                                if (code != 0) {
                                    if (message.text == "") {
                                        return Err(codec.errorName(code));
                                    }

                                    return Err("${codec.errorName(code)}: ${message.text}");
                                }

                                return match (codec.uvarintAt(frame, message.next)) {
                                    None -> Err(short()),
                                    size -> {
                                        if (size.value == 0) {
                                            return Ok(<<>>);
                                        }

                                        end = size.next + size.value - 1;
                                        if (end > frame.length()) {
                                            return Err(short());
                                        }

                                        return Ok(frame.slice(size.next, end));
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    short() -> string {
        return "a SaslAuthenticate response ends early";
    }

    // A SaslHandshake v1 response: why the broker won't take the mechanism,
    // with the ones it would, or Ok when it will.
    readSaslHandshake(frame: bytes, mechanism: string) -> Result<None, string> {
        return match (frame) {
            <<_: i32be, code: i16be, count: i32be, rest: bytes>> -> {
                if (code == 0) {
                    return Ok(None);
                }

                offered: List<string> = [];
                pos: int = 0;
                i: int = 0;
                while (i < count) {
                    match (codec.stringAt(rest, pos)) {
                        None -> {
                            return Err("a SaslHandshake response ends early");
                        },

                        name -> {
                            offered = append(offered, name.text);
                            pos = name.next;
                        }
                    }

                    i = i + 1;
                }

                if (code == 33) {
                    return Err(
                        "the broker doesn't take SASL ${mechanism}; it offers ${offered.join(", ")}"
                    );
                }

                return Err("SaslHandshake: ${codec.errorName(code)}");
            },

            _ -> Err("a SaslHandshake response is shorter than its header")
        }
    }
}
