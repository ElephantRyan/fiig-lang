// What the consumer's gateways ask of a com.degeneratedevelopment.kafka session (ADR 0117 §3-§5),
// as JSON. Request is a whole Kafka request, answered by its response with
// the request's own correlation id. The rest are a group session's: Poll
// waits for partitions to fetch, Advance records how far a fetch got (-1:
// start the partition again where the route's `from` says), and Ack and
// Retry settle one record, Retry seeking its partition back until resumeAt.
// Layout and Forget are a broker session's, for the producer (ADR 0113
// §4, as amended 2026-11-21): Layout answers with the topic's layout, kept
// for maxAgeMillis, and Forget drops it, after a produce that says the
// leaders moved.
enum KafkaAsk {
    Request(data: bytes),
    Poll(waitMillis: int),
    Advance(partition: int, next: int),
    Ack(partition: int, offset: int),
    Retry(partition: int, offset: int, resumeAt: int),
    Layout(topic: string, maxAgeMillis: int),
    Forget(topic: string)
}
