test aOneLineReply {
    expect readSmtpReply(wire("220 mail.example ESMTP ready\r\n")) is SmtpReplyRead.Done(reply, rest)
    expect reply == SmtpReply(code: 220, lines: ["mail.example ESMTP ready"])
    expect rest.length() == 0
}

test aReplyOfSeveralLines {
    expect readSmtpReply(wire("250-mail.example Hello\r\n250-STARTTLS\r\n250 SIZE 1000\r\n")) is SmtpReplyRead.Done(reply, rest)
    expect reply == SmtpReply(code: 250, lines: ["mail.example Hello", "STARTTLS", "SIZE 1000"])
}

test aBareCodeHasNoText {
    expect readSmtpReply(wire("250\r\n")) is SmtpReplyRead.Done(reply, rest)
    expect reply == SmtpReply(code: 250, lines: [""])
}

test whatFollowsTheReplyIsLeftAlone {
    expect readSmtpReply(wire("250 ok\r\n221 bye\r\n")) is SmtpReplyRead.Done(first, rest)
    expect first.code == 250
    expect readSmtpReply(rest) is SmtpReplyRead.Done(second, rest2)
    expect second.code == 221
}

test everyPartialReplyAsksForMore {
    whole = "250-a\r\n250-b\r\n250 c\r\n"
    cut: int = 0
    while cut < whole.length() {
        expect readSmtpReply(wire(whole.slice(0, cut))) is SmtpReplyRead.NeedMore
        cut = cut + 1
    }
    expect readSmtpReply(wire(whole)) is SmtpReplyRead.Done(reply, rest)
}

test aBareLfDoesNotEndALine {
    expect readSmtpReply(wire("220 hello\n")) is SmtpReplyRead.NeedMore
}

test malformedRepliesAreRefused {
    for bad in ["ABC hello\r\n", "22 short\r\n", "220hello\r\n", "999 out of range\r\n", "100 too low\r\n", "250-a\r\n251 changed\r\n"] {
        expect readSmtpReply(wire(bad)) is SmtpReplyRead.Malformed(reason)
    }
}

test aLineThatNeverEndsIsRefused {
    long = "220 ${repeated("x", 5000)}"
    expect readSmtpReply(wire(long)) is SmtpReplyRead.Malformed(reason)
}

test aReplyThatNeverEndsIsRefused {
    many: string = ""
    n: int = 0
    while n < 101 {
        many = "${many}250-line\r\n"
        n = n + 1
    }
    expect readSmtpReply(wire(many)) is SmtpReplyRead.Malformed(reason)
}

private {
    wire(text: string) -> bytes {
        return text.utf8()
    }

    repeated(piece: string, times: int) -> string {
        out: string = ""
        n: int = 0
        while n < times {
            out = "${out}${piece}"
            n = n + 1
        }
        return out
    }
}
