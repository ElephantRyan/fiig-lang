use acme.payments;
use acme.square.Square;
use acme.stripe.Stripe;
use checkout.core;
use checkout.core.LedgerApi;

// takePayment's providers are faked by name: the rule picks Stripe for a
// US merchant, and the ledger gets the reference Stripe returned. Square
// is faked too, since choosePaymentProvider can return it (ADR 0091 §4),
// and fails the test if it's reached.
test usMerchantChargesStripe {
    fake LedgerApi {
        gateway record(entry: string) -> Result<None, string> {
            expect entry == "charged o-1 as stripe:ch_1";
            return Ok(None);
        }
    }

    fake Stripe {
        gateway charge(request: payments.ChargeRequest) -> Result<string, string> {
            return Ok("stripe:ch_1");
        }
    }

    fake Square {
        gateway charge(request: payments.ChargeRequest) -> Result<string, string> {
            expect false;
            return Err("a US merchant never reaches Square");
        }
    }

    merchant = core.PayingMerchant(id: "m-1", inEurope: false);
    reference = takePayment(merchant, payments.ChargeRequest(orderId: "o-1", amount: 500));
    expect reference is Ok(id);
    expect id == "stripe:ch_1";
    expect calls(LedgerApi.record) == 1;
}
