test parseIsoAnOffsetIsFoldedIntoUtc {
    expect calendar.parseIso("2026-11-20T15:59:58+02:00") is Ok(ms);
    expect ms == 1795183198000;
}

test parseIsoANegativeOffset {
    expect calendar.parseIso("2026-11-20T08:29:58-05:30") is Ok(ms);
    expect ms == 1795183198000;
}

test parseIsoAFractionIsKept {
    expect calendar.parseIso("2026-11-20T13:59:58.5Z") is Ok(ms);
    expect ms == 1795183198500;
}

test parseIsoAFractionPastMillisecondsIsCut {
    expect calendar.parseIso("2026-11-20T13:59:58.123456789Z") is Ok(ms);
    expect ms == 1795183198123;
}

test parseIsoAShortFraction {
    expect calendar.parseIso("2026-11-20T13:59:58.07Z") is Ok(ms);
    expect ms == 1795183198070;
}

test parseIsoLowerCaseTAndZ {
    expect calendar.parseIso("2026-11-20t13:59:58z") is Ok(ms);
    expect ms == 1795183198000;
}

test parseIsoASpaceForTheT {
    expect calendar.parseIso("2026-11-20 13:59:58Z") is Ok(ms);
    expect ms == 1795183198000;
}

test parseIsoAnOffsetAcrossMidnight {
    expect calendar.parseIso("2026-11-21T01:59:58+12:00") is Ok(ms);
    expect ms == 1795183198000;
}

test parseIsoAnOffsetIntoThePreviousYear {
    expect calendar.parseIso("2027-01-01T00:30:00+01:00") is Ok(ms);
    expect ms == 1798759800000;
}

test parseIsoZeroOffset {
    expect calendar.parseIso("2026-11-20T13:59:58+00:00") is Ok(ms);
    expect ms == 1795183198000;
}

test parseIsoRefusesAnEmptyString {
    expect calendar.parseIso("") is Err(TimeError.Invalid(reason));
}

test parseIsoRefusesADateAlone {
    expect calendar.parseIso("2026-11-20") is Err(TimeError.Invalid(reason));
}

test parseIsoRefusesNoZone {
    expect calendar.parseIso("2026-11-20T13:59:58") is Err(TimeError.Invalid(reason));
}

test parseIsoRefusesAZoneWithoutAColon {
    expect calendar.parseIso("2026-11-20T13:59:58+0200") is Err(TimeError.Invalid(reason));
}

test parseIsoRefusesAWordForAZone {
    expect calendar.parseIso("2026-11-20T13:59:58UTC") is Err(TimeError.Invalid(reason));
}

test parseIsoRefusesALeapSecond {
    expect calendar.parseIso("2016-12-31T23:59:60Z") is Err(TimeError.Invalid(reason));
}

test parseIsoRefusesADayThatDoesNotExist {
    expect calendar.parseIso("2026-02-29T00:00:00Z") is Err(TimeError.Invalid(reason));
}

test parseIsoRefusesAMonthThatDoesNotExist {
    expect calendar.parseIso("2026-13-01T00:00:00Z") is Err(TimeError.Invalid(reason));
}

test parseIsoRefusesASignInAField {
    expect calendar.parseIso("2026-11-+0T13:59:58Z") is Err(TimeError.Invalid(reason));
}

test parseIsoRefusesALetterInAField {
    expect calendar.parseIso("2026-1a-20T13:59:58Z") is Err(TimeError.Invalid(reason));
}

test parseIsoRefusesAFractionWithNoDigits {
    expect calendar.parseIso("2026-11-20T13:59:58.Z") is Err(TimeError.Invalid(reason));
}

test parseIsoRefusesAWrongSeparator {
    expect calendar.parseIso("2026/11/20T13:59:58Z") is Err(TimeError.Invalid(reason));
}

test parseIsoRefusesAnOffsetHourOfTwentyFour {
    expect calendar.parseIso("2026-11-20T13:59:58+24:00") is Err(TimeError.Invalid(reason));
}

test parseIsoRefusesAnOffsetMinuteOfSixty {
    expect calendar.parseIso("2026-11-20T13:59:58+01:60") is Err(TimeError.Invalid(reason));
}

test parseIsoRefusesAnOffsetThatLeavesTheRange {
    expect calendar.parseIso("0000-01-01T00:00:00+05:00") is Err(TimeError.OutOfRange(reason));
}

test parseIsoNeverRepeatsTheText {
    expect calendar.parseIso("secret-9999") is Err(TimeError.Invalid(reason));
    expect reason.contains("secret") == false;
}

