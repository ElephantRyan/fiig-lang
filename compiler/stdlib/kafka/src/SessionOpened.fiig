use fiig.session

// ADR 0117 §3: a new connection of a fiig.kafka session. A broker session
// is ready at once. A group session asks ApiVersions first, so a broker
// older than KIP-848 is refused by name (§1), and FindCoordinator, so it
// can move to the broker that coordinates its group. Its member id is the
// session's id, which stays the same across reconnects, so the broker
// knows it for the same member.
conversion sessionOpened(settings: Map<string, string>, now: int) -> session.Step {
    s = KafkaSessionState(
        role: settings.atOr("role", "broker"),
        host: settings.atOr("host", ""),
        port: settings.atOr("port", "0").toIntOrNone() or 0,
        clientId: settings.atOr("clientId", "fiig"),
        group: settings.atOr("group", ""),
        topic: settings.atOr("topic", ""),
        memberId: settings.atOr("sessionId", ""),
        phase: "broker",
        fatal: "",
        nextCorrelation: 1,
        inflight: [],
        buffer: <<>>,
        epoch: 0,
        topicId: <<>>,
        heartbeatMillis: 5000,
        nextHeartbeatAt: now,
        heartbeatInFlight: false,
        commitMillis: settings.atOr("commitMillis", "1000").toIntOrNone() or 1000,
        commitAt: 0,
        partitions: [],
        polls: [],
    )
    if s.role != "group" {
        return sessionStep(SessionTurn(state: s, write: <<>>, replies: [], close: None), None)
    }
    versions = apiVersionsRequest(s.clientId, 1)
    coordinator = findCoordinatorRequest(s.clientId, 2, s.group)
    finding = copy(tracked(tracked(s, "versions"), "coordinator"), phase: "finding")
    return sessionStep(
        SessionTurn(state: finding, write: <<versions: bytes, coordinator: bytes>>, replies: [], close: None),
        None,
    )
}
