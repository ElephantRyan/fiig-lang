// SCRAM-SHA-256's client proof (RFC 5802 §3, RFC 7677), from the
// server's first message: the nonce it extended, the salt, and the
// iteration count, which may be at most 1,000,000 (ADR 0085 §6).
conversion computeScramFinal(
    password: bytes,
    clientFirstBare: string,
    clientNonce: string,
    serverFirst: string)
        -> Result<ScramFinal, string> {
    nonce: string = "";
    salt: bytes = <<>>;
    iterations: int = 0;
    for (part in serverFirst.split(",")) {
        if (part.startsWith("r=")) {
            nonce = part.removePrefix("r=");
        } else if (part.startsWith("s=")) {
            match (part.removePrefix("s=").fromBase64()) {
                None -> {
                    return Err("the server's SCRAM salt isn't base64");
                },

                decoded -> {
                    salt = decoded;
                },
            }
        } else if (part.startsWith("i=")) {
            match (part.removePrefix("i=").toIntOrNone()) {
                None -> {
                    return Err("the server's SCRAM iteration count isn't a number");
                },

                count -> {
                    iterations = count;
                },
            }
        }
    }

    if (!nonce.startsWith(clientNonce) || nonce.length() == clientNonce.length()) {
        return Err("the server's SCRAM nonce doesn't extend the client's");
    }

    if (salt.length() == 0) {
        return Err("the server sent no SCRAM salt");
    }

    if (iterations < 1 || iterations > 1000000) {
        return Err(
            "the server asks for ${iterations} SCRAM iterations; fiig.postgres allows 1 to 1000000",
        );
    }

    salted = crypto.pbkdf2Sha256(password, salt, iterations);
    clientKey = crypto.hmacSha256(salted, "Client Key".utf8());
    withoutProof = "c=biws,r=${nonce}";
    authMessage = "${clientFirstBare},${serverFirst},${withoutProof}".utf8();
    clientSignature = crypto.hmacSha256(crypto.sha256(clientKey), authMessage);
    proof = clientKey.xor(clientSignature);
    serverKey = crypto.hmacSha256(salted, "Server Key".utf8());
    return Ok(
        ScramFinal(
            message: "${withoutProof},p=${proof.toBase64()}",
            serverSignature: crypto.hmacSha256(serverKey, authMessage),
        ),
    );
}
