test formatHttpRefusesAMomentBeforeYearZero {
    expect formatHttp(-62167219200001) is Err(TimeError.OutOfRange(reason));
}

test formatHttpRefusesAMomentAfterYear9999 {
    expect formatHttp(253402300800000) is Err(TimeError.OutOfRange(reason));
}
