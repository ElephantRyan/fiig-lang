// ADR 0053: summing a field with a sequential `for` — `total: int = 0` is
// the typed declaration that makes `total` reassignable; each `Order` stays
// immutable and only the local name is rebound.
rule totalOfOrders(orders: List<Order>) -> int {
    total: int = 0
    for order in orders {
        total = total + order.total
    }
    return total
}
