// ADR 0006: cross-domain workflow composition. `?` only ever propagates an
// error unchanged, so it works fine within one domain (customer-service
// calling customer-service, order-processing calling order-processing) but
// not here — CustomerError and OrderError both have to become CheckoutError,
// and that reinterpretation must be an explicit match, not something `?`
// does silently.
workflow checkout(orderId: string, input: NewCustomer, total: int) -> Result<Order, CheckoutError> {
    return match (registerCustomer(input)) {
        Err(error) -> {
            return Err(CheckoutError.Customer(error)); // wrapped unchanged
        },

        Ok(found) -> {
            return match (placeOrder(orderId, found.id, total)) {
                Ok(order) -> {
                    return Ok(order);
                },

                Err(OrderError.InventoryUnavailable(_)) -> {
                    return Err(CheckoutError.OutOfStock); // reinterpreted
                },

                Err(error) -> {
                    return Err(CheckoutError.Order(error)); // wrapped unchanged
                },
            }
        },
    }
}
