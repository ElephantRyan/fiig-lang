test knownInstants {
    expect amzDate(0) == "19700101T000000Z"
    expect amzDate(1700000000000) == "20231114T221320Z"
    expect amzDate(951782400000) == "20000229T000000Z"
    expect amzDate(1709164800000) == "20240229T000000Z"
    expect amzDate(1767225599000) == "20251231T235959Z"
    expect amzDate(1767225600000) == "20260101T000000Z"
    expect amzDate(1700000000999) == "20231114T221320Z"
}

test aTimeBeforeTheEpochIsTheEpoch {
    expect amzDate(-5000) == "19700101T000000Z"
}

test theDayIsTheFirstEightCharacters {
    expect amzDate(1700000000000).slice(0, 8) == "20231114"
}
