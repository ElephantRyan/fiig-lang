// A fiig.kafka session's state (ADR 0117 §3), kept by the runtime as JSON
// between operations (ADR 0114 §4). role is "broker" or "group"; a group
// session's phase is "finding" its coordinator, then "member". buffer is
// what has arrived of a response not yet whole.
model KafkaSessionState {
    role: string
    host: string
    port: int
    clientId: string
    group: string
    topic: string
    memberId: string
    phase: string
    fatal: string
    nextCorrelation: int
    inflight: List<Inflight>
    buffer: bytes
    epoch: int
    topicId: bytes
    heartbeatMillis: int
    nextHeartbeatAt: int
    heartbeatInFlight: bool
    commitMillis: int
    commitAt: int
    partitions: List<OwnedPartition>
    polls: List<WaitingPoll>
}
