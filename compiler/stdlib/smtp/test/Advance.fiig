test aStartTlsSendFromGreetingToQuit {
    d0 = begin(startTls("user", "pass"), ["b@y.org", "c@y.org"]);
    expect sent(d0) == "listen";
    d1 = go(d0, 220, ["mail.example ESMTP"]);
    expect sent(d1) == "EHLO client.test\r\n";
    d2 = go(d1, 250, ["mail.example Hello", "STARTTLS", "AUTH PLAIN LOGIN", "SIZE 1000000"]);
    expect sent(d2) == "STARTTLS\r\n";
    d3 = go(d2, 220, ["Ready to start TLS"]);
    expect sent(d3) == "upgrade";
    // The handshake forgets what the server said, so it is asked again.
    d4 = afterUpgrade(d3);
    expect d4.secure;
    expect sent(d4) == "EHLO client.test\r\n";
    d5 = go(d4, 250, ["mail.example Hello", "AUTH PLAIN LOGIN"]);
    expect sent(d5) == "AUTH PLAIN AHVzZXIAcGFzcw==\r\n";
    d6 = go(d5, 235, ["Authentication successful"]);
    expect sent(d6) == "MAIL FROM:<a@x.org>\r\n";
    d7 = go(d6, 250, ["OK"]);
    expect sent(d7) == "RCPT TO:<b@y.org>\r\n";
    d8 = go(d7, 250, ["OK"]);
    expect sent(d8) == "RCPT TO:<c@y.org>\r\n";
    d9 = go(d8, 251, ["User not local; will forward"]);
    expect sent(d9) == "DATA\r\n";
    d10 = go(d9, 354, ["End data with <CR><LF>.<CR><LF>"]);
    expect sent(d10) == "the message";
    d11 = go(d10, 250, ["OK queued"]);
    // No QUIT: the connection is kept for the next mail.
    expect sent(d11) == "finish";
}

test aKeptConnectionStartsWithRset {
    d0 = resumeDialogue(
        startTls("user", "pass"),
        mail(["b@y.org"]),
        "client.test",
        "the message".utf8()
    );
    expect d0.secure;
    expect sent(d0) == "RSET\r\n";
    d1 = go(d0, 250, ["2.0.0 OK"]);
    expect sent(d1) == "MAIL FROM:<a@x.org>\r\n";
}

test aRefusedRsetEndsTheSend {
    d = resumeDialogue(plain(None, None), mail(["b@y.org"]), "client.test", "the message".utf8());
    expect !d.secure;
    expect advance(d, reply(421, ["4.4.2 Timeout"])) is Err(SmtpError.Refused(code, message));
    expect code == 421;
}

test aKeptConnectionIsOnlyForTheSameLogin {
    expect sessionFor(startTls("ann", "pass")) == "user=ann";
    expect sessionFor(startTls("bob", "pass")) == "user=bob";
    expect sessionFor(plain(None, None)) == "no login";
}

test aDeadKeptConnectionIsTriedAgainOnlyBeforeTheBody {
    kept = resumeDialogue(
        plain(None, None),
        mail(["b@y.org"]),
        "client.test",
        "the message".utf8()
    );
    closed = SmtpError.Socket(failure: SocketError.Closed);
    expect resendOnNewConnection(kept, closed);
    expect resendOnNewConnection(kept, SmtpError.Refused(code: 421, message: "closing"));
    expect !resendOnNewConnection(kept, SmtpError.Refused(code: 550, message: "no"));
    expect !resendOnNewConnection(kept, SmtpError.Protocol(reason: "malformed"));
    for (phase in [SmtpPhase.MailFrom, SmtpPhase.Rcpt, SmtpPhase.Data]) {
        expect resendOnNewConnection(copy(kept, phase: phase), closed);
    }

    // Once the message has been written the server may have it.
    expect !resendOnNewConnection(copy(kept, phase: SmtpPhase.Body), closed);
    expect !resendOnNewConnection(copy(kept, phase: SmtpPhase.Sent), closed);
}

test smtpWithoutStartTlsIsRefusedBeforeAnythingIsSent {
    hello = go(begin(startTls("user", "pass"), ["b@y.org"]), 220, ["hi"]);
    expect sent(hello) == "EHLO client.test\r\n";
    expect advance(hello, reply(250, ["mail.example Hello", "AUTH PLAIN"])) is Err(SmtpError.Protocol(reason));
    expect reason.contains("STARTTLS");
}

test smtpsIsSecureFromTheStartAndNeverAsksForStartTls {
    d = go(
        go(begin(implicit("user", "pass"), ["b@y.org"]), 220, ["hi"]),
        250,
        ["mail.example Hello", "STARTTLS", "AUTH PLAIN"]
    );
    expect d.secure;
    expect sent(d) == "AUTH PLAIN AHVzZXIAcGFzcw==\r\n";
}

test plainWithNoLoginGoesStraightToMail {
    d = go(go(begin(plain(None, None), ["b@y.org"]), 220, ["hi"]), 250, ["mail.example Hello"]);
    expect sent(d) == "MAIL FROM:<a@x.org>\r\n";
}

test aLoginNeedsAuthPlainOrAuthLogin {
    after = advance(afterGreeting(), reply(250, ["mail.example Hello", "STARTTLS"]));
    expect after is Ok(next);
    secured = afterUpgrade(next);
    expect advance(copy(secured, phase: SmtpPhase.SecureHello), reply(250, ["mail.example Hello", "AUTH XOAUTH2 CRAM-MD5"])) is Err(SmtpError.Protocol(reason));
    expect reason.contains("AUTH PLAIN");
    expect reason.contains("AUTH LOGIN");
}

test authLoginIsUsedWhenItIsAllTheServerOffers {
    d0 = go(
        go(begin(implicit("user", "pass"), ["b@y.org"]), 220, ["hi"]),
        250,
        ["mail.example Hello", "AUTH LOGIN XOAUTH2"]
    );
    expect sent(d0) == "AUTH LOGIN\r\n";
    // The server's prompts are Username: and Password: in base64.
    d1 = go(d0, 334, ["VXNlcm5hbWU6"]);
    expect sent(d1) == "dXNlcg==\r\n";
    d2 = go(d1, 334, ["UGFzc3dvcmQ6"]);
    expect sent(d2) == "cGFzcw==\r\n";
    d3 = go(d2, 235, ["Authentication successful"]);
    expect sent(d3) == "MAIL FROM:<a@x.org>\r\n";
}

test aRefusedAuthLoginPasswordEndsTheSend {
    d = go(
        go(
            go(
                go(begin(implicit("user", "pass"), ["b@y.org"]), 220, ["hi"]),
                250,
                ["Hello", "AUTH=LOGIN"]
            ),
            334,
            ["VXNlcm5hbWU6"]
        ),
        334,
        ["UGFzc3dvcmQ6"]
    );
    expect sent(d) == "cGFzcw==\r\n";
    expect advance(d, reply(535, ["5.7.8 Authentication credentials invalid"])) is Err(SmtpError.Refused(code, message));
    expect code == 535;
}

test authPlainIsPreferredWhenBothAreOffered {
    d = go(
        go(begin(implicit("user", "pass"), ["b@y.org"]), 220, ["hi"]),
        250,
        ["mail.example Hello", "AUTH LOGIN PLAIN"]
    );
    expect sent(d) == "AUTH PLAIN AHVzZXIAcGFzcw==\r\n";
}

test theOlderAuthEqualsFormIsRead {
    d = go(
        go(begin(implicit("user", "pass"), ["b@y.org"]), 220, ["hi"]),
        250,
        ["mail.example Hello", "AUTH=PLAIN LOGIN"]
    );
    expect sent(d) == "AUTH PLAIN AHVzZXIAcGFzcw==\r\n";
}

test xoauth2IsPreferredWhenATokenIsConfiguredAndOffered {
    d = go(
        go(begin(oauth(SmtpAuth.Auto, "pass"), ["b@y.org"]), 220, ["hi"]),
        250,
        ["smtp.gmail.com", "AUTH LOGIN PLAIN XOAUTH2 OAUTHBEARER"]
    );
    // user=ann@gmail.com, 0x01, auth=Bearer ya29.tok, 0x01 0x01.
    expect sent(d) == "AUTH XOAUTH2 dXNlcj1hbm5AZ21haWwuY29tAWF1dGg9QmVhcmVyIHlhMjkudG9rAQE=\r\n";
    expect sent(go(d, 235, ["2.7.0 Accepted"])) == "MAIL FROM:<a@x.org>\r\n";
}

test aRefusedTokenIsAnsweredAndItsStatusReported {
    d = go(
        go(begin(oauth(SmtpAuth.Auto, ""), ["b@y.org"]), 220, ["hi"]),
        250,
        ["Hello", "AUTH XOAUTH2"]
    );
    // {"status":"401","schemes":"Bearer","scope":"https://mail.google.com/"}
    challenge = go(
        d,
        334,
        [
            "eyJzdGF0dXMiOiI0MDEiLCJzY2hlbWVzIjoiQmVhcmVyIiwic2NvcGUiOiJodHRwczovL21haWwuZ29vZ2xlLmNvbS8ifQ=="
        ]
    );
    // The challenge is answered with an empty line; the server then refuses.
    expect sent(challenge) == "\r\n";
    expect advance(challenge, reply(535, ["5.7.8 Username and Password not accepted"])) is Err(SmtpError.Refused(code, message));
    expect code == 535;
    expect message == "the XOAUTH2 token (status 401): 5.7.8 Username and Password not accepted";
}

test aChallengeThatIsntJsonStillEndsInTheRefusal {
    d = go(
        go(begin(oauth(SmtpAuth.XOAuth2, ""), ["b@y.org"]), 220, ["hi"]),
        250,
        ["Hello", "AUTH XOAUTH2"]
    );
    challenge = go(d, 334, ["not base64!"]);
    expect sent(challenge) == "\r\n";
    expect advance(challenge, reply(535, ["no"])) is Err(SmtpError.Refused(code, message));
    expect message == "the XOAUTH2 token: no";
}

test aTokenWithoutXOAuth2FallsBackToThePassword {
    d = go(
        go(begin(oauth(SmtpAuth.Auto, "pass"), ["b@y.org"]), 220, ["hi"]),
        250,
        ["Hello", "AUTH PLAIN"]
    );
    expect sent(d) == "AUTH PLAIN AGFubkBnbWFpbC5jb20AcGFzcw==\r\n";
    // With no password, there is nothing else to log in with.
    tokenOnly = go(begin(oauth(SmtpAuth.Auto, ""), ["b@y.org"]), 220, ["hi"]);
    expect advance(tokenOnly, reply(250, ["Hello", "AUTH PLAIN"])) is Err(SmtpError.Protocol(reason));
    expect reason.contains("XOAUTH2");
}

test smtpAuthTakesOnlyTheMechanismItNames {
    greeted = go(begin(oauth(SmtpAuth.Login, "pass"), ["b@y.org"]), 220, ["hi"]);
    expect sent(go(greeted, 250, ["Hello", "AUTH PLAIN LOGIN XOAUTH2"])) == "AUTH LOGIN\r\n";
    plainOnly = copy(greeted, target: copy(greeted.target, auth: SmtpAuth.Plain));
    expect sent(go(plainOnly, 250, ["Hello", "AUTH PLAIN LOGIN XOAUTH2"])) == "AUTH PLAIN AGFubkBnbWFpbC5jb20AcGFzcw==\r\n";
    oauthOnly = copy(greeted, target: copy(greeted.target, auth: SmtpAuth.XOAuth2));
    expect advance(oauthOnly, reply(250, ["Hello", "AUTH PLAIN LOGIN"])) is Err(SmtpError.Protocol(reason));
    expect reason.contains("xoauth2");
}

test aRefusedRecipientEndsTheSend {
    d = go(
        go(
            go(go(begin(plain(None, None), ["b@y.org", "c@y.org"]), 220, ["hi"]), 250, ["Hello"]),
            250,
            ["OK"]
        ),
        250,
        ["OK"]
    );
    expect sent(d) == "RCPT TO:<c@y.org>\r\n";
    expect advance(d, reply(550, ["No such user here"])) is Err(SmtpError.Refused(code, message));
    expect code == 550;
    expect message.contains("c@y.org");
    expect message.contains("No such user");
}

test everyRecipientInToCcAndBccIsSentToOnce {
    m = Mail(
        from: "a@x.org",
        to: ["b@y.org"],
        subject: "s",
        body: "x",
        cc: ["c@y.org", "b@y.org"],
        bcc: ["d@y.org"]
    );
    expect recipientsOf(m) == ["b@y.org", "c@y.org", "d@y.org"];
    d = go(
        go(
            go(
                startDialogue(plain(None, None), m, "client.test", "the message".utf8()),
                220,
                ["hi"]
            ),
            250,
            ["Hello"]
        ),
        250,
        ["OK"]
    );
    expect sent(d) == "RCPT TO:<b@y.org>\r\n";
    expect sent(go(d, 250, ["OK"])) == "RCPT TO:<c@y.org>\r\n";
    // A refused Bcc recipient ends the send like any other.
    last = go(go(d, 250, ["OK"]), 250, ["OK"]);
    expect sent(last) == "RCPT TO:<d@y.org>\r\n";
    expect advance(last, reply(550, ["No such user"])) is Err(SmtpError.Refused(code, message));
    expect sent(go(last, 250, ["OK"])) == "DATA\r\n";
}

test aTemporaryRefusalKeepsItsCode {
    greeting = begin(plain(None, None), ["b@y.org"]);
    expect advance(greeting, reply(421, ["Service not available"])) is Err(SmtpError.Refused(code, message));
    expect code == 421;
    expect message == "Service not available";
}

test aRefusedSenderIsNamed {
    mailFrom = go(go(begin(plain(None, None), ["b@y.org"]), 220, ["hi"]), 250, ["Hello"]);
    expect sent(mailFrom) == "MAIL FROM:<a@x.org>\r\n";
    expect advance(mailFrom, reply(553, ["Sender rejected"])) is Err(SmtpError.Refused(code, message));
    expect code == 553;
    expect message.contains("a@x.org");
}

test aMessageOverTheServersSizeIsRefusedBeforeItIsSent {
    greeted = go(begin(plain(None, None), ["b@y.org"]), 220, ["hi"]);
    expect advance(greeted, reply(250, ["Hello", "SIZE 10"])) is Err(SmtpError.InvalidMail(reason));
    expect reason.contains("limit");
}

test aServerThatSaysNoToTheBodyRefuses {
    d = go(
        go(
            go(
                go(go(begin(plain(None, None), ["b@y.org"]), 220, ["hi"]), 250, ["Hello"]),
                250,
                ["OK"]
            ),
            250,
            ["OK"]
        ),
        354,
        ["go ahead"]
    );
    expect sent(d) == "the message";
    expect advance(d, reply(552, ["Message size exceeds limit"])) is Err(SmtpError.Refused(code, message));
    expect code == 552;
}

private {
    mail(to: List<string>) -> Mail {
        return Mail(from: "a@x.org", to: to, subject: "Hello", body: "Hi");
    }

    startTls(user: string, password: string) -> SmtpTarget {
        return SmtpTarget(
            host: "mail.example",
            port: 587,
            security: SmtpSecurity.StartTls,
            user: user,
            password: password
        );
    }

    implicit(user: string, password: string) -> SmtpTarget {
        return SmtpTarget(
            host: "mail.example",
            port: 465,
            security: SmtpSecurity.Implicit,
            user: user,
            password: password
        );
    }

    // smtps:// as ann@gmail.com with the token ya29.tok, and a password
    // too unless it is "".
    oauth(auth: SmtpAuth, password: string) -> SmtpTarget {
        target = SmtpTarget(
            host: "smtp.gmail.com",
            port: 465,
            security: SmtpSecurity.Implicit,
            user: "ann@gmail.com",
            password: None,
            auth: auth,
            token: "ya29.tok"
        );
        if (password == "") {
            return target;
        }

        return copy(target, password: password);
    }

    plain(user: string | None, password: string | None) -> SmtpTarget {
        return SmtpTarget(
            host: "localhost",
            port: 1025,
            security: SmtpSecurity.Plain,
            user: user,
            password: password
        );
    }

    begin(target: SmtpTarget, to: List<string>) -> Dialogue {
        return startDialogue(target, mail(to), "client.test", "the message".utf8());
    }

    afterGreeting() -> Dialogue {
        return copy(begin(startTls("user", "pass"), ["b@y.org"]), phase: SmtpPhase.Hello);
    }

    reply(code: int, lines: List<string>) -> SmtpReply {
        return SmtpReply(code: code, lines: lines);
    }

    // The dialogue after the server's reply, or the same one when advance
    // refuses it, so a test that expected progress sees none.
    go(d: Dialogue, code: int, lines: List<string>) -> Dialogue {
        return match (advance(d, reply(code, lines))) {
            Ok(next) -> next,
            Err(_) -> d
        }
    }

    // What the gateway does at this phase, as text.
    sent(d: Dialogue) -> string {
        return match (nextStep(d)) {
            SmtpStep.Listen -> "listen",
            SmtpStep.Upgrade -> "upgrade",
            SmtpStep.Send(data) -> textOf(data),
            SmtpStep.Finish -> "finish"
        }
    }

    textOf(data: bytes) -> string {
        return match (data.utf8()) {
            None -> "",
            text -> text
        }
    }
}
