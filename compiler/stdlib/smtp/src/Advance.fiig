// What the server's reply means for the dialogue (ADR 0120 §3): the next
// phase, or the reason the send ends. A reply that isn't the code the phase
// expects is the server refusing, whatever its text.
conversion advance(d: Dialogue, reply: SmtpReply) -> Result<Dialogue, SmtpError> {
    return match (d.phase) {
        SmtpPhase.Greeting -> expecting(d, reply, 220, SmtpPhase.Hello),
        SmtpPhase.Hello -> afterHello(d, reply),
        SmtpPhase.SecureHello -> afterHello(d, reply),
        SmtpPhase.StartTls -> expecting(d, reply, 220, SmtpPhase.Upgrading),
        SmtpPhase.Upgrading -> Err(
            SmtpError.Protocol(
                reason: "the server spoke while the connection was upgrading to TLS",
            ),
        ),
        SmtpPhase.Auth -> expecting(d, reply, 235, SmtpPhase.MailFrom),
        SmtpPhase.AuthLogin -> expecting(d, reply, 334, SmtpPhase.LoginUser),
        SmtpPhase.LoginUser -> expecting(d, reply, 334, SmtpPhase.LoginPassword),
        SmtpPhase.LoginPassword -> expecting(d, reply, 235, SmtpPhase.MailFrom),
        SmtpPhase.XOAuth2 -> afterXOAuth2(d, reply),
        SmtpPhase.XOAuth2Refused -> Err(refused(reply, "the XOAUTH2 token${d.oauthFailure}: ")),
        SmtpPhase.Reset -> expecting(d, reply, 250, SmtpPhase.MailFrom),
        SmtpPhase.MailFrom -> expectingStart(d, reply),
        SmtpPhase.Rcpt -> afterRecipient(d, reply),
        SmtpPhase.Data -> expecting(d, reply, 354, SmtpPhase.Body),
        SmtpPhase.Body -> expecting(d, reply, 250, SmtpPhase.Sent),
        SmtpPhase.Sent -> Ok(d),
    }
}

private {
    expecting(d: Dialogue, reply: SmtpReply, code: int, next: SmtpPhase)
            -> Result<Dialogue, SmtpError> {
        if (reply.code == code) {
            return Ok(copy(d, phase: next));
        }

        return Err(refused(reply, ""));
    }

    // MAIL FROM is accepted: the first recipient is next.
    expectingStart(d: Dialogue, reply: SmtpReply) -> Result<Dialogue, SmtpError> {
        if (reply.code == 250) {
            return Ok(copy(d, phase: SmtpPhase.Rcpt, recipient: 0));
        }

        return Err(refused(reply, "the sender ${d.mail.from}: "));
    }

    // One recipient is accepted (250 or 251): the next, or the message. Any
    // refused recipient ends the send, so a mail never goes to only some of
    // the people it is addressed to.
    afterRecipient(d: Dialogue, reply: SmtpReply) -> Result<Dialogue, SmtpError> {
        if (reply.code != 250 && reply.code != 251) {
            return Err(refused(reply, "the recipient ${d.recipients.at(d.recipient)}: "));
        }

        if (d.recipient + 1 < d.recipients.length()) {
            return Ok(copy(d, phase: SmtpPhase.Rcpt, recipient: d.recipient + 1));
        }

        return Ok(copy(d, phase: SmtpPhase.Data));
    }

    // XOAUTH2 accepted the token (235), or refused it: a 334 whose text is a
    // base64 JSON object saying why, which the client answers with an empty
    // line before the server's final refusal (§3b).
    afterXOAuth2(d: Dialogue, reply: SmtpReply) -> Result<Dialogue, SmtpError> {
        if (reply.code == 235) {
            return Ok(copy(d, phase: SmtpPhase.MailFrom));
        }

        if (reply.code == 334) {
            return Ok(copy(d, phase: SmtpPhase.XOAuth2Refused, oauthFailure: oauthStatus(reply)));
        }

        return Err(refused(reply, "the XOAUTH2 token: "));
    }

    // " (status 401)" from the challenge's JSON, or nothing when it can't be
    // read: the refusal that follows says the rest.
    oauthStatus(reply: SmtpReply) -> string {
        return match (reply.lines.join("").trim().fromBase64()) {
            None -> {
                return "";
            },

            raw -> {
                decoded: Result<XOAuth2Failure, JsonError> = json.decode(raw);
                return match (decoded) {
                    Err(_) -> {
                        return "";
                    },

                    Ok(failure) -> {
                        return match (failure.status) {
                            None -> {
                                return "";
                            },

                            status -> {
                                return " (status ${status})";
                            },
                        }
                    },
                }
            },
        }
    }

    // EHLO's reply lists what the server offers, a keyword a line after the
    // first. STARTTLS is required of smtp:// before anything is sent, and a
    // login before MAIL FROM when the URL has one (loginPhase).
    afterHello(d: Dialogue, reply: SmtpReply) -> Result<Dialogue, SmtpError> {
        if (reply.code != 250) {
            return Err(refused(reply, ""));
        }

        offers: List<string> = [];
        for (line in reply.lines.slice(1, reply.lines.length())) {
            offers = append(offers, line.uppercase());
        }

        size = sizeOffered(offers);
        if (size > 0 && d.data.length() > size) {
            return Err(
                SmtpError.InvalidMail(
                    reason: "the message is ${d.data.length()} bytes, over the server's limit of ${size}",
                ),
            );
        }

        learned = copy(
            d,
            startTls: offers.contains("STARTTLS"),
            authPlain: offersAuth(offers, "PLAIN"),
            authLogin: offersAuth(offers, "LOGIN"),
            authXOAuth2: offersAuth(offers, "XOAUTH2"),
            sizeLimit: size,
        );
        if (!d.secure && d.target.security == SmtpSecurity.StartTls) {
            if (learned.startTls) {
                return Ok(copy(learned, phase: SmtpPhase.StartTls));
            }

            return Err(
                SmtpError.Protocol(
                    reason: "the server doesn't offer STARTTLS, and smtp:// sends neither mail nor a password without TLS; use smtps://, or smtp+plain:// to send without it",
                ),
            );
        }

        return match (d.target.user) {
            None -> {
                return Ok(copy(learned, phase: SmtpPhase.MailFrom));
            },

            _ -> {
                return loginPhase(learned);
            },
        }
    }

    // The login SMTP_AUTH chooses among what the server offers. Auto takes
    // XOAUTH2 when there is a token and the server offers it, else AUTH
    // PLAIN, else AUTH LOGIN, which older Exchange servers offer alone; a
    // token is never sent where a password would go.
    loginPhase(d: Dialogue) -> Result<Dialogue, SmtpError> {
        chosen: SmtpAuth = SmtpAuth.Auto;
        match (d.target.auth) {
            None -> None,
            given -> {
                chosen = given;
            },
        }

        match (chosen) {
            SmtpAuth.XOAuth2 -> {
                if (d.authXOAuth2) {
                    return Ok(copy(d, phase: SmtpPhase.XOAuth2));
                }

                return Err(
                    notOffered("SMTP_AUTH is xoauth2, and the server doesn't offer AUTH XOAUTH2"),
                );
            },

            SmtpAuth.Plain -> {
                if (d.authPlain) {
                    return Ok(copy(d, phase: SmtpPhase.Auth));
                }

                return Err(
                    notOffered("SMTP_AUTH is plain, and the server doesn't offer AUTH PLAIN"),
                );
            },

            SmtpAuth.Login -> {
                if (d.authLogin) {
                    return Ok(copy(d, phase: SmtpPhase.AuthLogin));
                }

                return Err(
                    notOffered("SMTP_AUTH is login, and the server doesn't offer AUTH LOGIN"),
                );
            },

            SmtpAuth.Auto -> None,
        }

        if (d.target.token != None) {
            if (d.authXOAuth2) {
                return Ok(copy(d, phase: SmtpPhase.XOAuth2));
            }

            if (d.target.password == None) {
                return Err(
                    notOffered(
                        "the server doesn't offer AUTH XOAUTH2, and SMTP_URL has no password to log in with instead",
                    ),
                );
            }
        }

        if (d.authPlain) {
            return Ok(copy(d, phase: SmtpPhase.Auth));
        }

        if (d.authLogin) {
            return Ok(copy(d, phase: SmtpPhase.AuthLogin));
        }

        return Err(
            notOffered(
                "the server offers neither AUTH PLAIN nor AUTH LOGIN, which are what fiig.smtp logs in with",
            ),
        );
    }

    notOffered(reason: string) -> SmtpError {
        return SmtpError.Protocol(reason: reason);
    }

    // SIZE n, the largest message in bytes, or 0 when it isn't offered.
    sizeOffered(offers: List<string>) -> int {
        for (offer in offers) {
            if (offer.startsWith("SIZE ")) {
                match (offer.removePrefix("SIZE ").trim().toIntOrNone()) {
                    None -> None,
                    size -> {
                        return size;
                    },
                }
            }
        }

        return 0;
    }

    // Whether AUTH PLAIN LOGIN, or the older AUTH=PLAIN LOGIN, names the
    // mechanism.
    offersAuth(offers: List<string>, mechanism: string) -> bool {
        for (offer in offers) {
            if (offer.startsWith("AUTH ") || offer.startsWith("AUTH=")) {
                for (word in offer.removePrefix("AUTH").replaceAll("=", " ").split(" ")) {
                    if (word == mechanism) {
                        return true;
                    }
                }
            }
        }

        return false;
    }

    refused(reply: SmtpReply, about: string) -> SmtpError {
        return SmtpError.Refused(code: reply.code, message: "${about}${reply.lines.join(" ")}");
    }
}
