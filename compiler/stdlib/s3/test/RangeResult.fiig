use fiig.http;

test a206IsThePart {
    expect rangeResult(http.Reply(status: 206, headers: [], body: "ell".utf8()), 1, 3) is Ok(part);
    expect part == "ell".utf8();
}

test a416IsOutOfRange {
    expect rangeResult(http.Reply(status: 416, headers: [], body: <<>>), 10, None) is Err(S3Error.OutOfRange);
}

test aServerThatIgnoresRangeHasThePartCutFromTheWhole {
    whole = http.Reply(status: 200, headers: [], body: "hello".utf8());
    expect rangeResult(whole, 1, 3) is Ok(part);
    expect part == "ell".utf8();
    expect rangeResult(whole, 2, None) is Ok(rest);
    expect rest == "llo".utf8();
    expect rangeResult(whole, 3, 99) is Ok(tail);
    expect tail == "lo".utf8();
    expect rangeResult(whole, 5, None) is Err(S3Error.OutOfRange);
}

test anotherStatusIsTheRangesError {
    expect rangeResult(http.Reply(status: 404, headers: [], body: <<>>), 0, 1) is Err(S3Error.NotFound);
    expect rangeResult(http.Reply(status: 403, headers: [], body: <<>>), 0, 1) is Err(S3Error.Refused(status, code, message));
}
