test toDateTimeRefusesBeforeYearZero {
    expect calendar.toDateTime(-62167219200001) is Err(TimeError.OutOfRange(reason));
}

test toDateTimeRefusesAfterYear9999 {
    expect calendar.toDateTime(253402300800000) is Err(TimeError.OutOfRange(reason));
}

test toDateTimeSweepRoundTripsEveryFourYears {
    // About every four years and a bit across the whole range, the way back
    // from a reading is the moment it came from.
    at: int = -62167219200000;
    while (at <= 253402300799999) {
        expect calendar.toDateTime(at) is Ok(t);
        expect calendar.toMillis(t) is Ok(back);
        expect back == at;
        at = at + 126227704231;
    }
}

