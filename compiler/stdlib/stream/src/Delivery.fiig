// One element as the source delivered it (ADR 0111 §1). attempt is 1 the
// first time the group receives it, and one more after each Retry. order
// names the sequence it belongs to, such as a Kafka partition, or is "":
// after one element of a sequence is retried, the rest of that sequence in
// the same batch stay unsettled, since they come again after it (ADR 0117
// §6).
model Delivery {
    id: string
    payload: bytes
    attempt: int
    order: string
}
