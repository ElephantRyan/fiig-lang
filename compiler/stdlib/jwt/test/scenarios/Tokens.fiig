// ADR 0146 §4, §7: tokens Go's crypto signed, verified by fiig.jwt, and
// each way a token is refused. The keys were made for these tests and
// sign nothing else; signing and HMAC tokens are tested in Go
// (tooling/runprogram/jwt_test.go), since only a gateway makes a Secret.
test aTokenSignedWithEachKindOfKeyVerifies {
    for (token in [rs256(), rs512(), ps256(), es256(), edDsa(), rsa2()]) {
        expect verify(token, keys(), expectAll(), now()) is Ok(verified);
        expect verified.issuer == "https://issuer.example";
        expect verified.subject == "user-1";
        expect verified.audience == ["app"];
        expect verified.expiresAt == 1800000000000;
    }
}

test theKeyIdIsReadAndReported {
    expect verify(es256(), keys(), expectAll(), now()) is Ok(verified);
    expect verified.keyId == "ec-1";
    expect keyIdOf(es256()) == "ec-1";
    expect keyIdOf(noKid()) == None;
    expect keyIdOf("not a token") == None;
}

test aChangedPayloadIsABadSignature {
    expect verify(tampered(), keys(), expectAll(), now()) is Err(JwtError.BadSignature);
}

test theHeaderCantChooseAnAlgorithmTheProgramDidntName {
    expect verify(rs256(), keys(), expectOnly([Algorithm.ES256]), now()) is Err(JwtError.AlgorithmRefused("RS256"));
    // An empty list is the program forgetting to say, and refuses all.
    expect verify(rs256(), keys(), expectOnly([]), now()) is Err(JwtError.AlgorithmRefused("RS256"));
    // alg none isn't an Algorithm, so an unsigned token never verifies.
    expect verify(unsigned(), keys(), expectAll(), now()) is Err(JwtError.AlgorithmRefused("none"));
}

// CVE-2015-9235: HS256 with the RSA public key's PEM as the secret. verify
// refuses every HS alg, so a public key is never used as a secret.
test anHmacTokenIsNeverCheckedAgainstAPublicKey {
    both = expectOnly([Algorithm.HS256, Algorithm.RS256]);
    expect verify(hmacOverPublicKey(), keys(), both, now()) is Err(JwtError.AlgorithmRefused("HS256"));
}

test theKeyIsChosenByKid {
    // Signed by rsa-2 but naming rsa-1: rsa-1's key doesn't verify it.
    expect verify(rsa2NamingRsa1(), keys(), expectAll(), now()) is Err(JwtError.BadSignature);
    expect verify(unknownKid(), keys(), expectAll(), now()) is Err(JwtError.NoKey("unknown"));
    // No kid, and two RSA keys fit: which one the issuer meant is unknown.
    expect verify(noKid(), keys(), expectAll(), now()) is Err(JwtError.NoKey(None));
    expect verify(noKid(), [keys().first()], expectAll(), now()) is Ok(_);
}

test aKeyThatStatesAnotherAlgIsNotUsed {
    pinned = copy(keys().first(), algorithm: "RS256");
    expect verify(rs512(), [pinned], expectAll(), now()) is Err(JwtError.NoKey("rsa-1"));
    expect verify(rs256(), [pinned], expectAll(), now()) is Ok(_);
}

test theClaimsAreChecked {
    expect verify(wrongIssuer(), keys(), expectAll(), now()) is Err(JwtError.WrongIssuer("https://other.example"));
    expect verify(wrongAudiences(), keys(), expectAll(), now()) is Err(JwtError.WrongAudience(found));
    expect found == ["web", "cli"];
    expect verify(audiences(), keys(), expectAll(), now()) is Ok(_);
    expect verify(noExp(), keys(), expectAll(), now()) is Err(JwtError.MissingClaim("exp"));
    expect verify(noAud(), keys(), expectAll(), now()) is Err(JwtError.MissingClaim("aud"));
    expect verify(noIss(), keys(), expectAll(), now()) is Err(JwtError.MissingClaim("iss"));
    expect verify(textExp(), keys(), expectAll(), now()) is Err(JwtError.Malformed(_));
}

test expiryAndNotBeforeAllowTheLeeway {
    // Expired at exp plus 60 seconds, read to the millisecond.
    expect verify(timed(), keys(), expectAll(), 1800000060249) is Ok(verified);
    expect verified.expiresAt == 1800000000250;
    expect verified.issuedAt == 1799990000000;
    expect verify(timed(), keys(), expectAll(), 1800000060250) is Err(JwtError.Expired(1800000000250));
    expect verify(timed(), keys(), expectAll(), 1799989940000) is Ok(_);
    expect verify(timed(), keys(), expectAll(), 1799989939999) is Err(JwtError.NotYetValid(1799990000000));
    strict = copy(expectAll(), leewaySeconds: 0);
    expect verify(timed(), keys(), strict, 1800000000250) is Err(JwtError.Expired(_));
}

test theHeaderIsReadStrictly {
    expect verify(crit(), keys(), expectAll(), now()) is Err(JwtError.Malformed(reason));
    expect reason.contains("crit");
    // A duplicate member could mean one thing to fiig and another to the
    // issuer (RFC 7515 §5.2).
    expect verify(duplicateAlg(), keys(), expectAll(), now()) is Err(JwtError.Malformed(_));
    expect verify("a.b", keys(), expectAll(), now()) is Err(JwtError.Malformed(_));
    expect verify("a".repeat(16385), keys(), expectAll(), now()) is Err(JwtError.TooLarge);
}

test theTypeIsCheckedWhenAsked {
    expect verify(rs256(), keys(), copy(expectAll(), tokenType: "jwt"), now()) is Ok(_);
    expect verify(rs256(), keys(), copy(expectAll(), tokenType: "application/JWT"), now()) is Ok(_);
    expect verify(rs256(), keys(), copy(expectAll(), tokenType: "at+jwt"), now()) is Err(JwtError.WrongType("JWT"));
    expect verify(accessToken(), keys(), copy(expectAll(), tokenType: "at+jwt"), now()) is Ok(_);
}

test aTokenCanBeReadWithoutVerifying {
    expect decodeUnverified(es256()) is Ok(unverified);
    expect unverified.header == JsonValue.Object(members: ["alg": JsonValue.Text(value: "ES256"), "kid": JsonValue.Text(value: "ec-1"), "typ": JsonValue.Text(value: "JWT")]);
}

private {
    now() -> int {
        return 1799999000000;
    }

    expectAll() -> Expect {
        algorithms = [
            Algorithm.RS256,
            Algorithm.RS512,
            Algorithm.PS256,
            Algorithm.ES256,
            Algorithm.EdDSA
        ];
        return expectOnly(algorithms);
    }

    expectOnly(algorithms: List<Algorithm>) -> Expect {
        return Expect(issuer: "https://issuer.example", audience: "app", algorithms: algorithms);
    }

    keys() -> List<Jwk> {
        return match (keysFromJwks(jwks())) {
            Ok(given) -> given,
            Err(_) -> []
        }
    }

