// Type error: an int is not a string — no implicit conversion between
// primitives, even when the value would print the same way.
workflow lookupWrongId(orderNumber: int) -> Result<Customer, CustomerError> {
    return getCustomer(orderNumber) // rejected: getCustomer expects a string, not an int
}

// Type error: returning None where the declared type requires a Customer.
workflow returnAbsentCustomer(id: string) -> Result<Customer, CustomerError> {
    return Ok(None) // rejected: Result<Customer, ...> requires a Customer, not None
}

// Type error: a required model field is omitted at construction.
workflow buildIncompleteCustomer(id: string, name: string) -> Customer {
    return Customer(id: id, name: name) // rejected: Customer.email is required and not supplied
}

// Type error: relying on an implicit conversion between two distinct types.
rule greet(name: string) -> string {
    return "Hello, ${name}"
}

workflow useEmailAsName(customer: Customer) -> string {
    return greet(customer) // rejected: greet expects string; customer is a Customer, not a string — no implicit conversion
}

// Type error: a structurally-typed anonymous record used in a public
// signature — structural typing is only for anonymous *local* records (§3.3).
rule summarizeOrderShape(input: { id: string, total: int }) -> string {
    return "Order ${input.id}: ${input.total}" // rejected: public rule signature uses a structural type instead of a named model
}

// Type error (ADR 0004): a second conversion declared with the same name as
// an earlier one collides — Fiig has no overloading, so a repeated name is
// rejected regardless of the second declaration's own signature.
conversion orderToSummary(order: Order) -> CustomerSummary {
    return CustomerSummary(id: order.customerId, name: "")
}

conversion orderToSummary(customer: Customer) -> CustomerSummary { // rejected: second conversion named `orderToSummary`
    return CustomerSummary(id: customer.id, name: customer.name)
}

// Type error (bug class A7, ADR 0021): `newEmail` is unclaimed by the
// path, so PATCH binds it from the request body — but string is a
// primitive with no fields to decode against, so this skips structural
// decoding instead of performing it.
adapter http customerEmailApiBroken {
    PATCH "/customers/{id}" -> changeCustomerEmail(id: string, newEmail: string) // rejected: newEmail is body-bound but string isn't a model
}

// Type error (bug class A9): a match over a fully known type must cover
// every case. No arm names CustomerError.Invalid, and there's no catch-all
// arm to cover it either.
rule describeCustomerError(error: CustomerError) -> string {
    match error {
        CustomerError.NotFound(_) -> "not found"
        CustomerError.EmailAlreadyInUse(_) -> "email already in use"
    } // rejected: CustomerError.Invalid is never handled
}

// Type error (bug class A9): a match over an enum must cover every variant,
// not just error types — Region.APAC is never handled, and there's no
// catch-all arm to cover it either.
rule describeRegion(region: Region) -> string {
    match region {
        Region.US -> "United States"
        Region.EU -> "Europe"
    } // rejected: Region.APAC is never handled
}

// Type error: a concurrent block's inferred BatchResult doesn't match its
// workflow's declared one — getCustomer fails with CustomerError, not
// OrderError.
workflow retrieveCustomersWrongError(customerIds: List<string>) -> BatchResult<string, Customer, OrderError> {
    concurrent(customerId in customerIds):
        getCustomer(customerId) // rejected: produces BatchResult<string, Customer, CustomerError>, not ...OrderError
}
