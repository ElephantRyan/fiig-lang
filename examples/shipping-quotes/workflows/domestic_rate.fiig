// ADR 0080: the rate for a domestic parcel, with its speed read from the
// path (GET /rates/Express?weightGrams=1200). A domestic rate doesn't
// depend on the postcode.
workflow domesticRate(speed: Speed, weightGrams: int) -> Result<int, QuoteError> {
    return quoteCents(
        QuoteRequest(
            weightGrams: weightGrams,
            speed: speed,
            destination: Destination.Domestic(postcode: ""),
        ),
    );
}
