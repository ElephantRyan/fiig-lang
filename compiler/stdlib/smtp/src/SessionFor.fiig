// What the login leaves on a connection, which a kept one must match to
// send a mail (ADR 0109 §2, ADR 0120 §3a): a connection logged in as one
// user never sends as another.
conversion sessionFor(target: SmtpTarget) -> string {
    return match (target.user) {
        None -> "no login"
        name -> "user=${name}"
    }
}
