// Parse is partial; dispatch over the enum is total (ADR 0046 §3). The
// sentinels are business decisions and stay here. Codes and aliases are
// lookup facts and live on the enum, so this rule is the same size for 3
// clients or 2,500.
rule resolveDeductionSource(
    raw: string,
    tenant: Tenant,
) -> Result<DeductionSource, DeductionError> {
    if (raw == "DEFAULT") {
        return Ok(tenant.defaultSource);
    }

    if (raw == "OTHER") {
        return Err(DeductionError.UnsupportedSource(raw));
    }

    return match (DeductionSource(code: raw)) {
        None -> {
            return match (DeductionSource(aliases: raw)) {
                None -> Err(DeductionError.UnknownSource(raw)),
                found -> Ok(found),
            }
        },

        found -> Ok(found),
    }
}
