// A bulk or status reply as text, or None for anything else.
conversion textOf(reply: RespValue) -> string | None {
    return match (reply) {
        RespValue.Bulk(data) -> {
            return data.utf8();
        },

        RespValue.Simple(text) -> {
            return text;
        },

        _ -> {
            return None;
        },
    }
}
