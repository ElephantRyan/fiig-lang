use fiig.http
use fiig.http.HttpClient
use shop.kernel

// ADR 0079 §3: the same gateway after Payments became its own service.
// Its name and signature are unchanged, so submitOrder and every other
// caller are too; its requires line and this body are what changed.
// Payments answers its error enum whole (ADR 0072), so a 422 decodes
// straight into ChargeError, whose variants mirror PaymentError's.
gateway chargeOrder(order: string, amount: kernel.Money) -> Result<Charge, ChargeError>
        requires HttpClient {
    sent = HttpClient.send(
        http.Request(
            method: http.Method.Post,
            url: "${PaymentsService.url}/payments/${order}",
            headers: [http.Header(name: "Content-Type", value: "application/json")],
            body: json.encode(amount),
            timeoutMillis: 5000,
        ),
    );
    match (sent) {
        Err(_) -> Err(ChargeError.Unavailable(detail: "Payments is unreachable"))
        Ok(reply) -> {
            if (reply.status == 200) {
                receipt: Result<Charge, JsonError> = json.decode(reply.body);
                match (receipt) {
                    Ok(charge) -> Ok(charge)
                    Err(_) -> Err(
                        ChargeError.Unavailable(detail: "Payments' receipt didn't decode"),
                    )
                }
            } else if (reply.status == 422) {
                refusal: Result<ChargeError, JsonError> = json.decode(reply.body);
                match (refusal) {
                    Ok(error) -> Err(error)
                    Err(_) -> Err(
                        ChargeError.Unavailable(detail: "Payments' refusal didn't decode"),
                    )
                }
            } else {
                Err(ChargeError.Unavailable(detail: "Payments answered ${reply.status}"));
            }
        }
    }
}
