use fiig.stream;

// How many entries one receive may take (ADR 0111 §5a): no more than the
// runtime asked for, and no more than it can handle one after another
// before the first is reclaimed after retryAfter. When even one doesn't fit,
// no batch is safe, so the route halts naming the setting.
conversion fitBatch(batchSize: int, retryAfter: int, handleMillis: int)
        -> Result<int, stream.SourceError> {
    if (handleMillis <= 0) {
        return Ok(batchSize);
    }

    fits = retryAfter / handleMillis;
    if (fits < 1) {
        return Err(
            stream.SourceError.Misconfigured(
                reason: "REDIS_STREAM_RETRY_AFTER_MS is ${retryAfter}, but one element may take ${handleMillis} ms (its workflow's timeout and its settle), so another consumer would take it while it is still being handled; raise REDIS_STREAM_RETRY_AFTER_MS above ${handleMillis}"
            )
        );
    }

    if (fits < batchSize) {
        return Ok(fits);
    }

    return Ok(batchSize);
}
