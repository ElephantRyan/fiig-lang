// ADR 0110 §2: REDIS_URL read into a server. A reason never repeats the
// URL, which usually holds a password.
conversion parseRedisUrl(url: string) -> Result<RedisTarget, RedisError> {
    secure: bool = false;
    rest: string = "";
    if (url.startsWith("rediss://")) {
        secure = true;
        rest = url.removePrefix("rediss://");
    } else if (url.startsWith("redis://")) {
        rest = url.removePrefix("redis://");
    } else {
        return Err(invalid("it must start with redis:// or rediss://"));
    }

    if (rest.contains("?") || rest.contains("#")) {
        return Err(invalid("it has a query or a fragment, which fiig.redis doesn't read"));
    }

    pieces = rest.split("/");
    if (pieces.length() > 2) {
        return Err(invalid("its path is more than a database number"));
    }

    database: int = 0;
    if (pieces.length() == 2 && pieces.last() != "") {
        match (pieces.last().toIntOrNone()) {
            None -> {
                return Err(invalid("its database isn't a number"));
            },

            number -> {
                if (number < 0) {
                    return Err(invalid("its database is negative"));
                }

                database = number;
            }
        }
    }

    authority = pieces.first();
    hostPort: string = authority;
    user: string | None = None;
    password: string | None = None;
    signs = authority.split("@");
    if (signs.length() > 1) {
        hostPort = signs.last();
        parts = signs.slice(0, signs.length() - 1).join("@").split(":");
        if (parts.first() != "") {
            user = percentDecoded(parts.first())?;
        }

        if (parts.length() > 1) {
            password = percentDecoded(parts.slice(1, parts.length()).join(":"))?;
        }
    }

    host: string = hostPort;
    portText: string = "";
    if (hostPort.startsWith("[")) {
        bracket = hostPort.split("]");
        if (bracket.length() != 2) {
            return Err(invalid("its IPv6 host opens [ and never closes it"));
        }

        host = bracket.first().removePrefix("[");
        if (bracket.last() != "") {
            if (!bracket.last().startsWith(":")) {
                return Err(invalid("something other than a port follows its IPv6 host"));
            }

            portText = bracket.last().removePrefix(":");
        }
    } else {
        colons = hostPort.split(":");
        if (colons.length() > 2) {
            return Err(invalid("its host has more than one colon; write an IPv6 host in brackets"));
        }

        host = colons.first();
        if (colons.length() == 2) {
            portText = colons.last();
        }
    }

    if (host == "") {
        return Err(invalid("it has no host"));
    }

    port: int = 6379;
    if (portText != "") {
        match (portText.toIntOrNone()) {
            None -> {
                return Err(invalid("its port isn't a number"));
            },

            number -> {
                if (number < 1 || number > 65535) {
                    return Err(invalid("its port is outside 1 to 65535"));
                }

                port = number;
            }
        }
    }

    return Ok(
        RedisTarget(
            host: host,
            port: port,
            secure: secure,
            user: user,
            password: password,
            database: database
        )
    );
}

private {
    invalid(why: string) -> RedisError {
        return RedisError.InvalidUrl(reason: "REDIS_URL can't be read: ${why}");
    }

    // A user or password as a URL writes it, with %XX for each byte that
    // would otherwise end it, such as %40 for @.
    percentDecoded(text: string) -> Result<string, RedisError> {
        raw = text.utf8();
        out: bytes = <<>>;
        i: int = 0;
        while (i < raw.length()) {
            b = raw.at(i);
            if (b == 37) {
                if (i + 2 >= raw.length()) {
                    return Err(
                        invalid("a % in its user or password isn't followed by two hex digits")
                    );
                }

                high = hexValue(raw.at(i + 1));
                low = hexValue(raw.at(i + 2));
                if (high < 0 || low < 0) {
                    return Err(
                        invalid("a % in its user or password isn't followed by two hex digits")
                    );
                }

                out = <<out: bytes, high * 16 + low: u8>>;
                i = i + 3;
            } else {
                out = <<out: bytes, b: u8>>;
                i = i + 1;
            }
        }

        return match (out.utf8()) {
            None -> Err(invalid("its user or password isn't UTF-8 once decoded")),
            decoded -> Ok(decoded)
        }
    }

    hexValue(b: int) -> int {
        if (b >= 48 && b <= 57) {
            return b - 48;
        }

        if (b >= 65 && b <= 70) {
            return b - 55;
        }

        if (b >= 97 && b <= 102) {
            return b - 87;
        }

        return -1;
    }
}
