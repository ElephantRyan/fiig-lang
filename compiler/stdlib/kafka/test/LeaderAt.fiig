test thePartitionsLeader {
    layout = TopicLayout(
        brokers: [BrokerNode(id: 1, host: "a", port: 9092), BrokerNode(id: 2, host: "b", port: 9092)],
        leaders: [2, 1],
    )
    expect leaderAt(layout, 0) is Ok(leader)
    expect leader == BrokerNode(id: 2, host: "b", port: 9092)
    expect leaderAt(layout, 2) is Ok(None)
    expect leaderAt(layout, 0 - 1) is Ok(None)
}

test aLeaderMetadataDoesntListIsMalformed {
    layout = TopicLayout(brokers: [BrokerNode(id: 1, host: "a", port: 9092)], leaders: [3])
    expect leaderAt(layout, 0) is Err(KafkaError.MalformedReply(reason))
    expect reason.contains("leader 3")
}
