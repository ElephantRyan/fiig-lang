// ADR 0084 §1, §3: why a statement failed. After Server the connection is
// still usable and goes back to the pool; after Broken or Protocol the
// driver may have stopped mid-message, so the pool discards it. code is the
// SQLSTATE; constraint, table, and column say where a conflict is, when the
// server says (ADR 0087 §4).
enum DatabaseError {
    Server(code: string, message: string, constraint: string | None, table: string | None, column: string | None),
    Broken(failure: SocketError),
    Protocol(reason: string)
}
