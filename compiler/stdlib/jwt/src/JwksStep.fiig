use fiig.http;
use fiig.session;

// ADR 0146 §5: every rule of a key session, with jose's numbers. A set
// is refreshed by tick once it is 10 minutes old; an ask for a kid the set
// lacks fetches it again at once, unless the last fetch was under 30
// seconds ago; a fetch that fails keeps the old set for up to an hour past
// its 10 minutes, and then it is dropped and asks fail closed. One fetch
// is under way at a time: asks that arrive meanwhile wait for it.
conversion jwksStep(state: JwksState, event: JwksEvent, now: int) -> session.Step {
    s = aged(state, now);
    return match (event) {
        JwksEvent.Asked(message) -> asked(s, message, now),
        JwksEvent.Received(data) -> received(s, data, now),
        JwksEvent.Tick -> ticked(s, now),
        JwksEvent.Ended(reason) -> ended(s, reason, now)
    }
}

private {
    // A set this old is refreshed before anyone waits for it.
    maxAge() -> int {
        return 600000;
    }

    // At most one fetch per this long when it is asked for.
    cooldown() -> int {
        return 30000;
    }

    // A set kept this long past maxAge while its fetches fail.
    staleFor() -> int {
        return 3600000;
    }

    // A fetch with no full reply by then has failed.
    fetchTimeout() -> int {
        return 10000;
    }

    // The most a reply may be, headers and body (ADR 0074 §7a).
    maxReply() -> int {
        return 262144;
    }

    // The state without a set older than staleFor past maxAge.
    aged(s: JwksState, now: int) -> JwksState {
        return match (s.fetchedAt) {
            None -> s,
            at -> {
                if (now - at < maxAge() + staleFor()) {
                    return s;
                }

                keys: List<Jwk> = [];
                return copy(s, keys: keys, jwksUri: None, fetchedAt: None);
            }
        }
    }

    asked(state: JwksState, message: bytes, now: int) -> session.Step {
        key = state.nextKey;
        s = copy(state, nextKey: key + 1);
        decoded: Result<JwksAsk, JsonError> = json.decode(message);
        keyId = match (decoded) {
            Ok(ask) -> ask.keyId,
            Err(_) -> None
        }

        if (!wantsFetch(s, keyId)) {
            return step(s, <<>>, key, [reply(key, answerOf(s))], None, now);
        }

        waiting = copy(s, waiting: append(s.waiting, JwksWaiting(key: key)));
        if (s.fetching) {
            return step(waiting, <<>>, key, [], None, now);
        }

        if (mayFetch(s, now)) {
            return fetched(waiting, key, now);
        }

        return step(s, <<>>, key, [reply(key, answerOf(s))], None, now);
    }

    // Whether an ask needs a fetch: nothing usable yet, or a kid the set
    // doesn't have. A discovery document's answer has no kid to miss.
    wantsFetch(s: JwksState, keyId: string | None) -> bool {
        if (s.fetchedAt == None) {
            return true;
        }

        return match (keyId) {
            None -> false,
            wanted -> s.issuer == None && !hasKey(s.keys, wanted)
        }
    }

    hasKey(keys: List<Jwk>, keyId: string) -> bool {
        for (jwk in keys) {
            if (jwk.keyId == keyId) {
                return true;
            }
        }

        return false;
    }

    mayFetch(s: JwksState, now: int) -> bool {
        if (s.request.length() == 0) {
            return false;
        }

        return match (s.triedAt) {
            None -> true,
            at -> now - at >= cooldown()
        }
    }

    // A fetch starts: the GET is written, which opens the connection.
    fetched(s: JwksState, key: int | None, now: int) -> session.Step {
        started = copy(s, fetching: true, triedAt: now, reply: <<>>);
        return step(started, s.request, key, [], None, now);
    }

    received(s: JwksState, data: bytes, now: int) -> session.Step {
        if (!s.fetching) {
            return step(s, <<>>, None, [], None, now);
        }

        buffer = <<s.reply: bytes, data: bytes>>;
        return match (http.readReply(buffer, http.Method.Get, false, maxReply())) {
            http.ReplyRead.NeedMore -> step(copy(s, reply: buffer), <<>>, None, [], None, now),
            http.ReplyRead.Done(r, keep) -> finished(s, r, keep, now),
            http.ReplyRead.Malformed(reason) -> failed(
                s,
                "the reply is malformed: ${reason}",
                now,
                true
            ),
            http.ReplyRead.TooLarge -> failed(s, "the reply is over 256 KiB", now, true)
        }
    }

    ended(s: JwksState, reason: string, now: int) -> session.Step {
        if (!s.fetching) {
            return step(s, <<>>, None, [], None, now);
        }

        return match (http.readReply(s.reply, http.Method.Get, true, maxReply())) {
            http.ReplyRead.Done(r, _) -> finished(s, r, false, now),
            _ -> failed(s, "the connection ended before the reply did: ${reason}", now, false)
        }
    }

    ticked(s: JwksState, now: int) -> session.Step {
        if (s.fetching) {
            return match (s.triedAt) {
                None -> step(s, <<>>, None, [], None, now),
                at -> {
                    if (now - at >= fetchTimeout()) {
                        return failed(s, "no reply in 10 seconds", now, true);
                    }

                    return step(s, <<>>, None, [], None, now);
                }
            }
        }

        refresh = match (s.fetchedAt) {
            None -> false,
            at -> now - at >= maxAge()
        }

        if (refresh && mayFetch(s, now)) {
            return fetched(s, None, now);
        }

        return step(s, <<>>, None, [], None, now);
    }

    // A whole reply: a 200 with a document this session can read is the
    // new answer, and anything else fails the fetch. A redirect is not
    // followed: a key URL that moves is a configuration change.
    finished(s: JwksState, r: http.Reply, keep: bool, now: int) -> session.Step {
        if (r.status != 200) {
            return failed(s, "the server answered ${r.status}", now, !keep);
        }

        return match (s.issuer) {
            None -> keysRead(s, r.body, now, !keep),
            issuer -> discovered(s, issuer, r.body, now, !keep)
        }
    }

    keysRead(s: JwksState, body: bytes, now: int, close: bool) -> session.Step {
        return match (keysFromJwks(body)) {
            Ok(keys) -> done(copy(s, keys: keys, fetchedAt: now, failure: None), now, close),
            Err(JwtError.KeysUnavailable(reason)) -> failed(s, reason, now, close),
            Err(_) -> failed(s, "the key set can't be read", now, close)
        }
    }

    // OpenID Connect Discovery §4.3: the document's issuer must be the one
    // asked, or this issuer would be handed another's keys.
    discovered(s: JwksState, issuer: string, body: bytes, now: int, close: bool) -> session.Step {
        decoded: Result<JsonValue, JsonError> = json.decode(body);
        members = match (decoded) {
            Ok(JsonValue.Object(given)) -> given,
            _ -> {
                return failed(s, "the discovery document isn't a JSON object", now, close);
            }
        }

        if (textMember(members, "issuer") != issuer) {
            return failed(s, "the discovery document names another issuer", now, close);
        }

        return match (textMember(members, "jwks_uri")) {
            None -> failed(s, "the discovery document has no jwks_uri", now, close),
            uri -> done(copy(s, jwksUri: uri, fetchedAt: now, failure: None), now, close)
        }
    }

    done(s: JwksState, now: int, close: bool) -> session.Step {
        return answered(copy(s, fetching: false, reply: <<>>), now, close);
    }

    // A failed fetch keeps whatever set the session had (aged drops it
    // once it is too old), and says why.
    failed(s: JwksState, reason: string, now: int, close: bool) -> session.Step {
        return answered(copy(s, fetching: false, reply: <<>>, failure: reason), now, close);
    }

    // Every waiting ask gets the session's answer now.
    answered(s: JwksState, now: int, close: bool) -> session.Step {
        replies: List<session.SessionReply> = [];
        for (w in s.waiting) {
            replies = append(replies, reply(w.key, answerOf(s)));
        }

        waiting: List<JwksWaiting> = [];
        closing: session.SessionClose | None = None;
        if (close) {
            closing = session.SessionClose.Done(reason: "the fetch is over");
        }

        return step(copy(s, waiting: waiting), <<>>, None, replies, closing, now);
    }

    answerOf(s: JwksState) -> JwksAnswer {
        if (s.fetchedAt != None) {
            return JwksAnswer(keys: s.keys, jwksUri: s.jwksUri, failure: None);
        }

        keys: List<Jwk> = [];
        return JwksAnswer(keys: keys, jwksUri: None, failure: s.failure ?? "no keys fetched yet");
    }

    reply(key: int, answer: JwksAnswer) -> session.SessionReply {
        return session.SessionReply(key: key, message: json.encode(answer), last: true);
    }

    // The step, with the next tick: when a fetch under way times out, or
    // when the set is due a refresh (or, after a failed fetch, when the
    // cooldown allows another).
    step(
        s: JwksState,
        write: bytes,
        accepted: int | None,
        replies: List<session.SessionReply>,
        close: session.SessionClose | None,
        now: int)
            -> session.Step {
        tick: int | None = None;
        if (s.fetching) {
            tick = (s.triedAt ?? now) + fetchTimeout();
        } else {
            match (s.fetchedAt) {
                None -> None,
                at -> {
                    due: int = at + maxAge();
                    again = (s.triedAt ?? at) + cooldown();
                    if (again > due) {
                        due = again;
                    }

                    tick = due;
                }
            }
        }

        return session.Step(
            state: json.encode(s),
            write: write,
            accepted: accepted,
            replies: replies,
            nextTickAt: tick,
            close: close
        );
    }
}
