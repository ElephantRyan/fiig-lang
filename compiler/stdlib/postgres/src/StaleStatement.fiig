use fiig.sql as db;

// ADR 0085 §3b: the server no longer knows a cached statement as it was
// prepared: 26000, it has none by that name (a DEALLOCATE or DISCARD ALL
// the program ran), or 0A000 with the message pgx and PgJDBC also match,
// a schema change that altered its result columns.
conversion staleStatement(failed: db.DatabaseError | None) -> bool {
    return match (failed) {
        db.DatabaseError.Server(code, message, _, _, _) -> {
            return code == "26000" || (code == "0A000" && message.contains("cached plan must not change result type"));
        },

        _ -> {
            return false;
        }
    }
}
