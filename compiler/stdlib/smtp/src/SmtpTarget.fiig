// SMTP_URL read: where to connect, how it is secured, and the login. auth
// and token are SMTP_AUTH and SMTP_OAUTH_TOKEN (withLogin); None is Auto,
// and no token.
model SmtpTarget {
    host: string;
    port: int;
    security: SmtpSecurity;
    user: string | None;
    password: string | None;
    auth: SmtpAuth | None;
    token: string | None;
}
