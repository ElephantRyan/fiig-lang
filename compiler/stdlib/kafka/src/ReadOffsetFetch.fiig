// An OffsetFetch v1 response: each partition's committed offset, -1 when
// the group has committed none for it.
conversion readOffsetFetch(frame: bytes) -> Result<List<PartitionOffset>, string> {
    topics = need(i32At(frame, 4))?;
    pos: int = 8;
    out: List<PartitionOffset> = [];
    t: int = 0;
    while (t < topics) {
        name = textOf(stringAt(frame, pos))?;
        count = need(i32At(frame, name.next))?;
        pos = name.next + 4;
        i: int = 0;
        while (i < count) {
            partition = need(i32At(frame, pos))?;
            offset = need(i64At(frame, pos + 4))?;
            metadata = textOf(stringAt(frame, pos + 12))?;
            code = need(i16At(frame, metadata.next))?;
            if (code != 0) {
                return Err("OffsetFetch for partition ${partition}: ${errorName(code)}");
            }

            out = append(out, PartitionOffset(partition: partition, offset: offset));
            pos = metadata.next + 2;
            i = i + 1;
        }

        t = t + 1;
    }

    return Ok(out);
}

private {
    short() -> string {
        return "an OffsetFetch response ends early";
    }

    need(read: int | None) -> Result<int, string> {
        return match (read) {
            None -> {
                return Err(short());
            },

            found -> {
                return Ok(found);
            }
        }
    }

    textOf(read: TextAt | None) -> Result<TextAt, string> {
        return match (read) {
            None -> {
                return Err(short());
            },

            found -> {
                return Ok(found);
            }
        }
    }
}
