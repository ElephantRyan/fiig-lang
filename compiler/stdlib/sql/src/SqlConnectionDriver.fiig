// ADR 0084 §1a: SqlDriver for a driver that keeps state about each
// connection. The pool keeps the SqlConnection open returned, passes it to
// each execute, and keeps the one execute returns. When a call's deadline
// passes mid-statement, the pool calls cancel with the driver's settings
// and the connection's cancelKey, on a new connection, then discards the
// old one (§3a). A driver provides this or SqlDriver; the pool prefers
// this one. A program never calls it.
interface SqlConnectionDriver {
    open(settings: Map<string, string>) -> Result<SqlConnection, DatabaseError>;
    execute(on: SqlConnection, sql: string, values: List<SqlValue>) -> SqlRun;
    cancel(settings: Map<string, string>, key: bytes) -> None;
    close(connection: Connection) -> None;
}
