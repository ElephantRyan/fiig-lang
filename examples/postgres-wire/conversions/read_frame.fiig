// ADR 0058: Postgres frames every backend message as a type byte, an Int32
// length that counts itself but not the type byte, then length - 4 bytes.
// A buffer too short for the length it announces matches nothing, so
// `None` means "read more"; there is no bounds check to forget.
conversion readFrame(buffer: bytes) -> Frame | None {
    return match (buffer) {
        <<kind: u8, length: i32be, body: bytes(length - 4), rest: bytes>> -> Frame(
            kind: kind,
            body: body,
            rest: rest,
        ),
        _ -> None,
    }
}
