// ADR 0120 §2: SMTP_URL read into a target. smtp:// starts plain and must
// upgrade with STARTTLS (port 587), smtps:// is TLS from the first byte (465),
// and smtp+plain:// never uses TLS (25). A reason never repeats the URL,
// which usually holds a password.
conversion parseSmtpUrl(url: string) -> Result<SmtpTarget, SmtpError> {
    security: SmtpSecurity = SmtpSecurity.StartTls;
    port: int = 587;
    rest: string = "";
    if (url.startsWith("smtps://")) {
        security = SmtpSecurity.Implicit;
        port = 465;
        rest = url.removePrefix("smtps://");
    } else if (url.startsWith("smtp+plain://")) {
        security = SmtpSecurity.Plain;
        port = 25;
        rest = url.removePrefix("smtp+plain://");
    } else if (url.startsWith("smtp://")) {
        rest = url.removePrefix("smtp://");
    } else {
        return Err(invalid("it must start with smtp://, smtps://, or smtp+plain://"));
    }

    if (rest.contains("?") || rest.contains("#")) {
        return Err(invalid("it has a query or a fragment, which fiig.smtp doesn't read"));
    }

    pieces = rest.split("/");
    if (pieces.length() > 2 || pieces.length() == 2 && pieces.last() != "") {
        return Err(invalid("it has a path, which SMTP has no use for"));
    }

    authority = pieces.first();
    hostPort: string = authority;
    user: string | None = None;
    password: string | None = None;
    signs = authority.split("@");
    if (signs.length() > 1) {
        hostPort = signs.last();
        parts = signs.slice(0, signs.length() - 1).join("@").split(":");
        if (parts.first() != "") {
            user = percentDecoded(parts.first())?;
        }

        if (parts.length() > 1) {
            password = percentDecoded(parts.slice(1, parts.length()).join(":"))?;
        }
    }

    host: string = hostPort;
    portText: string = "";
    if (hostPort.startsWith("[")) {
        bracket = hostPort.split("]");
        if (bracket.length() != 2) {
            return Err(invalid("its IPv6 host opens [ and never closes it"));
        }

        host = bracket.first().removePrefix("[");
        if (bracket.last() != "") {
            if (!bracket.last().startsWith(":")) {
                return Err(invalid("something other than a port follows its IPv6 host"));
            }

            portText = bracket.last().removePrefix(":");
        }
    } else {
        colons = hostPort.split(":");
        if (colons.length() > 2) {
            return Err(invalid("its host has more than one colon; write an IPv6 host in brackets"));
        }

        host = colons.first();
        if (colons.length() == 2) {
            portText = colons.last();
        }
    }

    if (host == "") {
        return Err(invalid("it has no host"));
    }

    if (portText != "") {
        match (portText.toIntOrNone()) {
            None -> {
                return Err(invalid("its port isn't a number"));
            }

            number -> {
                if (number < 1 || number > 65535) {
                    return Err(invalid("its port is outside 1 to 65535"));
                }

                port = number;
            }
        }
    }

    if (password != None && user == None) {
        return Err(invalid("it has a password but no user"));
    }

    return Ok(
        SmtpTarget(host: host, port: port, security: security, user: user, password: password),
    );
}

private {
    invalid(why: string) -> SmtpError {
        return SmtpError.InvalidUrl(reason: "SMTP_URL can't be read: ${why}");
    }

    // A user or password as a URL writes it, with %XX for each byte that
    // would otherwise end it, such as %40 for @.
    percentDecoded(text: string) -> Result<string, SmtpError> {
        raw = text.utf8();
        out: bytes = <<>>;
        i: int = 0;
        while (i < raw.length()) {
            b = raw.at(i);
            if (b == 37) {
                if (i + 2 >= raw.length()) {
                    return Err(
                        invalid("a % in its user or password isn't followed by two hex digits"),
                    );
                }

                high = hexValue(raw.at(i + 1));
                low = hexValue(raw.at(i + 2));
                if (high < 0 || low < 0) {
                    return Err(
                        invalid("a % in its user or password isn't followed by two hex digits"),
                    );
                }

                out = <<out: bytes, high * 16 + low: u8>>;
                i = i + 3;
            } else {
                out = <<out: bytes, b: u8>>;
                i = i + 1;
            }
        }

        return match (out.utf8()) {
            None -> {
                return Err(invalid("its user or password isn't UTF-8 once decoded"));
            }

            decoded -> {
                return Ok(decoded);
            }
        }
    }

    hexValue(b: int) -> int {
        if (b >= 48 && b <= 57) {
            return b - 48;
        }

        if (b >= 65 && b <= 70) {
            return b - 55;
        }

        if (b >= 97 && b <= 102) {
            return b - 87;
        }

        return -1;
    }
}
