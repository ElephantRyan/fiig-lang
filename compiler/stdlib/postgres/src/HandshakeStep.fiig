use fiig.sql as db

// One backend message during startup (§6): authentication requests go to
// authStep, an error ends the handshake, ReadyForQuery finishes it, and
// ParameterStatus, BackendKeyData and notices are skipped.
conversion handshakeStep(state: Handshake, kind: int, body: bytes) -> Handshake {
    if kind == 69 {
        return copy(state, send: <<>>, failed: serverError(body))
    }
    if kind == 90 {
        if state.expectSignature.length() > 0 and not state.verified {
            return copy(
                state,
                send: <<>>,
                failed: db.DatabaseError.Protocol(reason: "the server finished without proving it knows the password"),
            )
        }
        return copy(state, send: <<>>, ready: true)
    }
    if kind != 82 {
        return copy(state, send: <<>>)
    }
    match body {
        <<code: i32be, data: bytes>> -> {
            return authStep(state, code, data)
        }
        _ -> {
            return copy(
                state,
                send: <<>>,
                failed: db.DatabaseError.Protocol(reason: "an authentication message is too short"),
            )
        }
    }
}
