// Whether the server accepted the commands that set up a new connection,
// every reply but the last (ADR 0110 §3). A connection whose AUTH or
// SELECT was refused isn't what its session says, so it isn't kept.
conversion setupAccepted(replies: List<RespValue>) -> bool {
    for reply in replies.slice(0, replies.length() - 1) {
        match reply {
            RespValue.Error(_) -> {
                return false
            }
            _ -> None
        }
    }
    return true
}
