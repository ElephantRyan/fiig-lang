// turn with a group member's heartbeat when it is due, one at a time, and
// its commit when the commit interval since the first unsent ack is up.
conversion dueWork(turn: SessionTurn, now: int) -> SessionTurn {
    out: SessionTurn = turn
    s = turn.state
    if s.role != "group" or s.phase != "member" or s.fatal != "" {
        return out
    }
    if not s.heartbeatInFlight and s.nextHeartbeatAt <= now {
        owned: List<int> = []
        for p in s.partitions {
            owned = append(owned, p.partition)
        }
        request = heartbeatRequest(
            s.clientId,
            s.nextCorrelation,
            s.group,
            s.memberId,
            s.epoch,
            s.topic,
            s.topicId,
            owned,
        )
        out = copy(
            out,
            state: copy(tracked(s, "heartbeat"), heartbeatInFlight: true),
            write: <<out.write: bytes, request: bytes>>,
        )
    }
    if out.state.commitAt > 0 and out.state.commitAt <= now {
        out = commitAll(out)
    }
    return out
}
