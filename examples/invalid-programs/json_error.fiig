// ADR 0073 §8: J1, json.decode into a type JSON can't carry. A JSON
// object's names are strings, so a Map read from one needs string keys.
// Two declarations in one file, so G1 also fires, incidentally but
// correctly.
rule readCounts(body: string) -> Result<Map<int, int>, JsonError> {
    return json.decode(body)
}

// §7b: J2, two fields reading one JSON member. Decoding would fill both
// from "type", and encoding would send "type" twice.
model Upload {
    contentType: string from json "type"
    type: string
}

// ADR 0080 §1: J2 for an enum, two variants with one spelling. Reading
// "sent" couldn't say which variant it is.
enum ShipmentState {
    Sent from json "sent"
    Delivered from json "sent"
}
