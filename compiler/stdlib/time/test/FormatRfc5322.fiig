test formatRfc5322RefusesAMomentBeforeYearZero {
    expect formatRfc5322(-62167219200001) is Err(TimeError.OutOfRange(reason))
}

test formatRfc5322RefusesAMomentAfterYear9999 {
    expect formatRfc5322(253402300800000) is Err(TimeError.OutOfRange(reason))
}
