// ADR 0110 §3 for a pipeline: the connection can serve another call when
// no command in it changes the connection, by keepsConnection's list. A
// name that isn't text is no command Redis has, so it isn't trusted.
conversion pipelineKeeps(commands: List<List<bytes>>) -> bool {
    for (words in commands) {
        match (words.first().utf8()) {
            None -> {
                return false;
            },

            name -> {
                if (!keepsConnection(name)) {
                    return false;
                }
            }
        }
    }

    return true;
}
