// ADR 0060: what the Socket primitive does not allow. Two declarations in
// one file, so G1 also fires, incidentally but correctly. B10: only a
// gateway that requires Socket may call it, and a rule is pure.
rule peekAtDatabase(host: string) -> Result<Connection, SocketError> {
    return Socket.connect(host, 5432)
}

// H5: a workflow is the adapter boundary, and a socket handle can be neither
// serialized nor handed in from outside.
workflow resumeSession(connection: Connection) -> Result<None, SocketError> {
    return Ok(None)
}
