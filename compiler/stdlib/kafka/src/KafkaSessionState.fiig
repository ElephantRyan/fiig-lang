// A fiig.kafka session's state (ADR 0117 §3), kept by the runtime as JSON
// between operations (ADR 0114 §4). role is "broker" or "group"; a group
// session's phase is "finding" its coordinator, then "member", and a
// broker session's "opening" until ApiVersions answers, then "broker".
// buffer is what has arrived of a response not yet whole. layouts are the
// topics' layouts a broker session keeps for the producer, and refused
// why it can't send the producer's versions (ADR 0113 §4, as amended
// 2026-11-21). With SASL, either is "authenticating" first, and the scram
// fields carry SCRAM's exchange between its messages; a group session
// whose login was refused is "refused" (ADR 0113 §6, as amended
// 2026-11-21).
model KafkaSessionState {
    role: string;
    host: string;
    port: int;
    clientId: string;
    group: string;
    topic: string;
    memberId: string;
    phase: string;
    fatal: string;
    nextCorrelation: int;
    inflight: List<Inflight>;
    buffer: bytes;
    epoch: int;
    topicId: bytes;
    heartbeatMillis: int;
    nextHeartbeatAt: int;
    heartbeatInFlight: bool;
    commitMillis: int;
    commitAt: int;
    partitions: List<OwnedPartition>;
    polls: List<WaitingPoll>;
    layouts: List<CachedLayout>;
    refused: KafkaError | None;
    scramNonce: string;
    scramFirstBare: string;
    scramSignature: bytes;
}
