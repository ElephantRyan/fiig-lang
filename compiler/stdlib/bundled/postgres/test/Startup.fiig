use com.degeneratedevelopment.postgres.startup;

// RFC 7677 §3's SCRAM-SHA-256 example, end to end.
test scramMatchesRfc7677 {
    expect startup.computeScramFinal("pencil".utf8(), "n=user,r=rOprNGfwEbeRWgbNEkqO", "rOprNGfwEbeRWgbNEkqO", "r=rOprNGfwEbeRWgbNEkqO%hvYDpWUa2RaTCAfuxFIlj)hNlF$k0,s=W22ZaJ0SNY7soEsUEjb6gQ==,i=4096") is Ok(final);
    expect final.message == "c=biws,r=rOprNGfwEbeRWgbNEkqO%hvYDpWUa2RaTCAfuxFIlj)hNlF$k0,p=dHzbZapWIk4jUhN+Ute9ytag9zjfMHgsqmmiz7AndVQ=";
    expect final.serverSignature.toBase64() == "6rriTRBi23WpRR/wtup+mMhUZUn/dB5nLTJRsjl95G4=";
}

test scramRefusesANonceThatIsNotOurs {
    expect startup.computeScramFinal("pw".utf8(), "n=,r=abc", "abc", "r=someoneElse,s=W22ZaJ0SNY7soEsUEjb6gQ==,i=4096") is Err(_);
}

test scramRefusesTooManyIterations {
    expect startup.computeScramFinal("pw".utf8(), "n=,r=abc", "abc", "r=abcEXTRA,s=W22ZaJ0SNY7soEsUEjb6gQ==,i=5000000") is Err(_);
}

test scramRefusesAServerFirstWithNoSalt {
    expect startup.computeScramFinal("pw".utf8(), "n=,r=abc", "abc", "r=abcEXTRA,i=4096") is Err(_);
}
