gateway findSession(token: string) -> Result<Account, AccountError>
    requires Database
    idempotent
{
    row = Database.queryOne(
        "SELECT accounts.name, accounts.email FROM sessions JOIN accounts ON accounts.name = sessions.name WHERE sessions.token = ?",
        token,
    )
    match row {
        found -> Ok(Account(name: found.name, email: found.email))
        None -> Err(AccountError.NoSession)
    }
}
