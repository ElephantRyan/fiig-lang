use fiig.sql as db;

// ADR 0085 §3b: the statement cache after a reply to plan. A statement
// whose Parse completed is prepared; one whose Parse didn't (a syntax
// error, a failed transaction) doesn't exist on the server and leaves the
// cache; one the server no longer knows as cached (staleStatement) is
// marked to be parsed again.
conversion settleStatement(plan: StatementPlan, reply: Reply) -> db.SqlConnection {
    if (plan.name == "") {
        return plan.connection;
    }

    kept: List<db.SqlStatement> = [];
    for (statement in plan.connection.statements) {
        if (statement.name != plan.name) {
            kept = append(kept, statement);
        } else if (plan.parsing) {
            if (reply.parsed) {
                kept = append(kept, copy(statement, prepared: true));
            }
        } else if (staleStatement(reply.failed)) {
            kept = append(kept, copy(statement, prepared: false));
        } else {
            kept = append(kept, statement);
        }
    }

    return copy(plan.connection, statements: kept);
}
