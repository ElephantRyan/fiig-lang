// Kept beside Client, the one capability that uses it: the two version in
// lockstep, since changing the type breaks the capability (ADR 0043 §2).
// authorization is the Authorization header's value, when the API wants
// one; the gateway that builds the request reveals its key into it (ADR
// 0071 §4).
model WebRequest {
    host: string;
    path: string;
    body: string;
    authorization: string | None;
}
