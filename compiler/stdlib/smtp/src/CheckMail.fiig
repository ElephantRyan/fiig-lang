// A mail that can be sent as written (ADR 0120 §2, §2a). Addresses go into
// protocol lines and headers, so a line break or a space in one could write
// a command or a header of the caller's choosing; they're refused instead,
// and so is a display name with a line break, and an attachment whose name
// or type could end a header (§2b). The reasons say which address or
// attachment, never what it said.
conversion checkMail(mail: Mail) -> Result<None, SmtpError> {
    if not validAddress(mail.from) {
        return Err(
            SmtpError.InvalidMail(reason: "the sender isn't an address: one @, no spaces, no quotes, angle brackets, or non-ASCII"),
        )
    }
    cc = listOf(mail.cc)
    bcc = listOf(mail.bcc)
    count = mail.to.length() + cc.length() + bcc.length()
    if count == 0 {
        return Err(
            SmtpError.InvalidMail(reason: "a mail has at least one recipient, in to, cc, or bcc"),
        )
    }
    if count > 100 {
        return Err(
            SmtpError.InvalidMail(reason: "a mail has at most 100 recipients, to, cc, and bcc together"),
        )
    }
    checkList(mail.to, "recipient")?
    checkList(cc, "cc recipient")?
    checkList(bcc, "bcc recipient")?
    // Every address the mail has, which are the ones a display name may be
    // given for (a Bcc recipient's is allowed, and never written).
    known: List<string> = append(recipientsOf(mail), mail.from)
    match mail.replyTo {
        None -> None
        address -> {
            if not validAddress(address) {
                return Err(
                    SmtpError.InvalidMail(reason: "the reply-to address isn't an address: one @, no spaces, no quotes, angle brackets, or non-ASCII"),
                )
            }
            known = append(known, address)
        }
    }
    match mail.names {
        None -> None
        names -> {
            for address in names.keys() {
                if not known.contains(address) {
                    return Err(
                        SmtpError.InvalidMail(reason: "a display name is given for an address the mail doesn't have"),
                    )
                }
                checkName(names.at(address))?
            }
        }
    }
    if mail.subject.contains("\r") or mail.subject.contains("\n") {
        return Err(SmtpError.InvalidMail(reason: "the subject has a line break"))
    }
    if mail.subject.utf8().length() > 900 {
        return Err(SmtpError.InvalidMail(reason: "the subject is longer than 900 bytes"))
    }
    match mail.attachments {
        None -> None
        attachments -> {
            number: int = 1
            for attachment in attachments {
                checkAttachment(attachment, number)?
                number = number + 1
            }
        }
    }
    return Ok(None)
}

private {
    // An attachment's name and type go into its part's headers (§2b): a name
    // is any text but a control character, of at most 200 bytes, and a type
    // is type/subtype in MIME's token characters, with no parameters, so
    // neither can end a header line or add one.
    checkAttachment(attachment: Attachment, number: int) -> Result<None, SmtpError> {
        raw = attachment.name.utf8()
        if raw.length() == 0 or raw.length() > 200 {
            return Err(
                SmtpError.InvalidMail(reason: "attachment ${number}'s name is empty or longer than 200 bytes"),
            )
        }
        for b in raw {
            if b < 32 or b == 127 {
                return Err(
                    SmtpError.InvalidMail(reason: "attachment ${number}'s name has a line break or another control character"),
                )
            }
        }
        halves = attachment.contentType.split("/")
        if halves.length() != 2 or not mimeToken(halves.first()) or not mimeToken(halves.last()) {
            return Err(
                SmtpError.InvalidMail(reason: "attachment ${number}'s content type isn't type/subtype, such as application/pdf"),
            )
        }
        return Ok(None)
    }

    // RFC 2045 §5.1's token: printable ASCII but space and ( ) < > @ , ; : \ " / [ ] ? =.
    mimeToken(text: string) -> bool {
        raw = text.utf8()
        if raw.length() == 0 or raw.length() > 127 {
            return false
        }
        for b in raw {
            if b <= 32 or b >= 127 {
                return false
            }
            if b == 34 or b == 40 or b == 41 or b == 44 or b == 47 or b == 58 or b == 59 or b == 60 or b == 61 or b == 62 or b == 63 or b == 64 or b == 91 or b == 92 or b == 93 {
                return false
            }
        }
        return true
    }

    listOf(addresses: List<string> | None) -> List<string> {
        match addresses {
            None -> []
            given -> given
        }
    }

    // Each address in a list, named by its kind and its position from 1.
    checkList(addresses: List<string>, kind: string) -> Result<None, SmtpError> {
        number: int = 1
        for address in addresses {
            if not validAddress(address) {
                return Err(
                    SmtpError.InvalidMail(reason: "${kind} ${number} isn't an address: one @, no spaces, no quotes, angle brackets, or non-ASCII"),
                )
            }
            number = number + 1
        }
        return Ok(None)
    }

    // A display name is any text but a control character, a line break
    // among them; MailData quotes or encodes the rest.
    checkName(name: string) -> Result<None, SmtpError> {
        raw = name.utf8()
        if raw.length() > 200 {
            return Err(SmtpError.InvalidMail(reason: "a display name is longer than 200 bytes"))
        }
        for b in raw {
            if b < 32 or b == 127 {
                return Err(
                    SmtpError.InvalidMail(reason: "a display name has a line break or another control character"),
                )
            }
        }
        return Ok(None)
    }

    // local@domain in plain ASCII: exactly one @ with something on each
    // side, and none of the characters that end or quote an address.
    validAddress(text: string) -> bool {
        raw = text.utf8()
        if raw.length() < 3 or raw.length() > 254 {
            return false
        }
        ats: int = 0
        at: int = -1
        i: int = 0
        while i < raw.length() {
            b = raw.at(i)
            if b <= 32 or b >= 127 {
                return false
            }
            if b == 34 or b == 40 or b == 41 or b == 44 or b == 58 or b == 59 or b == 60 or b == 62 or b == 91 or b == 92 or b == 93 {
                return false
            }
            if b == 64 {
                ats = ats + 1
                at = i
            }
            i = i + 1
        }
        return ats == 1 and at > 0 and at < raw.length() - 1
    }
}
