use fiig.sql as db;
use com.degeneratedevelopment.postgres.startup;
use com.degeneratedevelopment.postgres.statements;
use com.degeneratedevelopment.postgres.wire;

// ADR 0085: a Postgres driver written in fiig, the frontend side of
// protocol 3.0 over Socket. The runtime pools its connections, keeps each
// one's SqlConnection between calls, and sends BEGIN, COMMIT and ROLLBACK
// through execute (ADR 0084 §1a); a program only calls Database. Each
// step of the protocol is a conversion, so these gateways only move bytes.
capability Postgres provides db.SqlConnectionDriver {
    // §2, §5, §6: connect, ask for TLS in-band, send the startup message,
    // and authenticate until the server is ready for a query. The server's
    // BackendKeyData becomes the connection's cancelKey (ADR 0084 §3a).
    gateway open(settings: Map<string, string>) -> Result<db.SqlConnection, db.DatabaseError>
            requires Socket {
        pg = startup.readSettings(settings)?;
        connection: Connection = wire.connectionOr(Socket.connect(pg.host, pg.port))?;
        if (pg.secure) {
            wire.writtenOr(Socket.write(connection, <<8: i32be, 80877103: i32be>>))?;
            answer = wire.bytesOr(Socket.read(connection))?;
            if (answer.length() != 1 || answer.at(0) != 83) {
                return Err(
                    db.DatabaseError.Protocol(
                        reason: "the server at ${pg.host} doesn't offer TLS; set sslmode to disable to connect without it"
                    )
                );
            }

            connection = wire.connectionOr(Socket.startTls(connection, pg.host))?;
        }

        wire.writtenOr(Socket.write(connection, startup.startupMessage(pg)))?;
        nonce = Random.bytes(18).toBase64();
        state: Handshake = Handshake(
            settings: pg,
            clientNonce: nonce,
            clientFirstBare: "n=,r=${nonce}",
            expectSignature: <<>>,
            verified: false,
            send: <<>>,
            failed: None,
            ready: false,
            cancelKey: <<>>
        );
        buffer: bytes = <<>>;
        while (true) {
            match (wire.nextFrame(buffer)) {
                None -> {
                    chunk = wire.bytesOr(Socket.read(connection))?;
                    buffer = <<buffer: bytes, chunk: bytes>>;
                },

                frame -> {
                    buffer = frame.rest;
                    state = startup.handshakeStep(state, frame.kind, frame.body);
                    match (state.failed) {
                        None -> None,
                        failure -> {
                            return Err(failure);
                        }
                    }

                    if (state.ready) {
                        return Ok(
                            db.SqlConnection(
                                connection: connection,
                                cancelKey: state.cancelKey,
                                statements: [],
                                named: 0,
                                cacheSize: pg.statementCacheSize
                            )
                        );
                    }

                    if (state.send.length() > 0) {
                        wire.writtenOr(Socket.write(connection, state.send))?;
                    }
                }
            }
        }
    }

    // §3: one statement, one round trip of the extended protocol, read
    // until ReadyForQuery so the connection is ready for the next (§9).
    // A statement prepared on the connection before is only bound (§3b);
    // one the server stopped knowing is prepared again and sent once
    // more, when no transaction would refuse it.
    gateway execute(on: db.SqlConnection, sql: string, values: List<db.SqlValue>) -> db.SqlRun
            requires Socket {
        current: db.SqlConnection = on;
        again: bool = true;
        while (true) {
            plan = statements.planStatement(current, sql, values);
            current = plan.connection;
            match (Socket.write(on.connection, plan.write)) {
                Ok(_) -> None,
                Err(failure) -> {
                    return db.SqlRun(
                        connection: current,
                        result: Err(db.DatabaseError.Broken(failure: failure))
                    );
                }
            }

            state: Reply = Reply(
                columns: [],
                types: [],
                row: None,
                affected: 0,
                failed: None,
                ready: false,
                parsed: false,
                status: 0
            );
            rows: List<List<db.SqlValue>> = [];
            buffer: bytes = <<>>;
            while (!state.ready) {
                match (wire.nextFrame(buffer)) {
                    None -> {
                        match (Socket.read(on.connection)) {
                            Ok(chunk) -> {
                                buffer = <<buffer: bytes, chunk: bytes>>;
                            },

                            Err(failure) -> {
                                return db.SqlRun(
                                    connection: current,
                                    result: Err(db.DatabaseError.Broken(failure: failure))
                                );
                            }
                        }
                    },

                    frame -> {
                        buffer = frame.rest;
                        state = wire.replyStep(state, frame.kind, frame.body);
                        match (state.row) {
                            None -> None,
                            row -> {
                                rows = append(rows, row);
                            }
                        }
                    }
                }
            }

            current = statements.settleStatement(plan, state);
            // 73 is idle: outside a transaction, the statement can run
            // again; inside one, the server refuses all until ROLLBACK.
            if (again && !plan.parsing && state.status == 73 && statements.staleStatement(state.failed)) {
                again = false;
                continue;
            }

            match (state.failed) {
                None -> {
                    return db.SqlRun(
                        connection: current,
                        result: Ok(
                            db.SqlResult(
                                columns: state.columns,
                                rows: rows,
                                affected: state.affected
                            )
                        )
                    );
                },

                failure -> {
                    return db.SqlRun(connection: current, result: Err(failure));
                }
            }
        }
    }

    // ADR 0084 §3a: a CancelRequest, on a new connection negotiated as
    // open negotiates one (libpq does the same), so a cancel never goes in
    // the clear when the connection it stops is encrypted. The server
    // closes the connection once it has read the request, so the one read
    // waits for that, as libpq's does. A cancel that can't be sent changes
    // nothing: the pool discards the connection either way.
    gateway cancel(settings: Map<string, string>, key: bytes) -> None requires Socket {
        if (key.length() == 0) {
            return None;
        }

        match (startup.readSettings(settings)) {
            Err(_) -> None,
            Ok(pg) -> {
                match (Socket.connect(pg.host, pg.port)) {
                    Err(_) -> None,
                    Ok(opened) -> {
                        connection: Connection = opened;
                        ready: bool = true;
                        if (pg.secure) {
                            ready = false;
                            match (Socket.write(connection, <<8: i32be, 80877103: i32be>>)) {
                                Err(_) -> None,
                                Ok(_) -> {
                                    match (Socket.read(connection)) {
                                        Err(_) -> None,
                                        Ok(answer) -> {
                                            if (answer.length() == 1 && answer.at(0) == 83) {
                                                match (Socket.startTls(connection, pg.host)) {
                                                    Err(_) -> None,
                                                    Ok(upgraded) -> {
                                                        connection = upgraded;
                                                        ready = true;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        if (ready) {
                            length = key.length() + 8;
                            match (Socket.write(connection, <<length: i32be, 80877102: i32be, key: bytes>>)) {
                                Err(_) -> None,
                                Ok(_) -> {
                                    match (Socket.read(connection)) {
                                        Ok(_) -> None,
                                        Err(_) -> None
                                    }
                                }
                            }
                        }

                        Socket.close(connection);
                    }
                }
            }
        }

        return None;
    }

    // Terminate, then close. A failed write changes nothing: the socket
    // closes either way.
    gateway close(connection: Connection) -> None requires Socket {
        match (Socket.write(connection, <<88: u8, 4: i32be>>)) {
            Ok(_) -> None,
            Err(_) -> None
        }

        Socket.close(connection);
        return None;
    }
}
