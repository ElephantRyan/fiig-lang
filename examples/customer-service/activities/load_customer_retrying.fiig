// ADR 0014: the first *valid* retry in the corpus — retry_error.fiig only
// shows the rejected case. getCustomer is a plain read with no side effect,
// so it's marked idempotent, and retrying it here is legal. The retry sits
// in the activity, beside the gateway it retries (ADR 0107).
activity loadCustomerRetrying(id: string) -> Result<Customer, CustomerError> {
    return retry(attempts: 3): getCustomer(id)
}
