// ADR 0110 §3: whether a connection can serve another call after this
// command. These change it for whoever uses it next.
conversion keepsConnection(args: List<string>) -> bool {
    changing = [
        "SUBSCRIBE",
        "PSUBSCRIBE",
        "SSUBSCRIBE",
        "MONITOR",
        "MULTI",
        "WATCH",
        "SELECT",
        "CLIENT",
        "HELLO",
        "AUTH",
        "RESET",
    ]
    return not changing.contains(args.first().uppercase())
}
