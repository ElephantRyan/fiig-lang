use fiig.http;

// A key session's first state, from its settings: nothing fetched yet.
conversion jwksStarted(settings: Map<string, string>) -> JwksState {
    url = settings.atOr("url", "");
    accept: List<http.Header> = [http.Header(name: "Accept", value: "application/json")];
    get = http.Request(method: http.Method.Get, url: url, headers: accept);
    request = match (http.outgoingRequest(get)) {
        Ok(outgoing) -> outgoing.data,
        Err(_) -> <<>>
    }

    keys: List<Jwk> = [];
    waiting: List<JwksWaiting> = [];
    return JwksState(
        url: url,
        issuer: settings.atOrNone("issuer"),
        request: request,
        keys: keys,
        jwksUri: None,
        fetchedAt: None,
        triedAt: None,
        fetching: false,
        reply: <<>>,
        failure: None,
        nextKey: 1,
        waiting: waiting
    );
}
