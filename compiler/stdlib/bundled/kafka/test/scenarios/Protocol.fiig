use com.degeneratedevelopment.kafka.cluster;
use com.degeneratedevelopment.kafka.codec;
use com.degeneratedevelopment.kafka.produce;

test aBatchCarriesItsCrcAndLength {
    record = KafkaRecord(key: None, value: "v".utf8(), headers: None);
    expect codec.recordBatch([record], 1000, Compression.None) is Ok(batch);
    match (batch) {
        <<baseOffset: i64be, length: i32be, epoch: i32be, magic: u8, crc: u32be, rest: bytes>> -> {
            expect baseOffset == 0;
            expect length == rest.length() + 9;
            expect epoch == 0 - 1;
            expect magic == 2;
            expect crc == crypto.crc32c(rest);
        },

        _ -> {
            expect false;
        }
    }

    expect codec.recordBatch([], 1000, Compression.None) is Err(KafkaError.InvalidRecord(empty));
}

test apiVersionsChecksTheVersionsSent {
    // ApiVersions v0's reply: correlation, no error, then (key, min, max)
    // for Produce and Metadata.
    good = <<
        1: i32be,
        0: i16be,
        2: i32be,
        0: i16be,
        3: i16be,
        12: i16be,
        3: i16be,
        0: i16be,
        13: i16be
    >>;
    expect cluster.checkApiVersions(good, 1) is Ok(_);
    old = <<
        1: i32be,
        0: i16be,
        2: i32be,
        0: i16be,
        0: i16be,
        7: i16be,
        3: i16be,
        0: i16be,
        13: i16be
    >>;
    expect cluster.checkApiVersions(old, 1) is Err(KafkaError.Unsupported(reason));
    expect reason.contains("Produce v9");
    // A broker whose Metadata stops before v12, the flexible version the
    // producer sends (as amended 2026-11-21).
    noFlexible = <<
        1: i32be,
        0: i16be,
        2: i32be,
        0: i16be,
        3: i16be,
        12: i16be,
        3: i16be,
        0: i16be,
        11: i16be
    >>;
    expect cluster.checkApiVersions(noFlexible, 1) is Err(KafkaError.Unsupported(_));
    expect cluster.checkApiVersions(good, 9) is Err(KafkaError.MalformedReply(mismatch));
}

// ADR 0113 §4, as amended 2026-11-21: the producer's Metadata v12 and
// Produce v9, flexible versions with compact encodings and tagged fields.
test flexibleMetadataNamesTheTopicOnly {
    request = cluster.metadataV12Request("fiig", 5, "orders");
    // Size, then header v2: Metadata v12, the correlation id, the client
    // id as a STRING, and no tags.
    expect request.slice(0, 19) == <<request.length() - 4: i32be, 3: i16be, 12: i16be, 5: i32be, codec.kafkaString("fiig"): bytes, 0: u8>>;
    // One topic, no id, by name; no auto-creation, no authorized
    // operations, no tags.
    expect request.slice(19, request.length()) == <<2: u8, 0: i64be, 0: i64be, codec.compactString("orders"): bytes, 0: u8, 0: u8, 0: u8, 0: u8>>;
}

test flexibleMetadataListsPartitionsInOrder {
    expect cluster.readMetadataV12(ordersMetadataV12(), 2, "orders") is Ok(layout);
    expect layout.leaders == [1, 2, 1];
    expect layout.brokers == [BrokerNode(id: 1, host: "b1", port: 9092), BrokerNode(id: 2, host: "b2", port: 9093)];
    expect cluster.readMetadataV12(ordersMetadataV12(), 2, "payments") is Err(KafkaError.UnknownTopic(_));
    expect cluster.readMetadataV12(ordersMetadataV12(), 3, "orders") is Err(KafkaError.MalformedReply(mismatch));
    expect mismatch.contains("correlation 2");
    whole = ordersMetadataV12();
    expect cluster.readMetadataV12(whole.slice(0, whole.length() - 40), 2, "orders") is Err(KafkaError.MalformedReply(short));
    expect short.contains("ends early");
}

test flexibleProduceRepliesGiveEachRecordItsOffset {
    expect cluster.readMetadataV12(ordersMetadataV12(), 2, "orders") is Ok(layout);
    records = [
        KafkaRecord(key: "order-1".utf8(), value: "a".utf8(), headers: None),
        KafkaRecord(key: "order-2".utf8(), value: "b".utf8(), headers: None)
    ];
    // order-1 is partition 1, led by broker 2; order-2 partition 0, by 1.
    expect produce.producePlan(layout, records, 1000, Compression.None) is Ok(calls);
    expect calls.length() == 2;
    call = calls.last();
    expect call.broker.id == 2;
    request = produce.produceV9Request("fiig", 4, "orders", 30000, call.batches);
    batch = call.batches.first().batch;
    expect request.slice(4, 8) == <<0: i16be, 9: i16be>>;
    // No transactional id, acks=all, the timeout, then one topic of one
    // partition, its batch as COMPACT_RECORDS.
    expect request.slice(19, request.length()) == <<0: u8, 0 - 1: i16be, 30000: i32be, 2: u8, codec.compactString("orders"): bytes, 2: u8, 1: i32be, codec.uvarint(batch.length() + 1): bytes, batch: bytes, 0: u8, 0: u8, 0: u8>>;
    reply = <<
        4: i32be,
        0: u8,
        2: u8,
        codec.compactString("orders"): bytes,
        2: u8,
        1: i32be,
        0: i16be,
        7: i64be,
        0 - 1: i64be,
        0: i64be,
        1: u8,
        0: u8,
        0: u8,
        0: u8,
        0: i32be,
        0: u8
    >>;
    expect produce.readProduceV9(reply, 4, call) is Ok(sent);
    expect sent == [SentAt(index: 0, partition: 1, offset: 7)];
    refused = <<
        4: i32be,
        0: u8,
        2: u8,
        codec.compactString("orders"): bytes,
        2: u8,
        1: i32be,
        6: i16be,
        0 - 1: i64be,
        0 - 1: i64be,
        0: i64be,
        1: u8,
        codec.compactString("leader moved"): bytes,
        0: u8,
        0: u8,
        0: i32be,
        0: u8
    >>;
    expect produce.readProduceV9(refused, 4, call) is Err(KafkaError.Broker(code, name, retriable, message));
    expect code == 6;
    expect name == "NOT_LEADER_OR_FOLLOWER";
    expect retriable;
    expect message.contains("leader moved");
    expect produce.readProduceV9(reply.slice(0, 20), 4, call) is Err(KafkaError.MalformedReply(_));
}

test metadataListsPartitionsInOrder {
    expect cluster.readMetadata(ordersMetadata(), 2, "orders") is Ok(layout);
    expect layout.leaders == [1, 1, 1];
    expect layout.brokers.first().host == "b1";
    expect layout.brokers.first().port == 9092;
    expect cluster.readMetadata(ordersMetadata(), 2, "payments") is Err(KafkaError.UnknownTopic(topic));
    expect topic == "payments";
    expect cluster.readMetadata(ordersMetadata().slice(0, 30), 2, "orders") is Err(KafkaError.MalformedReply(short));
    expect short.contains("ends early");
}

test keysGoWhereJavaPutsThem {
    expect cluster.readMetadata(ordersMetadata(), 2, "orders") is Ok(layout);
    records = [
        KafkaRecord(key: "order-1".utf8(), value: "a".utf8(), headers: None),
        KafkaRecord(key: "order-2".utf8(), value: "b".utf8(), headers: None),
        KafkaRecord(key: None, value: "c".utf8(), headers: None)
    ];
    // order-1 is partition 1 and order-2 partition 0 of 3, as the Java
    // client computes; the keyless record goes to 1000 % 3, partition 1.
    expect produce.producePlan(layout, records, 1000, Compression.None) is Ok(calls);
    expect calls.length() == 1;
    batches = calls.first().batches;
    expect batches.length() == 2;
    expect batches.first().partition == 0;
    expect batches.first().indexes == [1];
    expect batches.last().partition == 1;
    expect batches.last().indexes == [0, 2];
}

test produceRepliesGiveEachRecordItsOffset {
    expect cluster.readMetadata(ordersMetadata(), 2, "orders") is Ok(layout);
    records = [
        KafkaRecord(key: "order-1".utf8(), value: "a".utf8(), headers: None),
        KafkaRecord(key: "order-2".utf8(), value: "b".utf8(), headers: None),
        KafkaRecord(key: None, value: "c".utf8(), headers: None)
    ];
    expect produce.producePlan(layout, records, 1000, Compression.None) is Ok(calls);
    call = calls.first();
    reply = <<
        2: i32be,
        1: i32be,
        codec.kafkaString("orders"): bytes,
        2: i32be,
        0: i32be,
        0: i16be,
        40: i64be,
        0: i64be,
        0: i64be,
        0: i32be,
        0 - 1: i16be,
        1: i32be,
        0: i16be,
        7: i64be,
        0: i64be,
        0: i64be,
        0: i32be,
        0 - 1: i16be,
        0: i32be
    >>;
    expect produce.readProduce(reply, 2, call) is Ok(sent);
    expect produce.inOrder(sent, 3) is Ok(placed);
    expect placed == [Sent(partition: 1, offset: 7), Sent(partition: 0, offset: 40), Sent(partition: 1, offset: 8)];
    refused = <<
        2: i32be,
        1: i32be,
        codec.kafkaString("orders"): bytes,
        1: i32be,
        1: i32be,
        6: i16be,
        0 - 1: i64be,
        0: i64be,
        0: i64be,
        0: i32be,
        codec.kafkaString("leader moved"): bytes,
        0: i32be
    >>;
    expect produce.readProduce(refused, 2, call) is Err(KafkaError.Broker(code, name, retriable, message));
    expect code == 6;
    expect name == "NOT_LEADER_OR_FOLLOWER";
    expect retriable;
    expect message.contains("leader moved");
}

private {
    // A Metadata v12 reply for "orders", whose three partitions come back
    // out of order, 0 and 2 led by broker 1 at b1:9092 and 1 by broker 2
    // at b2:9093; the first broker and partition 1 carry a tagged field a
    // newer broker might add, which is skipped.
    ordersMetadataV12() -> bytes {
        partitions: bytes = codec.uvarint(4);
        for (index in [2, 0, 1]) {
            leader: int = 1;
            tags: bytes = <<0: u8>>;
            if (index == 1) {
                leader = 2;
                tags = <<1: u8, 0: u8, 2: u8, 9: u8, 9: u8>>;
            }

            partitions = <<
                partitions: bytes,
                0: i16be,
                index: i32be,
                leader: i32be,
                0: i32be,
                codec.uvarint(2): bytes,
                leader: i32be,
                codec.uvarint(2): bytes,
                leader: i32be,
                codec.uvarint(1): bytes,
                tags: bytes
            >>;
        }

        return <<
            2: i32be,
            0: u8,
            0: i32be,
            codec.uvarint(3): bytes,
            1: i32be,
            codec.compactString("b1"): bytes,
            9092: i32be,
            0: u8,
            1: u8,
            0: u8,
            1: u8,
            7: u8,
            2: i32be,
            codec.compactString("b2"): bytes,
            9093: i32be,
            codec.compactString("rack-b"): bytes,
            0: u8,
            codec.compactString("c"): bytes,
            1: i32be,
            codec.uvarint(2): bytes,
            0: i16be,
            codec.compactString("orders"): bytes,
            "0123456789abcdef".utf8(): bytes,
            0: u8,
            partitions: bytes,
            0 - 2147483648: i32be,
            0: u8,
            0: u8
        >>;
    }

    // A Metadata v4 reply for "orders", whose three partitions come back
    // out of order, all led by broker 1 at b1:9092.
    ordersMetadata() -> bytes {
        partitions: bytes = <<3: i32be>>;
        for (index in [2, 0, 1]) {
            partitions = <<
                partitions: bytes,
                0: i16be,
                index: i32be,
                1: i32be,
                1: i32be,
                1: i32be,
                1: i32be,
                1: i32be
            >>;
        }

        return <<
            2: i32be,
            0: i32be,
            1: i32be,
            1: i32be,
            codec.kafkaString("b1"): bytes,
            9092: i32be,
            0 - 1: i16be,
            codec.kafkaString("c"): bytes,
            1: i32be,
            1: i32be,
            0: i16be,
            codec.kafkaString("orders"): bytes,
            0: u8,
            partitions: bytes
        >>;
    }
}
