// A ListOffsets v2 response: each partition's offset. A partition the
// broker refused is left out, so it is asked again on the next receive.
conversion readListOffsets(frame: bytes) -> Result<List<PartitionOffset>, KafkaError> {
    topics = need(i32At(frame, 8))?;
    pos: int = 12;
    out: List<PartitionOffset> = [];
    t: int = 0;
    while (t < topics) {
        name = textOf(stringAt(frame, pos))?;
        count = need(i32At(frame, name.next))?;
        pos = name.next + 4;
        i: int = 0;
        while (i < count) {
            partition = need(i32At(frame, pos))?;
            code = need(i16At(frame, pos + 4))?;
            offset = need(i64At(frame, pos + 14))?;
            if (code == 0) {
                out = append(out, PartitionOffset(partition: partition, offset: offset));
            }

            pos = pos + 22;
            i = i + 1;
        }

        t = t + 1;
    }

    return Ok(out);
}

private {
    short() -> KafkaError {
        return KafkaError.MalformedReply(reason: "a ListOffsets response ends early");
    }

    need(read: int | None) -> Result<int, KafkaError> {
        return match (read) {
            None -> {
                return Err(short());
            },

            found -> {
                return Ok(found);
            },
        }
    }

    textOf(read: TextAt | None) -> Result<TextAt, KafkaError> {
        return match (read) {
            None -> {
                return Err(short());
            },

            found -> {
                return Ok(found);
            },
        }
    }
}
