// HTTP Basic auth (RFC 7617) is a pure rule over the header's text: the
// adapter hands the workflow a string, and decoding it needs no HTTP
// (ADR 0069 §7). The name ends at the first colon; the key may hold more.
rule basicCredentials(header: string) -> Credentials | None {
    if (!header.startsWith(prefix: "Basic ")) {
        return None;
    }

    decoded = header.removePrefix(prefix: "Basic ").trim().fromBase64();
    return match (decoded) {
        None -> {
            return None;
        },

        raw -> {
            return match (raw.utf8()) {
                None -> {
                    return None;
                },

                text -> {
                    parts = text.split(separator: ":");
                    if (parts.length() < 2) {
                        return None;
                    }

                    name = parts.first();
                    return Credentials(name: name, key: text.removePrefix(prefix: "${name}:"));
                },
            }
        },
    }
}
