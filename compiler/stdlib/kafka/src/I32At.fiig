// The INT32 at offset at, or None when the response is too short.
conversion i32At(data: bytes, at: int) -> int | None {
    if (at < 0 || at + 4 > data.length()) {
        return None;
    }

    return match (data.slice(at, at + 4)) {
        <<value: i32be>> -> {
            return value;
        },

        _ -> {
            return None;
        }
    }
}
