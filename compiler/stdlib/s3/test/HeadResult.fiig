use fiig.http

test aHeadReplyIsTheObjectsInfo {
    reply = http.Reply(
        status: 200,
        headers: [http.Header(name: "content-length", value: "1234"), http.Header(name: "Content-Type", value: "image/png"), http.Header(name: "ETag", value: "\"abc123\"")],
        body: <<>>,
    )
    expect headResult(reply) is Ok(info)
    expect info == ObjectInfo(size: 1234, contentType: "image/png", etag: "\"abc123\"")
}

test headerNamesAreReadInAnyCase {
    reply = http.Reply(
        status: 200,
        headers: [http.Header(name: "CONTENT-LENGTH", value: "7"), http.Header(name: "content-type", value: "text/plain"), http.Header(name: "etag", value: "e")],
        body: <<>>,
    )
    expect headResult(reply) is Ok(info)
    expect info == ObjectInfo(size: 7, contentType: "text/plain", etag: "e")
}

test noLengthIsMalformed {
    reply = http.Reply(status: 200, headers: [http.Header(name: "ETag", value: "e")], body: <<>>)
    expect headResult(reply) is Err(S3Error.Http(failure))
}

test aLengthThatIsntANumberIsMalformed {
    reply = http.Reply(
        status: 200,
        headers: [http.Header(name: "Content-Length", value: "lots")],
        body: <<>>,
    )
    expect headResult(reply) is Err(S3Error.Http(failure))
}

test a404IsNotFoundAndOtherStatusesAreRefused {
    expect headResult(http.Reply(status: 404, headers: [], body: <<>>)) is Err(S3Error.NotFound)
    expect headResult(http.Reply(status: 403, headers: [], body: <<>>)) is Err(S3Error.Refused(status, code, message))
    expect status == 403
}
