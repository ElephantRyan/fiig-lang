// The vertical's checkout: checkout-app's takePayment, with this
// application's own provider rule. Everything else is checkout.core's.
use acme.payments;
use checkout.core;
use checkout.core.LedgerApi;

activity takeClientPayment(merchant: core.PayingMerchant, request: payments.ChargeRequest)
        -> Result<string, string> {
    Provider = chooseClientProvider(merchant);
    reference = Provider.charge(request)?;
    recorded = LedgerApi.record("charged ${request.orderId} as ${reference}")?;
    return Ok(reference);
}
