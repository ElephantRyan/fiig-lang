// ADR 0077: a signed webhook, sent as application/json and bound as the
// bytes the sender signed. The signature is checked before a byte of the
// body is decoded; then the bytes are decoded by the decoder the JSON
// route uses.
workflow receiveSignedEvent(body: bytes, signature: string | None) -> Result<Event, InboxError> {
    if (!signatureMatches(body: body, header: signature)) {
        return Err(InboxError.BadSignature);
    }

    decoded: Result<Envelope, JsonError> = json.decode(body);
    return match (decoded) {
        Err(failure) -> Err(InboxError.Undecodable(failure: failure))
        Ok(envelope) -> {
            return match (readEvent(envelope)) {
                Ok(event) -> Ok(event)
                Err(failure) -> Err(InboxError.Undecodable(failure: failure))
            }
        }
    }
}
