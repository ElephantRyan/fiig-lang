// RFC 9110 §5.6.2: a header name is one or more of letters, digits, and
// !#$%&'*+-.^_`|~.
conversion isToken(text: string) -> bool {
    raw = text.utf8();
    if (raw.length() == 0) {
        return false;
    }

    for (b in raw) {
        letter = (b >= 65 && b <= 90) || (b >= 97 && b <= 122);
        digit = b >= 48 && b <= 57;
        mark = b == 33 || (b >= 35 && b <= 39) || b == 42 || b == 43 || b == 45 || b == 46 || (b >= 94 && b <= 96) || b == 124 || b == 126;
        if (!(letter || digit || mark)) {
            return false;
        }
    }

    return true;
}
