// Reads the shared secret, which only an activity or gateway may (ADR
// 0071 §2), and checks a delivery's signature with it. A delivery with
// no signature doesn't match.
activity signatureMatches(body: bytes, header: string | None) -> bool {
    return match (header) {
        None -> false
        sent -> signatureValid(secret: Inbox.webhookSecret, body: body, header: sent)
    }
}
