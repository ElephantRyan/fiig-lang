use fiig.stream;

// A group session's answer to Poll, read back.
conversion pollReplyOf(parts: List<bytes>) -> Result<PollReply, stream.SourceError> {
    if (parts.length() != 1) {
        return Err(
            stream.SourceError.Protocol(reason: "a poll was answered in ${parts.length()} parts")
        );
    }

    decoded: Result<PollReply, JsonError> = json.decode(parts.first());
    return match (decoded) {
        Err(_) -> Err(stream.SourceError.Protocol(reason: "a poll's answer isn't a PollReply")),
        Ok(reply) -> Ok(reply)
    }
}
