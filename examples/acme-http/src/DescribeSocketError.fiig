// A SocketError as a sentence, for callers whose own error type is text.
conversion describeSocketError(failure: SocketError) -> string {
    return match (failure) {
        SocketError.HostNotFound -> "host not found"
        SocketError.Refused -> "connection refused"
        SocketError.Unreachable -> "host unreachable"
        SocketError.Reset -> "connection reset"
        SocketError.Closed -> "connection closed"
        SocketError.Tls(reason) -> "TLS failed: ${reason}"
        SocketError.TimedOut -> "timed out"
    }
}
