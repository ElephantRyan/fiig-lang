// ADR 0113 §4: whether the broker answering frame, ApiVersions v0's
// response, takes the versions this producer sends: Metadata v4 and
// Produce v8.
conversion checkApiVersions(frame: bytes, correlation: int) -> Result<None, KafkaError> {
    match frame {
        <<got: i32be, code: i16be, count: i32be, rest: bytes>> -> {
            if got != correlation {
                return Err(
                    KafkaError.MalformedReply(reason: "ApiVersions answered correlation ${got}, not ${correlation}"),
                )
            }
            if code != 0 {
                return Err(brokerError(code, "ApiVersions"))
            }
            if count < 0 or rest.length() < count * 6 {
                return Err(
                    KafkaError.MalformedReply(reason: "ApiVersions lists ${count} APIs in ${rest.length()} bytes"),
                )
            }
            metadata = apiSupports(rest, count, 3, 4)
            produce = apiSupports(rest, count, 0, 8)
            if not metadata or not produce {
                return Err(
                    KafkaError.Unsupported(reason: "the broker doesn't take Metadata v4 and Produce v8, which fiig.kafka sends (ADR 0113 §4)"),
                )
            }
            return Ok(None)
        }
        _ -> {
            return Err(
                KafkaError.MalformedReply(reason: "an ApiVersions response is shorter than its header"),
            )
        }
    }
}
