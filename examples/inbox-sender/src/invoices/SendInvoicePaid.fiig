// ADR 0074: fiig calling fiig over HTTP, with no Go in between. The event
// goes out with json.encode, comes back as bytes, and a 200 is decoded
// with json.decode; any other status is the caller's to judge (§3). The
// bytes sent are signed as GitHub signs a delivery (ADR 0075 §1), and the
// inbox checks the signature over those same bytes (ADR 0077).
use fiig.http;
use fiig.http.HttpClient;

gateway sendInvoicePaid(inboxUrl: string, id: string, invoice: string, amount: decimal)
        -> Result<InboxEvent, SendError>
        requires HttpClient {
    event = PaidEnvelope(
        id: id,
        eventType: "invoice.paid",
        data: PaidInvoice(invoice: invoice, amount: amount, paidAt: "2026-11-10")
    );
    body = json.encode(event);
    signature = crypto.hmacSha256(key: Outbox.webhookSecret, data: body).toHex();
    sent = HttpClient.send(
        http.Request(
            method: http.Method.Post,
            url: "${inboxUrl}/events/signed",
            headers: [
                http.Header(name: "Content-Type", value: "application/json"),
                http.Header(name: "X-Hub-Signature-256", value: "sha256=${signature}")
            ],
            body: body,
            timeoutMillis: 5000
        )
    );
    return match (sent) {
        Err(failure) -> Err(SendError.Unreachable(failure: failure)),
        Ok(reply) -> {
            if (reply.status != 200) {
                return Err(SendError.Rejected(status: reply.status, body: replyText(reply.body)));
            }

            answer: Result<InboxEvent, JsonError> = json.decode(reply.body);
            return match (answer) {
                Ok(received) -> Ok(received),
                Err(failure) -> Err(SendError.Unreadable(failure: failure))
            }
        }
    }
}

private {
    replyText(raw: bytes) -> string {
        return match (raw.utf8()) {
            None -> "(not UTF-8)",
            text -> text
        }
    }
}
