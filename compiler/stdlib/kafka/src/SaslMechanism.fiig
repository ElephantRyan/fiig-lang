// ADR 0113 §6, as amended 2026-11-21: how a session authenticates, in
// Kafka's sasl.mechanism spelling, so KAFKA_SASL_MECHANISM=SCRAM-SHA-512
// reads as a Java client's setting does.
enum SaslMechanism {
    Plain from json "PLAIN",
    ScramSha256 from json "SCRAM-SHA-256",
    ScramSha512 from json "SCRAM-SHA-512",
}
