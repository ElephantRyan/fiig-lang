// ADR 0113 §4, as amended 2026-11-21: Metadata v12 (API key 3), the
// producer's flexible version (KIP-482), for one topic named with no
// topic id (sixteen zero bytes), never creating it, and asking for no
// authorized operations.
conversion metadataV12Request(clientId: string, correlation: int, topic: string) -> bytes {
    body = <<
        uvarint(2): bytes,
        0: i64be,
        0: i64be,
        compactString(topic): bytes,
        0: u8,
        0: u8,
        0: u8,
        0: u8
    >>;
    return kafkaFlexRequest(3, 12, correlation, clientId, body);
}
