use fiig.smtp.conversation;
use fiig.smtp.mime;

test aStartTlsSendFromGreetingToQuit {
    d0 = begin(startTls("user", "pass"), ["b@y.org", "c@y.org"]);
    expect sent(d0) == "listen";
    d1 = go(d0, 220, ["mail.example ESMTP"]);
    expect sent(d1) == "EHLO client.test\r\n";
    d2 = go(d1, 250, ["mail.example Hello", "STARTTLS", "AUTH PLAIN LOGIN", "SIZE 1000000"]);
    expect sent(d2) == "STARTTLS\r\n";
    d3 = go(d2, 220, ["Ready to start TLS"]);
    expect sent(d3) == "upgrade";
    // The handshake forgets what the server said, so it is asked again.
    d4 = conversation.afterUpgrade(d3);
    expect d4.secure;
    expect sent(d4) == "EHLO client.test\r\n";
    d5 = go(d4, 250, ["mail.example Hello", "AUTH PLAIN LOGIN"]);
    expect sent(d5) == "AUTH PLAIN AHVzZXIAcGFzcw==\r\n";
    d6 = go(d5, 235, ["Authentication successful"]);
    expect sent(d6) == "MAIL FROM:<a@x.org>\r\n";
    d7 = go(d6, 250, ["OK"]);
    expect sent(d7) == "RCPT TO:<b@y.org>\r\n";
    d8 = go(d7, 250, ["OK"]);
    expect sent(d8) == "RCPT TO:<c@y.org>\r\n";
    d9 = go(d8, 251, ["User not local; will forward"]);
    expect sent(d9) == "DATA\r\n";
    d10 = go(d9, 354, ["End data with <CR><LF>.<CR><LF>"]);
    expect sent(d10) == "the message";
    d11 = go(d10, 250, ["OK queued"]);
    // No QUIT: the connection is kept for the next mail.
    expect sent(d11) == "finish";
}

test aKeptConnectionStartsWithRset {
    d0 = conversation.resumeDialogue(
        startTls("user", "pass"),
        mail(["b@y.org"]),
        "client.test",
        "the message".utf8()
    );
    expect d0.secure;
    expect sent(d0) == "RSET\r\n";
    d1 = go(d0, 250, ["2.0.0 OK"]);
    expect sent(d1) == "MAIL FROM:<a@x.org>\r\n";
}

test aRefusedRsetEndsTheSend {
    d = conversation.resumeDialogue(
        plain(None, None),
        mail(["b@y.org"]),
        "client.test",
        "the message".utf8()
    );
    expect !d.secure;
    expect conversation.advance(d, reply(421, ["4.4.2 Timeout"])) is Err(SmtpError.Refused(code, message));
    expect code == 421;
}

test aKeptConnectionIsOnlyForTheSameLogin {
    expect conversation.sessionFor(startTls("ann", "pass")) == "user=ann";
    expect conversation.sessionFor(startTls("bob", "pass")) == "user=bob";
    expect conversation.sessionFor(plain(None, None)) == "no login";
}

test aDeadKeptConnectionIsTriedAgainOnlyBeforeTheBody {
    kept = conversation.resumeDialogue(
        plain(None, None),
        mail(["b@y.org"]),
        "client.test",
        "the message".utf8()
    );
    closed = SmtpError.Socket(failure: SocketError.Closed);
    expect conversation.resendOnNewConnection(kept, closed);
    expect conversation.resendOnNewConnection(
        kept,
        SmtpError.Refused(code: 421, message: "closing")
    );
    expect !conversation.resendOnNewConnection(kept, SmtpError.Refused(code: 550, message: "no"));
    expect !conversation.resendOnNewConnection(kept, SmtpError.Protocol(reason: "malformed"));
    for (phase in [SmtpPhase.MailFrom, SmtpPhase.Rcpt, SmtpPhase.Data]) {
        expect conversation.resendOnNewConnection(copy(kept, phase: phase), closed);
    }

    // Once the message has been written the server may have it.
    expect !conversation.resendOnNewConnection(copy(kept, phase: SmtpPhase.Body), closed);
    expect !conversation.resendOnNewConnection(copy(kept, phase: SmtpPhase.Sent), closed);
}

test smtpWithoutStartTlsIsRefusedBeforeAnythingIsSent {
    hello = go(begin(startTls("user", "pass"), ["b@y.org"]), 220, ["hi"]);
    expect sent(hello) == "EHLO client.test\r\n";
    expect conversation.advance(hello, reply(250, ["mail.example Hello", "AUTH PLAIN"])) is Err(SmtpError.Protocol(reason));
    expect reason.contains("STARTTLS");
}

test smtpsIsSecureFromTheStartAndNeverAsksForStartTls {
    d = go(
        go(begin(implicit("user", "pass"), ["b@y.org"]), 220, ["hi"]),
        250,
        ["mail.example Hello", "STARTTLS", "AUTH PLAIN"]
    );
    expect d.secure;
    expect sent(d) == "AUTH PLAIN AHVzZXIAcGFzcw==\r\n";
}

test plainWithNoLoginGoesStraightToMail {
    d = go(go(begin(plain(None, None), ["b@y.org"]), 220, ["hi"]), 250, ["mail.example Hello"]);
    expect sent(d) == "MAIL FROM:<a@x.org>\r\n";
}

test aLoginNeedsAuthPlainOrAuthLogin {
    after = conversation.advance(afterGreeting(), reply(250, ["mail.example Hello", "STARTTLS"]));
    expect after is Ok(next);
    secured = conversation.afterUpgrade(next);
    expect conversation.advance(copy(secured, phase: SmtpPhase.SecureHello), reply(250, ["mail.example Hello", "AUTH XOAUTH2 CRAM-MD5"])) is Err(SmtpError.Protocol(reason));
    expect reason.contains("AUTH PLAIN");
    expect reason.contains("AUTH LOGIN");
}

test authLoginIsUsedWhenItIsAllTheServerOffers {
    d0 = go(
        go(begin(implicit("user", "pass"), ["b@y.org"]), 220, ["hi"]),
        250,
        ["mail.example Hello", "AUTH LOGIN XOAUTH2"]
    );
    expect sent(d0) == "AUTH LOGIN\r\n";
    // The server's prompts are Username: and Password: in base64.
    d1 = go(d0, 334, ["VXNlcm5hbWU6"]);
    expect sent(d1) == "dXNlcg==\r\n";
    d2 = go(d1, 334, ["UGFzc3dvcmQ6"]);
    expect sent(d2) == "cGFzcw==\r\n";
    d3 = go(d2, 235, ["Authentication successful"]);
    expect sent(d3) == "MAIL FROM:<a@x.org>\r\n";
}

test aRefusedAuthLoginPasswordEndsTheSend {
    d = go(
        go(
            go(
                go(begin(implicit("user", "pass"), ["b@y.org"]), 220, ["hi"]),
                250,
                ["Hello", "AUTH=LOGIN"]
            ),
            334,
            ["VXNlcm5hbWU6"]
        ),
        334,
        ["UGFzc3dvcmQ6"]
    );
    expect sent(d) == "cGFzcw==\r\n";
    expect conversation.advance(d, reply(535, ["5.7.8 Authentication credentials invalid"])) is Err(SmtpError.Refused(code, message));
    expect code == 535;
}

test authPlainIsPreferredWhenBothAreOffered {
    d = go(
        go(begin(implicit("user", "pass"), ["b@y.org"]), 220, ["hi"]),
        250,
        ["mail.example Hello", "AUTH LOGIN PLAIN"]
    );
    expect sent(d) == "AUTH PLAIN AHVzZXIAcGFzcw==\r\n";
}

test theOlderAuthEqualsFormIsRead {
    d = go(
        go(begin(implicit("user", "pass"), ["b@y.org"]), 220, ["hi"]),
        250,
        ["mail.example Hello", "AUTH=PLAIN LOGIN"]
    );
    expect sent(d) == "AUTH PLAIN AHVzZXIAcGFzcw==\r\n";
}

test xoauth2IsPreferredWhenATokenIsConfiguredAndOffered {
    d = go(
        go(begin(oauth(SmtpAuth.Auto, "pass"), ["b@y.org"]), 220, ["hi"]),
        250,
        ["smtp.gmail.com", "AUTH LOGIN PLAIN XOAUTH2 OAUTHBEARER"]
    );
    // user=ann@gmail.com, 0x01, auth=Bearer ya29.tok, 0x01 0x01.
    expect sent(d) == "AUTH XOAUTH2 dXNlcj1hbm5AZ21haWwuY29tAWF1dGg9QmVhcmVyIHlhMjkudG9rAQE=\r\n";
    expect sent(go(d, 235, ["2.7.0 Accepted"])) == "MAIL FROM:<a@x.org>\r\n";
}

test aRefusedTokenIsAnsweredAndItsStatusReported {
    d = go(
        go(begin(oauth(SmtpAuth.Auto, ""), ["b@y.org"]), 220, ["hi"]),
        250,
        ["Hello", "AUTH XOAUTH2"]
    );
    // {"status":"401","schemes":"Bearer","scope":"https://mail.google.com/"}
    challenge = go(
        d,
        334,
        [
            "eyJzdGF0dXMiOiI0MDEiLCJzY2hlbWVzIjoiQmVhcmVyIiwic2NvcGUiOiJodHRwczovL21haWwuZ29vZ2xlLmNvbS8ifQ=="
        ]
    );
    // The challenge is answered with an empty line; the server then refuses.
    expect sent(challenge) == "\r\n";
    expect conversation.advance(challenge, reply(535, ["5.7.8 Username and Password not accepted"])) is Err(SmtpError.Refused(code, message));
    expect code == 535;
    expect message == "the XOAUTH2 token (status 401): 5.7.8 Username and Password not accepted";
}

test aChallengeThatIsntJsonStillEndsInTheRefusal {
    d = go(
        go(begin(oauth(SmtpAuth.XOAuth2, ""), ["b@y.org"]), 220, ["hi"]),
        250,
        ["Hello", "AUTH XOAUTH2"]
    );
    challenge = go(d, 334, ["not base64!"]);
    expect sent(challenge) == "\r\n";
    expect conversation.advance(challenge, reply(535, ["no"])) is Err(SmtpError.Refused(code, message));
    expect message == "the XOAUTH2 token: no";
}

test aTokenWithoutXOAuth2FallsBackToThePassword {
    d = go(
        go(begin(oauth(SmtpAuth.Auto, "pass"), ["b@y.org"]), 220, ["hi"]),
        250,
        ["Hello", "AUTH PLAIN"]
    );
    expect sent(d) == "AUTH PLAIN AGFubkBnbWFpbC5jb20AcGFzcw==\r\n";
    // With no password, there is nothing else to log in with.
    tokenOnly = go(begin(oauth(SmtpAuth.Auto, ""), ["b@y.org"]), 220, ["hi"]);
    expect conversation.advance(tokenOnly, reply(250, ["Hello", "AUTH PLAIN"])) is Err(SmtpError.Protocol(reason));
    expect reason.contains("XOAUTH2");
}

test smtpAuthTakesOnlyTheMechanismItNames {
    greeted = go(begin(oauth(SmtpAuth.Login, "pass"), ["b@y.org"]), 220, ["hi"]);
    expect sent(go(greeted, 250, ["Hello", "AUTH PLAIN LOGIN XOAUTH2"])) == "AUTH LOGIN\r\n";
    plainOnly = copy(greeted, target: copy(greeted.target, auth: SmtpAuth.Plain));
    expect sent(go(plainOnly, 250, ["Hello", "AUTH PLAIN LOGIN XOAUTH2"])) == "AUTH PLAIN AGFubkBnbWFpbC5jb20AcGFzcw==\r\n";
    oauthOnly = copy(greeted, target: copy(greeted.target, auth: SmtpAuth.XOAuth2));
    expect conversation.advance(oauthOnly, reply(250, ["Hello", "AUTH PLAIN LOGIN"])) is Err(SmtpError.Protocol(reason));
    expect reason.contains("xoauth2");
}

test aRefusedRecipientEndsTheSend {
    d = go(
        go(
            go(go(begin(plain(None, None), ["b@y.org", "c@y.org"]), 220, ["hi"]), 250, ["Hello"]),
            250,
            ["OK"]
        ),
        250,
        ["OK"]
    );
    expect sent(d) == "RCPT TO:<c@y.org>\r\n";
    expect conversation.advance(d, reply(550, ["No such user here"])) is Err(SmtpError.Refused(code, message));
    expect code == 550;
    expect message.contains("c@y.org");
    expect message.contains("No such user");
}

test everyRecipientInToCcAndBccIsSentToOnce {
    m = Mail(
        from: "a@x.org",
        to: ["b@y.org"],
        subject: "s",
        body: "x",
        cc: ["c@y.org", "b@y.org"],
        bcc: ["d@y.org"]
    );
    expect mime.recipientsOf(m) == ["b@y.org", "c@y.org", "d@y.org"];
    d = go(
        go(
            go(
                conversation.startDialogue(
                    plain(None, None),
                    m,
                    "client.test",
                    "the message".utf8()
                ),
                220,
                ["hi"]
            ),
            250,
            ["Hello"]
        ),
        250,
        ["OK"]
    );
    expect sent(d) == "RCPT TO:<b@y.org>\r\n";
    expect sent(go(d, 250, ["OK"])) == "RCPT TO:<c@y.org>\r\n";
    // A refused Bcc recipient ends the send like any other.
    last = go(go(d, 250, ["OK"]), 250, ["OK"]);
    expect sent(last) == "RCPT TO:<d@y.org>\r\n";
    expect conversation.advance(last, reply(550, ["No such user"])) is Err(SmtpError.Refused(code, message));
    expect sent(go(last, 250, ["OK"])) == "DATA\r\n";
}

test aTemporaryRefusalKeepsItsCode {
    greeting = begin(plain(None, None), ["b@y.org"]);
    expect conversation.advance(greeting, reply(421, ["Service not available"])) is Err(SmtpError.Refused(code, message));
    expect code == 421;
    expect message == "Service not available";
}

test aRefusedSenderIsNamed {
    mailFrom = go(go(begin(plain(None, None), ["b@y.org"]), 220, ["hi"]), 250, ["Hello"]);
    expect sent(mailFrom) == "MAIL FROM:<a@x.org>\r\n";
    expect conversation.advance(mailFrom, reply(553, ["Sender rejected"])) is Err(SmtpError.Refused(code, message));
    expect code == 553;
    expect message.contains("a@x.org");
}

test aMessageOverTheServersSizeIsRefusedBeforeItIsSent {
    greeted = go(begin(plain(None, None), ["b@y.org"]), 220, ["hi"]);
    expect conversation.advance(greeted, reply(250, ["Hello", "SIZE 10"])) is Err(SmtpError.InvalidMail(reason));
    expect reason.contains("limit");
}

test aServerThatSaysNoToTheBodyRefuses {
    d = go(
        go(
            go(
                go(go(begin(plain(None, None), ["b@y.org"]), 220, ["hi"]), 250, ["Hello"]),
                250,
                ["OK"]
            ),
            250,
            ["OK"]
        ),
        354,
        ["go ahead"]
    );
    expect sent(d) == "the message";
    expect conversation.advance(d, reply(552, ["Message size exceeds limit"])) is Err(SmtpError.Refused(code, message));
    expect code == 552;
}

test aOneLineReply {
    expect conversation.readSmtpReply(wire("220 mail.example ESMTP ready\r\n")) is SmtpReplyRead.Done(reply, rest);
    expect reply == SmtpReply(code: 220, lines: ["mail.example ESMTP ready"]);
    expect rest.length() == 0;
}

test aReplyOfSeveralLines {
    expect conversation.readSmtpReply(wire("250-mail.example Hello\r\n250-STARTTLS\r\n250 SIZE 1000\r\n")) is SmtpReplyRead.Done(reply, rest);
    expect reply == SmtpReply(code: 250, lines: ["mail.example Hello", "STARTTLS", "SIZE 1000"]);
}

test aBareCodeHasNoText {
    expect conversation.readSmtpReply(wire("250\r\n")) is SmtpReplyRead.Done(reply, rest);
    expect reply == SmtpReply(code: 250, lines: [""]);
}

test whatFollowsTheReplyIsLeftAlone {
    expect conversation.readSmtpReply(wire("250 ok\r\n221 bye\r\n")) is SmtpReplyRead.Done(first, rest);
    expect first.code == 250;
    expect conversation.readSmtpReply(rest) is SmtpReplyRead.Done(second, rest2);
    expect second.code == 221;
}

test everyPartialReplyAsksForMore {
    whole = "250-a\r\n250-b\r\n250 c\r\n";
    cut: int = 0;
    while (cut < whole.length()) {
        expect conversation.readSmtpReply(wire(whole.slice(0, cut))) is SmtpReplyRead.NeedMore;
        cut = cut + 1;
    }

    expect conversation.readSmtpReply(wire(whole)) is SmtpReplyRead.Done(reply, rest);
}

test aBareLfDoesNotEndALine {
    expect conversation.readSmtpReply(wire("220 hello\n")) is SmtpReplyRead.NeedMore;
}

test malformedRepliesAreRefused {
    for (bad in ["ABC hello\r\n", "22 short\r\n", "220hello\r\n", "999 out of range\r\n", "100 too low\r\n", "250-a\r\n251 changed\r\n"]) {
        expect conversation.readSmtpReply(wire(bad)) is SmtpReplyRead.Malformed(reason);
    }
}

test aLineThatNeverEndsIsRefused {
    long = "220 ${repeated("x", 5000)}";
    expect conversation.readSmtpReply(wire(long)) is SmtpReplyRead.Malformed(reason);
}

test aReplyThatNeverEndsIsRefused {
    many: string = "";
    n: int = 0;
    while (n < 101) {
        many = "${many}250-line\r\n";
        n = n + 1;
    }

    expect conversation.readSmtpReply(wire(many)) is SmtpReplyRead.Malformed(reason);
}

test noSettingsLeaveTheTargetAsItWas {
    expect conversation.withLogin(target("ann"), None, None) is Ok(t);
    expect t == target("ann");
}

test aTokenIsKeptForXOAuth2 {
    expect conversation.withLogin(target("ann@gmail.com"), None, "ya29.a0Af-_~+/=") is Ok(t);
    expect t.token == "ya29.a0Af-_~+/=";
    expect conversation.withLogin(target("ann@gmail.com"), SmtpAuth.XOAuth2, "tok") is Ok(chosen);
    expect chosen.auth == SmtpAuth.XOAuth2;
}

test xoauth2NeedsAToken {
    expect conversation.withLogin(target("ann"), SmtpAuth.XOAuth2, None) is Err(SmtpError.Protocol(reason));
    expect reason.contains("SMTP_OAUTH_TOKEN");
}

test aTokenCantBreakTheFraming {
    for (bad in ["", "zq9 x", "zq9\tauth=Bearer x", "zq9\r\n", "zqé9"]) {
        expect conversation.withLogin(target("ann"), None, bad) is Err(SmtpError.Protocol(reason));
        expect !reason.contains("zq");
    }
}

test aLoginSettingNeedsAUser {
    noUser = SmtpTarget(
        host: "mail.example",
        port: 587,
        security: SmtpSecurity.StartTls,
        user: None,
        password: None
    );
    expect conversation.withLogin(noUser, None, "tok") is Err(SmtpError.Protocol(reason));
    expect conversation.withLogin(noUser, SmtpAuth.Plain, None) is Err(SmtpError.Protocol(why));
    expect conversation.withLogin(noUser, SmtpAuth.Auto, None) is Ok(_);
}

test smtpStartsPlainAndUpgrades {
    expect conversation.parseSmtpUrl("smtp://mail.example") is Ok(target);
    expect target == SmtpTarget(host: "mail.example", port: 587, security: SmtpSecurity.StartTls, user: None, password: None);
}

test smtpsIsTlsFromTheFirstByte {
    expect conversation.parseSmtpUrl("smtps://mail.example") is Ok(target);
    expect target.security == SmtpSecurity.Implicit;
    expect target.port == 465;
}

test plainIsForALocalServer {
    expect conversation.parseSmtpUrl("smtp+plain://localhost:1025") is Ok(target);
    expect target.security == SmtpSecurity.Plain;
    expect target.port == 1025;
}

test aLoginAndAPort {
    expect conversation.parseSmtpUrl("smtp://apikey:s3cret@smtp.example.com:2525") is Ok(target);
    expect target.host == "smtp.example.com";
    expect target.port == 2525;
    expect orEmpty(target.user) == "apikey";
}

test aLoginIsPercentDecoded {
    // user@example, and a password with an @ and a colon.
    expect conversation.parseSmtpUrl("smtp://user%40example:p%40ss%3Aword@mail.example") is Ok(target);
    expect orEmpty(target.user) == "user@example";
    expect orEmpty(target.password) == "p@ss:word";
}

test anIpv6HostIsInBrackets {
    expect conversation.parseSmtpUrl("smtps://[::1]:465") is Ok(target);
    expect target.host == "::1";
    expect target.port == 465;
}

test aTrailingSlashIsFine {
    expect conversation.parseSmtpUrl("smtp://mail.example/") is Ok(target);
    expect target.host == "mail.example";
}

test whatCantBeReadIsRefused {
    for (bad in ["mail.example", "http://mail.example", "smtp://", "smtp://mail.example:0", "smtp://mail.example:99999", "smtp://mail.example:abc", "smtp://a:b:c:d", "smtp://[::1", "smtp://mail.example/inbox", "smtp://mail.example?x=1", "smtp://:pw@mail.example", "smtp://u%2@mail.example"]) {
        expect conversation.parseSmtpUrl(bad) is Err(SmtpError.InvalidUrl(reason));
    }
}

test aReasonNeverRepeatsThePassword {
    expect conversation.parseSmtpUrl("smtp://user:hunter2@mail.example:abc") is Err(SmtpError.InvalidUrl(reason));
    expect !reason.contains("hunter2");
    expect !reason.contains("user");
}

private {
    mail(to: List<string>) -> Mail {
        return Mail(from: "a@x.org", to: to, subject: "Hello", body: "Hi");
    }

    startTls(user: string, password: string) -> SmtpTarget {
        return SmtpTarget(
            host: "mail.example",
            port: 587,
            security: SmtpSecurity.StartTls,
            user: user,
            password: password
        );
    }

    implicit(user: string, password: string) -> SmtpTarget {
        return SmtpTarget(
            host: "mail.example",
            port: 465,
            security: SmtpSecurity.Implicit,
            user: user,
            password: password
        );
    }

    // smtps:// as ann@gmail.com with the token ya29.tok, and a password
    // too unless it is "".
    oauth(auth: SmtpAuth, password: string) -> SmtpTarget {
        target = SmtpTarget(
            host: "smtp.gmail.com",
            port: 465,
            security: SmtpSecurity.Implicit,
            user: "ann@gmail.com",
            password: None,
            auth: auth,
            token: "ya29.tok"
        );
        if (password == "") {
            return target;
        }

        return copy(target, password: password);
    }

    plain(user: string | None, password: string | None) -> SmtpTarget {
        return SmtpTarget(
            host: "localhost",
            port: 1025,
            security: SmtpSecurity.Plain,
            user: user,
            password: password
        );
    }

    begin(target: SmtpTarget, to: List<string>) -> Dialogue {
        return conversation.startDialogue(target, mail(to), "client.test", "the message".utf8());
    }

    afterGreeting() -> Dialogue {
        return copy(begin(startTls("user", "pass"), ["b@y.org"]), phase: SmtpPhase.Hello);
    }

    reply(code: int, lines: List<string>) -> SmtpReply {
        return SmtpReply(code: code, lines: lines);
    }

    // The dialogue after the server's reply, or the same one when advance
    // refuses it, so a test that expected progress sees none.
    go(d: Dialogue, code: int, lines: List<string>) -> Dialogue {
        return match (conversation.advance(d, reply(code, lines))) {
            Ok(next) -> next,
            Err(_) -> d
        }
    }

    // What the gateway does at this phase, as text.
    sent(d: Dialogue) -> string {
        return match (conversation.nextStep(d)) {
            SmtpStep.Listen -> "listen",
            SmtpStep.Upgrade -> "upgrade",
            SmtpStep.Send(data) -> textOf(data),
            SmtpStep.Finish -> "finish"
        }
    }

    textOf(data: bytes) -> string {
        return match (data.utf8()) {
            None -> "",
            text -> text
        }
    }

    wire(text: string) -> bytes {
        return text.utf8();
    }

    repeated(piece: string, times: int) -> string {
        out: string = "";
        n: int = 0;
        while (n < times) {
            out = "${out}${piece}";
            n = n + 1;
        }

        return out;
    }

    target(user: string) -> SmtpTarget {
        return SmtpTarget(
            host: "mail.example",
            port: 587,
            security: SmtpSecurity.StartTls,
            user: user,
            password: None
        );
    }

    orEmpty(text: string | None) -> string {
        return match (text) {
            None -> "",
            value -> value
        }
    }
}
