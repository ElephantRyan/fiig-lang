// ADR 0110 §3: whether a connection can serve another call after a command
// of this name. These change it for whoever uses it next.
conversion keepsConnection(name: string) -> bool {
    changing = [
        "SUBSCRIBE",
        "PSUBSCRIBE",
        "SSUBSCRIBE",
        "MONITOR",
        "MULTI",
        "WATCH",
        "SELECT",
        "CLIENT",
        "HELLO",
        "AUTH",
        "RESET",
    ]
    return not changing.contains(name.uppercase())
}
