use fiig.http

test a204IsDeleted {
    expect deleteResult(http.Reply(status: 204, headers: [], body: <<>>)) is Ok(_);
}

test a200IsDeletedToo {
    expect deleteResult(http.Reply(status: 200, headers: [], body: <<>>)) is Ok(_);
}

test anythingElseIsAnErrorForADelete {
    expect deleteResult(http.Reply(status: 403, headers: [], body: "<Error><Code>AccessDenied</Code><Message>no</Message></Error>".utf8())) is Err(S3Error.Refused(status, code, message));
    expect code == "AccessDenied";
}
