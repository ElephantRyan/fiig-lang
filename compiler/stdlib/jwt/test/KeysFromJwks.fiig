// ADR 0146 §5: a key set is read strictly, and its keys leniently.
test aKeySetsSigningKeysAreRead {
    expect keysFromJwks(set("{\"kty\": \"RSA\", \"kid\": \"a\", \"alg\": \"RS256\", \"n\": \"zNKpvWEH90P5C1qYY-Q5GvloSLmdudWsm3FPOKr3dNnB0DVAA0lnjxt5dRp3KaWqt5JgloNBD743c-rREHrIhacPUHvtXrQeOUChRqXxpHjiyLRsYjOglxhf8jHM5ziDZkRcWgz3NGzzOL77-q1rbN3EdFbgsOjLtXFkw-KpkuRQxazTIllgiBsOI-s94pV6FzJoHy7kR1VRnb6IyEH8VMw1WmI0e_BuBALmESmdZHmnsXi4Q664UoL2Glwjm1kQCI-5uJI3UNo0RZ5YnrnxgtdZNbF-SKhxcQQMpLGyUONB8KHbvkD_SaGqbluJWJWBwhil7dJ2J0Cd3rVo3EdSOw\", \"e\": \"AQAB\"}, {\"kty\": \"EC\", \"crv\": \"P-256\", \"x\": \"Ocb512iD0Hf-MJFMsfDVVgxtMt6wzjchnsTpht8Awjk\", \"y\": \"EPwkxZK61Ox5egOQAwfoUuL1hTxZ5jKC0tmeep1EDYA\"}")) is Ok(keys);
    expect keys.length() == 2;
    expect keys.first().keyId == "a";
    expect keys.first().algorithm == "RS256";
    expect keys.last().keyId == None;
}

test keysForOtherUsesAreLeftOut {
    expect keysFromJwks(set("{\"kty\": \"RSA\", \"use\": \"enc\", \"n\": \"zNKpvWEH90P5C1qYY-Q5GvloSLmdudWsm3FPOKr3dNnB0DVAA0lnjxt5dRp3KaWqt5JgloNBD743c-rREHrIhacPUHvtXrQeOUChRqXxpHjiyLRsYjOglxhf8jHM5ziDZkRcWgz3NGzzOL77-q1rbN3EdFbgsOjLtXFkw-KpkuRQxazTIllgiBsOI-s94pV6FzJoHy7kR1VRnb6IyEH8VMw1WmI0e_BuBALmESmdZHmnsXi4Q664UoL2Glwjm1kQCI-5uJI3UNo0RZ5YnrnxgtdZNbF-SKhxcQQMpLGyUONB8KHbvkD_SaGqbluJWJWBwhil7dJ2J0Cd3rVo3EdSOw\", \"e\": \"AQAB\"}, {\"kty\": \"oct\", \"k\": \"c2VjcmV0\"}, {\"kty\": \"RSA\", \"n\": \"t-IiQ_cTZ9U83Cdb8no7e6FMJSmPxQz69Xn4JRLAAXRrleUhH9rvO0zmhfS4RmHFLwo_qyJeVKGdcu--2OSI4wscZxmdVA-YgL8tnrAGbTFsfNJHqvIr_YSPY0G_ViIFGQ3WcY9sYK7-FVO0gqP5fU0TSV5irQs9G_DVjKP4QNk\", \"e\": \"AQAB\"}, {\"kty\": \"EC\", \"crv\": \"P-521\", \"x\": \"Ocb512iD0Hf-MJFMsfDVVgxtMt6wzjchnsTpht8Awjk\", \"y\": \"EPwkxZK61Ox5egOQAwfoUuL1hTxZ5jKC0tmeep1EDYA\"}, {\"kty\": \"EC\", \"crv\": \"P-256\", \"x\": \"EPwkxZK61Ox5egOQAwfoUuL1hTxZ5jKC0tmeep1EDYA\", \"y\": \"EPwkxZK61Ox5egOQAwfoUuL1hTxZ5jKC0tmeep1EDYA\"}, {\"kty\": \"OKP\", \"crv\": \"Ed25519\", \"x\": \"wR_GYmAZb60GXIGb9eNTibKmZDGI9PuLynDBxVnrBB0\"}, \"not a key\"")) is Ok(keys);
    expect keys.length() == 1;
    expect keys.first().key == PublicKey.Ed25519(key: "wR_GYmAZb60GXIGb9eNTibKmZDGI9PuLynDBxVnrBB0".fromBase64Url() ?? <<>>);
}

test aDocumentThatIsntAKeySetIsRefused {
    expect keysFromJwks("{}".utf8()) is Err(JwtError.KeysUnavailable("the key set has no keys list"));
    expect keysFromJwks("[]".utf8()) is Err(JwtError.KeysUnavailable("the key set isn't a JSON object"));
    expect keysFromJwks("{".utf8()) is Err(JwtError.KeysUnavailable("the key set isn't JSON"));
}

private {
    set(keys: string) -> bytes {
        return "{\"keys\": [${keys}]}".utf8();
    }
}
