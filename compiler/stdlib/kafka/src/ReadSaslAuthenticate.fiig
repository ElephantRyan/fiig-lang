// A SaslAuthenticate v2 response: response header v1, then the error, its
// message, and the mechanism's next message, COMPACT_BYTES. A refusal is
// its error's name and the broker's message.
conversion readSaslAuthenticate(frame: bytes) -> Result<bytes, string> {
    return match (afterTags(frame, 4)) {
        None -> {
            return Err(short());
        },

        afterHeader -> {
            return match (i16At(frame, afterHeader)) {
                None -> {
                    return Err(short());
                },

                code -> {
                    return match (compactStringAt(frame, afterHeader + 2)) {
                        None -> {
                            return Err(short());
                        },

                        message -> {
                            if (code != 0) {
                                if (message.text == "") {
                                    return Err(errorName(code));
                                }

                                return Err("${errorName(code)}: ${message.text}");
                            }

                            return match (uvarintAt(frame, message.next)) {
                                None -> {
                                    return Err(short());
                                },

                                size -> {
                                    if (size.value == 0) {
                                        return Ok(<<>>);
                                    }

                                    end = size.next + size.value - 1;
                                    if (end > frame.length()) {
                                        return Err(short());
                                    }

                                    return Ok(frame.slice(size.next, end));
                                },
                            }
                        },
                    }
                },
            }
        },
    }
}

private {
    short() -> string {
        return "a SaslAuthenticate response ends early";
    }
}
