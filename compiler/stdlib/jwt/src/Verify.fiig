// ADR 0146 §4: a token signed with a public key, checked against keys
// (a JWKS's, from JwtKeys or configured) and what this program accepts.
// The checks run in order and each failure is its own JwtError: size and
// shape, the algorithm, the header, the key, the signature, the claims. An
// HMAC alg is refused here, so a public key is never used as an HMAC
// secret (CVE-2015-9235).
conversion verify(token: string, keys: List<Jwk>, expect: Expect, now: int)
        -> Result<Verified, JwtError> {
    parts = tokenOf(token)?;
    headerChecked(parts, expect)?;
    algorithm = match (signatureAlgorithmOf(parts.algorithm)) {
        None -> {
            return Err(JwtError.AlgorithmRefused(algorithm: algorithmName(parts.algorithm)));
        },

        given -> given
    }

    key = keyFor(parts, keys)?;
    if (!crypto.verify(key, algorithm, parts.signingInput, parts.signature)) {
        return Err(JwtError.BadSignature);
    }

    return claimsChecked(parts, expect, now);
}

private {
    // By kid, the key with it that fits the algorithm, and whose own alg,
    // if it states one, is the same. With no kid, the one key that fits:
    // more than one is NoKey, since trying each hides which key the issuer
    // meant.
    keyFor(parts: TokenParts, keys: List<Jwk>) -> Result<PublicKey, JwtError> {
        name = algorithmName(parts.algorithm);
        fitting: List<Jwk> = [];
        for (jwk in keys) {
            if (keyFits(jwk.key, parts.algorithm) && (jwk.algorithm ?? name) == name) {
                match (parts.keyId) {
                    None -> {
                        fitting = append(fitting, jwk);
                    },

                    wanted -> {
                        if (jwk.keyId == wanted) {
                            fitting = append(fitting, jwk);
                        }
                    }
                }
            }
        }

        if (fitting.length() == 0 || (parts.keyId == None && fitting.length() > 1)) {
            return Err(JwtError.NoKey(keyId: parts.keyId));
        }

        return Ok(fitting.first().key);
    }

    rsaAlgorithms() -> List<Algorithm> {
        return [
            Algorithm.RS256,
            Algorithm.RS384,
            Algorithm.RS512,
            Algorithm.PS256,
            Algorithm.PS384,
            Algorithm.PS512
        ];
    }

    keyFits(key: PublicKey, algorithm: Algorithm) -> bool {
        return match (key) {
            PublicKey.Rsa(_, _) -> rsaAlgorithms().contains(algorithm),
            PublicKey.EcP256(_, _) -> algorithm == Algorithm.ES256,
            PublicKey.EcP384(_, _) -> algorithm == Algorithm.ES384,
            PublicKey.Ed25519(_) -> algorithm == Algorithm.EdDSA
        }
    }
}
