// The bytes after DATA (RFC 5321 §4.5.2): the headers, a blank line, the
// body, and a line holding only a dot. Lines end in CRLF and a body line that
// starts with a dot gets another (so the end marker is unmistakable). A body
// of plain ASCII goes as it is (7bit); anything else, and any line over the
// 998 bytes SMTP allows, goes as base64 (ADR 0120 §2). A subject that isn't
// plain ASCII is written as RFC 2047 encoded words, and so is a display name;
// Bcc is never written (§2a).
conversion mailData(mail: Mail, date: string, messageId: string) -> bytes {
    plain = mail.body.replaceAll("\r\n", "\n").replaceAll("\r", "\n")
    rows: List<string> = plain.split("\n")
    if rows.length() > 1 and rows.last() == "" {
        rows = rows.slice(0, rows.length() - 1)
    }
    encoded = needsBase64(plain, rows)
    encoding: string = "7bit"
    body: string = plainLines(rows)
    if encoded {
        encoding = "base64"
        body = base64Lines(rows)
    }
    names: Map<string, string> = [:]
    match mail.names {
        None -> None
        given -> {
            names = given
        }
    }
    headers: List<string> = [addressHeader("From", [mail.from], names)]
    if mail.to.length() > 0 {
        headers = append(headers, addressHeader("To", mail.to, names))
    }
    match mail.cc {
        None -> None
        cc -> {
            if cc.length() > 0 {
                headers = append(headers, addressHeader("Cc", cc, names))
            }
        }
    }
    match mail.replyTo {
        None -> None
        address -> {
            headers = append(headers, addressHeader("Reply-To", [address], names))
        }
    }
    headers = append(headers, "Subject: ${subjectHeader(mail.subject)}")
    headers = append(headers, "Date: ${date}")
    headers = append(headers, "Message-ID: <${messageId}>")
    headers = append(headers, "MIME-Version: 1.0")
    headers = append(headers, "Content-Type: text/plain; charset=utf-8")
    headers = append(headers, "Content-Transfer-Encoding: ${encoding}")
    head = headers.join("\r\n")
    text = "${head}\r\n\r\n${body}.\r\n"
    return text.utf8()
}

private {
    // Whether the body can't go as 7bit text: a byte outside printable ASCII
    // and the usual controls, or a line SMTP won't carry.
    needsBase64(plain: string, rows: List<string>) -> bool {
        for b in plain.utf8() {
            if b >= 128 or b == 0 {
                return true
            }
        }
        for row in rows {
            if row.utf8().length() > 998 {
                return true
            }
        }
        return false
    }

    plainLines(rows: List<string>) -> string {
        stuffed: List<string> = []
        for row in rows {
            if row.startsWith(".") {
                stuffed = append(stuffed, ".${row}")
            } else {
                stuffed = append(stuffed, row)
            }
        }
        joined = stuffed.join("\r\n")
        return "${joined}\r\n"
    }

    // The body as CRLF text in base64, wrapped at 76 characters.
    base64Lines(rows: List<string>) -> string {
        joined = rows.join("\r\n")
        text = "${joined}\r\n"
        encoded = text.utf8().toBase64()
        lines: List<string> = []
        start: int = 0
        while start < encoded.length() {
            stop: int = start + 76
            if stop > encoded.length() {
                stop = encoded.length()
            }
            lines = append(lines, encoded.slice(start, stop))
            start = stop
        }
        wrapped = lines.join("\r\n")
        return "${wrapped}\r\n"
    }

    // The subject as it goes in the header: itself when it is printable
    // ASCII, else encoded words.
    subjectHeader(subject: string) -> string {
        for b in subject.utf8() {
            if b < 32 or b > 126 {
                return encodedWords(subject)
            }
        }
        return subject
    }

    // =?UTF-8?B?...?= words of at most 42 bytes each, cut only between
    // characters (a continuation byte never starts a word), folded with CRLF
    // and a space (RFC 2047 §2, RFC 5322 §2.2.3).
    encodedWords(text: string) -> string {
        raw = text.utf8()
        words: List<string> = []
        start: int = 0
        i: int = 0
        while i < raw.length() {
            i = i + 1
            if i - start >= 42 and (i == raw.length() or not continuation(raw.at(i))) {
                words = append(words, word(raw.slice(start, i)))
                start = i
            }
        }
        if start < raw.length() {
            words = append(words, word(raw.slice(start, raw.length())))
        }
        return words.join("\r\n ")
    }

    // A header of addresses, each with its display name when names has one,
    // separated by commas and folded before an address that would take the
    // line past 78 characters (RFC 5322 §2.1.1, §3.4).
    addressHeader(field: string, addresses: List<string>, names: Map<string, string>) -> string {
        text: string = "${field}:"
        first: bool = true
        for address in addresses {
            entry = mailbox(address, names.atOr(address, ""))
            if not first {
                text = "${text},"
            }
            width = entry.split("\r\n").first().utf8().length()
            if not first and text.split("\r\n").last().utf8().length() + 1 + width > 78 {
                text = "${text}\r\n ${entry}"
            } else {
                text = "${text} ${entry}"
            }
            first = false
        }
        return text
    }

    // An address as a header writes it: bare, or after its display name in
    // angle brackets. A name of plain words goes as it is; one with a
    // character that means something in a header (or =?, which a reader
    // would decode) is quoted; one that isn't printable ASCII is encoded
    // words (RFC 5322 §3.4, RFC 2047 §5).
    mailbox(address: string, name: string) -> string {
        if name == "" {
            return address
        }
        for b in name.utf8() {
            if b < 32 or b > 126 {
                return "${encodedWords(name)} <${address}>"
            }
        }
        if plainPhrase(name) {
            return "${name} <${address}>"
        }
        quoted = name.replaceAll("\\", "\\\\").replaceAll("\"", "\\\"")
        return "\"${quoted}\" <${address}>"
    }

    // Letters, digits, spaces, and the symbols RFC 5322's atoms allow.
    plainPhrase(name: string) -> bool {
        if name.contains("=?") {
            return false
        }
        for b in name.utf8() {
            if b == 34 or b == 40 or b == 41 or b == 44 or b == 46 or b == 58 or b == 59 or b == 60 or b == 62 or b == 64 or b == 91 or b == 92 or b == 93 {
                return false
            }
        }
        return true
    }

    word(part: bytes) -> string {
        return "=?UTF-8?B?${part.toBase64()}?="
    }

    // The second to fourth byte of a UTF-8 character.
    continuation(b: int) -> bool {
        return b >= 128 and b < 192
    }
}
