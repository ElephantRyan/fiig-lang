// Whether a send that failed on a kept connection goes again, once, on a new
// one (ADR 0120 §3a): when the connection turned out dead (a socket failure,
// or 421, the server closing it) before any of the message was written. Once
// the body has gone the server may have accepted it, whatever came back, and
// sending it again could deliver it twice.
conversion resendOnNewConnection(d: Dialogue, failure: SmtpError) -> bool {
    return match (d.phase) {
        SmtpPhase.Reset -> deadConnection(failure),
        SmtpPhase.MailFrom -> deadConnection(failure),
        SmtpPhase.Rcpt -> deadConnection(failure),
        SmtpPhase.Data -> deadConnection(failure),
        _ -> false,
    }
}

private {
    deadConnection(failure: SmtpError) -> bool {
        return match (failure) {
            SmtpError.Socket(_) -> true,
            SmtpError.Refused(code, _) -> code == 421,
            _ -> false,
        }
    }
}
