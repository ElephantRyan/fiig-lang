test formatHttpat1970_1_1_0_0_0 {
    expect formatHttp(0) is Ok(text);
    expect text == "Thu, 01 Jan 1970 00:00:00 GMT";
}

test formatHttpat1969_12_31_23_59_59_999 {
    expect formatHttp(-1) is Ok(text);
    expect text == "Wed, 31 Dec 1969 23:59:59 GMT";
}

test formatHttpat1969_12_31_0_0_0 {
    expect formatHttp(-86400000) is Ok(text);
    expect text == "Wed, 31 Dec 1969 00:00:00 GMT";
}

test formatHttpat1900_1_1_0_0_0 {
    expect formatHttp(-2208988800000) is Ok(text);
    expect text == "Mon, 01 Jan 1900 00:00:00 GMT";
}

